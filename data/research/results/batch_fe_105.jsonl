{"person_id": "mackenzie-scott", "name": "MacKenzie Scott", "category": "E-commerce founder-operator / philanthropist (Amazon early founding contributor)", "birth_year": 1970, "age_at_milestone": 24, "milestone_by_age_26": "In 1994 at age 24, helped found Amazon with then-husband Jeff Bezos—working on name/business plan, bookkeeping, shipping, and the company's first freight contract as an early key contributor from the garage startup phase.", "early_history_summary": "Born MacKenzie Scott Tuttle April 7, 1970 in San Francisco; studied English at Princeton under Toni Morrison. Worked at D.E. Shaw where she met Bezos; in 1994 they moved to Seattle and launched the online bookstore that became Amazon, with Scott deeply involved in early operations.", "primary_leverage_engine": "Execution / operations", "normalized_primary_engine": "Execution / operations", "secondary_engine": "Network / capital", "started_serious_reps_before_20_score": 0, "prior_reps_score": 1, "scarce_skill_depth_score": 1, "native_distribution_score": 0, "elite_ecosystem_network_score": 2, "complementary_team_score": 2, "structural_wave_score": 3, "concentration_intensity_score": 2, "capital_safety_score": 1, "domain_proximity_score": 1, "success_tier": 1, "leverage_evidence_confidence": "High", "family_context_summary": "Born San Francisco; father Jason Baker Tuttle was a financial adviser; family later faced financial/legal stress per secondary profiles.", "parent_family_domain_summary": "Father in finance; mother Holiday described as stay-at-home parent—no e-commerce dynasty.", "early_family_financial_platform_support_score": 1, "parent_family_domain_advantage_score": 0, "inherited_audience_business_network_score": 0, "elite_institution_performance_pipeline_score": 2, "frontier_geography_ecosystem_score": 1, "rare_early_tools_facilities_score": 0, "dedicated_mentor_coach_tutor_score": 1, "exceptional_peer_cofounder_sibling_score": 2, "early_online_platform_community_score": 0, "direct_customer_do