{"person_id":"candidate-2488-bernardo-rezende","name":"Bernardo Rezende","cohort_group":"Athletes","category":"Volleyball player and coach","birth_year":1959,"age_at_milestone":24,"milestone_by_age_26":"Won a silver medal at the 1984 Los Angeles Olympics as a member of the Brazilian national volleyball team, also having won gold at the 1983 Pan American Games.","early_history_summary":"Rezende grew up in Rio de Janeiro and began playing volleyball at professional clubs from a young age, including Fluminense and Atlântica Boavista. He represented Brazil at the 1980 Moscow Olympics (finishing fifth), won gold at the 1983 Pan American Games, and won the Brazil Super League with Atlântica Boavista in 1981 before claiming Olympic silver in 1984.","primary_leverage_engine":"Early specialization","normalized_primary_engine":"Early specialization / prior reps","secondary_engine":"Elite performance pipeline","started_serious_reps_before_20_score":1,"prior_reps_score":2,"scarce_skill_depth_score":2,"native_distribution_score":0,"elite_ecosystem_network_score":1,"complementary_team_score":1,"structural_wave_score":1,"concentration_intensity_score":2,"capital_safety_score":0,"domain_proximity_score":2,"total_leverage_score":12,"success_tier":2,"leverage_evidence_confidence":"Medium","family_context_summary":"Born in Rio de Janeiro, Brazil; family background not well documented in reviewed sources.","parent_family_domain_summary":"Not documented in reviewed sources.","early_family_financial_platform_support_score":0,"parent_family_domain_advantage_score":0,"inherited_audience_business_network_score":0,"elite_institution_performance_pipeline_score":1,"frontier_geography_ecosystem_score":1,"rare_early_tools_facilities_score":0,"dedicated_mentor_coach_tutor_score":0,"exceptional_peer_cofounder_sibling_score":1,"early_online_platform_community_score":0,"direct_customer_domain_exposure_score":1,"prodigy_physical_edge_score":0,"adversity_constraint_catalyst_score":0,"inherited_access_