 worth ~$450 million; resides in Los Angeles.","current_position_year":2025,"is_living":true,"trajectory":[{"year":1969,"age":19,"event":"Made professional comedy debut at the Nameless Coffeehouse in Harvard Square, Boston, performing with roommate Gene Braunstein"},{"year":1973,"age":23,"event":"Started a comedy club at Emerson College in Boston while completing his degree"},{"year":1977,"age":26,"event":"Made first appearance on The Tonight Show with Johnny Carson, performing a stand-up comedy routine on national television"},{"year":1986,"age":36,"event":"Became regular substitute host for Johnny Carson on The Tonight Show"},{"year":1992,"age":42,"event":"Succeeded Johnny Carson as host of The Tonight Show amid controversy with David Letterman"},{"year":2014,"age":64,"event":"Retired from The Tonight Show for the second time, ending a 22-year hosting tenure"}]}
