 {"year": 2009, "age": 32, "event": "Began Redis to scale LLOOGG; open-sourced the in-memory data structure server."}, {"year": 2010, "age": 33, "event": "Redis sponsorship/employment path began (VMware era), accelerating global adoption."}, {"year": 2020, "age": 43, "event": "Stepped down as Redis BDFL/maintainer after 11+ years leading the project."}, {"year": 2022, "age": 45, "event": "Published science-fiction novel Wohpe in Italy."}, {"year": 2024, "age": 47, "event": "Returned to Redis as evangelist and later shipped new work including vector sets."}]}
