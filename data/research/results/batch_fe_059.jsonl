{"person_id": "michael-pryor", "name": "Michael Pryor", "cohort_group": "Founders / operators", "category": "Software entrepreneur / Trello and Fog Creek co-founder", "birth_year": 1975, "age_at_milestone": 25, "milestone_by_age_26": "Co-founded Fog Creek Software with Joel Spolsky in September 2000 in New York City at about age 25, building a developer-centric product company (FogBugz and later Trello lineage) after working as a programmer at Juno.", "early_history_summary": "Grew up in Lancaster, Pennsylvania; learned programming from magazine type-in BASIC programs on a TI-99. Graduated Dartmouth in 1998, moved to NYC, and worked as a Windows client programmer at free-email startup Juno (a D.E. Shaw spinout). After Juno’s disappointing IPO and the 2000 market turn, he and colleague Joel Spolsky quit to start Fog Creek as a bootstrapped software company.", "primary_leverage_engine": "Execution / operations", "normalized_primary_engine": "Execution / operations", "secondary_engine": "Complementary cofounder", "started_serious_reps_before_20_score": 1, "prior_reps_score": 2, "scarce_skill_depth_score": 2, "native_distribution_score": 0, "elite_ecosystem_network_score": 1, "complementary_team_score": 2, "structural_wave_score": 1, "concentration_intensity_score": 2, "capital_safety_score": 0, "domain_proximity_score": 2, "total_leverage_score": 13, "success_tier": 3, "leverage_evidence_confidence": "Medium", "family_context_summary": "Grew up in Lancaster, Pennsylvania; worked high-school jobs including busboy and grocery-warehouse freezer work that pushed him toward college and white-collar tech work.", "parent_family_domain_summary": "Not documented in reviewed sources.", "early_family_financial_platform_support_score": 0, "parent_family_domain_advantage_score": 0, "inherited_audience_business_network_score": 0, "elite_institution_performance_pipeline_score": 1, "frontier_geography_ecosystem_score": 1, "rare_early_tools_facilities_score": 0, "dedicated_mentor_coach_tutor_score": 0, "exceptional_peer_cofounder_sibling_score": 2, "early_online_platform_community_score": 0, "direct_customer_domain_exposure_score": 1, "prodigy_physical_edge_score": 0, "adversity_constraint_catalyst_score": 1, "inherited_access_stack_count": 5, "exceptional_inherited_access_count": 1, "all_documented_early_condition_count": 5, "primary_early_advantage_archetype": "High-trust peer team", "primary_early_advantage_tags": "Dartmouth, Joel Spolsky cofounder, Juno, NYC bootstrapping, developer tools", "evidence_summary": "Michael Pryor (born ~1975 per curated record; Dartmouth class of 1998) learned to code from magazine listings, worked manual labor jobs, then programmed at Juno in NYC. In September 2000, at about age 25, he co-founded Fog Creek Software with Joel Spolsky to build a developer-first product company, later spinning out Stack Overflow-related efforts and Trello (sold to Atlassian for ~$425M). Early advantages centered on a high-trust complementary cofounder, Dartmouth CS path, and direct exposure to software product work rather than family capital or inherited audience.", "early_advantage_evidence_confidence": "Medium", "source_count": 4, "primary_source_url": "https://baremetrics.com/founder-chats/michael-pryor", "source_urls": ["https://baremetrics.com/founder-chats/michael-pryor", "https://web.stanford.edu/class/ee204/Publications/Finding%20a%20Growth%20Business%20Model%20at%20Stack%20Overflow.pdf", "https://watsi.org/blog/meet-michael-pryor/", "https://medium.com/authority-magazine/trello-co-founder-michael-pryor-five-things-you-need-to-know-to-create-a-successful-app-or-saas-b53535495eae"], "annotation_status": "subagent_researched_beta", "source_audit_status": "not_independently_audited", "data_version": "0.3.0-trajectory-beta", "eligibility_status": "age_26_eligible", "starting_point": "Grew up in Lancaster, Pennsylvania; learned coding from computer magazines; worked busboy and freezer-warehouse jobs before Dartmouth.", "current_position": "Retired (2022) software entrepreneur; co-founder of Fog Creek Software and Trello (acquired by Atlassian); former Head of Trello at Atlassian.", "current_position_year": 2025, "is_living": true, "trajectory": [{"year": 1998, "age": 23, "event": "Graduated Dartmouth and moved to New York to program at free-email startup Juno."}, {"year": 2000, "age": 25, "event": "Co-founded Fog Creek Software with Joel Spolsky in NYC to build developer tools, bootstrapping via consulting then products."}, {"year": 2008, "age": 33, "event": "Fog Creek backed creation of Stack Overflow with Jeff Atwood; Pryor later handled operational/CFO-style roles as it spun out."}, {"year": 2011, "age": 36, "event": "Fog Creek launched Trello, the kanban-style collaboration product that would become the company’s breakout consumer SaaS hit."}, {"year": 2014, "age": 39, "event": "Trello spun out as its own company with Pryor as CEO after VC funding."}, {"year": 2017, "age": 42, "event": "Atlassian acquired Trello for about $425 million; Pryor joined Atlassian leading Trello."}, {"year": 2022, "age": 47, "event": "Retired from operating roles after a long run as Fog Creek and Trello co-founder/executive."}]}
