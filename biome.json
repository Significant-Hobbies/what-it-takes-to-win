{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["ultracite/biome/astro", "ultracite/biome/core"],
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false,
    "actions": {
      "source": {
        "useSortedPackageJson": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "enabled": false
    }
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  },
  "css": {
    "formatter": {
      "enabled": false
    }
  },
  "html": {
    "formatter": {
      "enabled": false
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.astro",
      "!!**/dist",
      "!!**/public",
      "!!**/artifacts",
      "!!**/coverage",
      "!!quality/source-audit",
      "!!**/pnpm-lock.yaml",
      "!!**/data/people.json",
      "!!**/data/people.csv"
    ]
  },
  "linter": {
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useAriaPropsSupportedByRole": "off",
        "useButtonType": "off",
        "useHeadingContent": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noForEach": "off",
        "noUselessCatchBinding": "off",
        "useArrowFunction": "off",
        "useSimplifiedLogicExpression": "off"
      },
      "correctness": {
        "noUnusedVariables": "off",
        "useParseIntRadix": "off"
      },
      "nursery": {
        "useSortedClasses": "off"
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noDelete": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noIncrementDecrement": "off",
        "noNegationElse": "off",
        "noNestedTernary": "off",
        "noNonNullAssertion": "off",
        "noUnusedTemplateLiteral": "off",
        "useAtIndex": "off",
        "useBlockStatements": "off",
        "useCollapsedElseIf": "off",
        "useConsistentObjectDefinitions": "off",
        "useConsistentTypeDefinitions": "off",
        "useDestructuring": "off",
        "useFilenamingConvention": "off",
        "useNumberNamespace": "off",
        "useNumericSeparators": "off",
        "useSelfClosingElements": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noBiomeFirstException": "off",
        "noBitwiseOperators": "off",
        "noEqualsToNull": "off",
        "noEvolvingTypes": "off",
        "noExplicitAny": "off",
        "noGlobalIsNan": "off",
        "noReturnAssign": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off",
        "useArraySortCompare": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  }
}
