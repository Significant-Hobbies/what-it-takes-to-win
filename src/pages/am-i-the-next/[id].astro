---
import Base from "../../layouts/Base.astro";
import peopleData from "../../data/people.json";
import {
  CONDITION_FACTOR_MAX,
  CONDITION_FACTOR_MIN,
  CONDITION_FACTOR_STEPS,
  getConditionFactors,
  isComparisonPageIndexable,
  type OutcomePerson,
} from "../../lib/outcome-model";
import {
  getLuckEvidence,
  getPerseveranceEvidence,
  getReachBand,
} from "../../lib/journey-model";

export function getStaticPaths() {
  return peopleData.map((person) => ({ params: { id: person.person_id } }));
}

const people = peopleData as OutcomePerson[];
const person = people.find((candidate) => candidate.person_id === Astro.params.id)!;
const factors = getConditionFactors(person);
const reachBand = getReachBand(person);
const perseverance = getPerseveranceEvidence(person);
const luck = getLuckEvidence(person);
const firstTrajectorySteps = Array.isArray(person.trajectory) ? person.trajectory.slice(0, 4) : [];
const isIndexable = isComparisonPageIndexable(person);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `Why you are not the next ${person.name}`,
  description: `A documented path exercise showing why visible resemblance to ${person.name} cannot become a forecast.`,
  mainEntity: {
    "@type": "Person",
    name: person.name,
    description: person.milestone_by_age_26,
    sameAs: person.source_urls,
  },
};
---

<Base
  title={`Why You Are Not the Next ${person.name} — Look Sideways`}
  description={`Inspect what ${person.name} brought, was handed, and encountered—then see why no visible resemblance can reproduce the same outcome.`}
  robots={isIndexable ? "index,follow" : "noindex,follow"}
  canonicalPath={`/am-i-the-next/${person.person_id}/`}
  structuredData={structuredData}
>
  <section class="hero next-person-hero">
    <p class="eyebrow">Break a comparison</p>
    <h1>You are not the next {person.name}.</h1>
    <p class="lede">
      That is not pessimism. It is precision. You can study this path, but you cannot
      inherit its conditions, replay its sequence, or schedule its luck.
    </p>
    <div class="next-person-meta">
      <span>Milestone at <strong>{person.age_at_milestone}</strong></span>
      <span>Outcome reach <strong>{reachBand.label}</strong></span>
      <span>Sources <strong>{person.source_urls.length}</strong></span>
    </div>
  </section>

  <div class="insight-callout" data-clarity-contract="comparison-redundancy">
    <strong>Keep the mechanisms. Drop the identity.</strong>
    {" "}{person.early_history_summary || person.evidence_summary}
  </div>

  <section class="condition-factors" data-clarity-contract="condition-factors" aria-labelledby="comparison-factors-heading">
    <div class="section-heading">
      <p class="eyebrow">The same three questions everywhere</p>
      <h2 id="comparison-factors-heading">Where did this path's conditions come from?</h2>
      <p>The layers are read side by side and never added into a person score.</p>
    </div>
    <div class="condition-factor-grid">
      {factors.map((factor) => (
        <article class={`condition-factor condition-factor-${factor.band ?? "unassessed"}`}>
          <p class="condition-factor-gloss">{factor.gloss}</p>
          <h3>{factor.label}</h3>
          <p class="condition-factor-score">
            <b>{factor.assessed ? (factor.score! > 0 ? `+${factor.score}` : String(factor.score)) : "—"}</b>
            <span>{factor.bandLabel}</span>
          </p>
          <div
            class="condition-factor-axis"
            role="img"
            aria-label={factor.assessed
              ? `${factor.score} on a scale from ${CONDITION_FACTOR_MIN} to ${CONDITION_FACTOR_MAX}`
              : "Not assessed"}
          >
            {CONDITION_FACTOR_STEPS.map((step) => (
              <i class={`${step < 0 ? "negative" : ""} ${factor.score === step ? "current" : ""}`.trim() || undefined}>
                <span>{step > 0 ? `+${step}` : String(step)}</span>
              </i>
            ))}
          </div>
          <p class="condition-factor-summary">{factor.summary || "Not documented in the reviewed sources."}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="path-forces" aria-labelledby="comparison-forces-heading">
    <div class="section-heading">
      <p class="eyebrow">Two forces, no new scores</p>
      <h2 id="comparison-forces-heading">Perseverance and luck both matter.</h2>
    </div>
    <div class="path-force-grid">
      <article>
        <span>{perseverance.label}</span>
        <strong>{perseverance.summary}</strong>
        <p>{perseverance.boundary}</p>
      </article>
      <article>
        <span>{luck.label}</span>
        <strong>{luck.summary}</strong>
        <p>{luck.boundary}</p>
      </article>
    </div>
  </section>

  {firstTrajectorySteps.length > 0 && (
    <section aria-labelledby="trajectory-snapshot-heading">
      <div class="section-heading">
        <p class="eyebrow">Sequence matters</p>
        <h2 id="trajectory-snapshot-heading">These conditions arrived in this order.</h2>
        <p>A different order is a different path—even when some ingredients look familiar.</p>
      </div>
      <ol class="next-trajectory">
        {firstTrajectorySteps.map((step) => (
          <li>
            <span>{step.year} · age {step.age}</span>
            <strong>{step.title || "Documented transition"}</strong>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="grid grid-2 interpretation-grid" aria-label="Where this comparison breaks">
    <article class="card">
      <h3>What transfers</h3>
      <ul class="clean-list">
        <li>Mechanisms worth understanding.</li>
        <li>Examples of repeated work.</li>
        <li>Questions to ask about your own conditions.</li>
      </ul>
    </article>
    <article class="card">
      <h3>What cannot transfer</h3>
      <ul class="clean-list">
        <li>An identity, timeline, or outcome.</li>
        <li>Unchosen encounters and structural timing.</li>
        <li>A probability of becoming {person.name}.</li>
      </ul>
    </article>
  </section>

  <section class="closing-cta">
    <p class="eyebrow">The useful conclusion</p>
    <h2>Return to your own unfinished path.</h2>
    <p>Use this record for information, never for a verdict about your pace or worth.</p>
    <div class="hero-actions" style="justify-content:center;">
      <a class="btn-link btn-link-primary" href={`/person/${person.person_id}/`}>Inspect the full evidence</a>
      <a class="btn-link" href="/compare/">Break another comparison</a>
    </div>
  </section>
</Base>
