---
import Base from "../layouts/Base.astro";
import peopleData from "../data/people.json";

const peopleCount = peopleData.length.toLocaleString();
---

<Base
  title="Page not found — Look Sideways"
  description="That path does not exist. Explore documented early breakthrough paths instead."
  robots="noindex,follow"
  canonicalPath="/404/"
>
  <section class="hero" style="min-height:55vh;display:grid;align-content:center;">
    <p class="eyebrow">404 · Path not found</p>
    <h1>That path does not exist.</h1>
    <p class="lede">
      The dataset still has {peopleCount} documented paths to inspect—and none of them is a formula.
    </p>
    <div class="hero-actions">
      <a class="btn-link btn-link-primary" href="/">Return to the overview</a>
      <a class="hero-secondary-link" href="/explore/">Explore every person →</a>
    </div>
  </section>
</Base>
