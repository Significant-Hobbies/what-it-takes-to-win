---
import Base from "../layouts/Base.astro";
import peopleData from "../data/people.json";
import {
  LEVERAGE_ORIGINS,
  SCORE_FAMILIES,
  getAdvantageTotal,
  type OutcomePerson,
} from "../lib/outcome-model";
import "../styles/story.css";

const people = peopleData as OutcomePerson[];
const total = people.length;
const averageAdvantage = (
  people.reduce((sum, person) => sum + getAdvantageTotal(person), 0) / total
).toFixed(1);
const averageLeverage = (
  people.reduce((sum, person) => sum + person.total_leverage_score, 0) / total
).toFixed(1);
const averageMilestoneAge = (
  people.reduce((sum, person) => sum + person.age_at_milestone, 0) / total
).toFixed(1);
const highConfidence = people.filter(
  (person) => String(person.leverage_evidence_confidence).toLowerCase() === "high",
).length;
const cohortCount = new Set(people.map((person) => person.cohort_group)).size;

const chapters = [
  { id: "the-survivor", label: "The survivor", short: "Survivor" },
  { id: "the-start", label: "The starting field", short: "Start" },
  { id: "the-levers", label: "What multiplies", short: "Leverage" },
  { id: "the-sequence", label: "What compounds", short: "Sequence" },
  { id: "the-boundary", label: "What stays unknowable", short: "Boundary" },
];

const wordSpans = (text: string) => text.split(" ");

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://paths.significanthobbies.com/#website",
      name: "Look Sideways",
      url: "https://paths.significanthobbies.com/",
      description:
        "An evidence-bounded research exhibit about starting advantage, leverage, trajectory, observed standing, and luck.",
    },
    {
      "@type": "Dataset",
      "@id": "https://paths.significanthobbies.com/#dataset",
      name: "Look Sideways documented paths",
      description: `${total.toLocaleString()} documented early-breakthrough paths with explicit evidence and interpretation boundaries.`,
      url: "https://paths.significanthobbies.com/explore/",
      creator: { "@id": "https://paths.significanthobbies.com/#website" },
    },
    {
      "@type": "Article",
      headline: "The path you remember is one of many",
      description:
        "A five-chapter guide to starting advantage, built leverage, compounding trajectory, observed standing, and luck.",
      url: "https://paths.significanthobbies.com/",
      isPartOf: { "@id": "https://paths.significanthobbies.com/#website" },
      about: { "@id": "https://paths.significanthobbies.com/#dataset" },
    },
  ],
};
---

<Base
  title="Look Sideways — The Path You Remember Is One of Many"
  description={`Walk through ${total.toLocaleString()} documented early-breakthrough paths in five chapters: survivor selection, starting position, leverage, trajectory, and luck.`}
  canonicalPath="/"
  structuredData={structuredData}
  mainClass="story-main"
>
  <!--
    THESIS: A famous outcome is the last visible frame of a branching path, not a reproducible recipe.
    OWN-WORLD: The Impossible Observatory—daylit limestone, brass instruments, transparent trajectories, and cobalt evidence light.
    STORY: Move from the selected survivor through starting position and leverage to sequence, uncertainty, and grounded agency.
    FIRST VIEWPORT: One decisive sentence occupies the left while 64 glass trajectories converge through a monumental orrery on the right.
    FORM: The canonical landing journey in Persuade mode, staged as one continuous observatory rather than a stack of cards.
  -->
  <div class="story-shell" data-story data-active-chapter="0">
    <div class="story-atmosphere" aria-hidden="true">
      <canvas class="story-webgl" data-story-webgl></canvas>
      <div class="story-plates">
        <figure class="story-plate" data-story-plate="0">
          <img
            src="/assets/story/observatory-survivor.webp"
            alt=""
            width="1672"
            height="941"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
        <figure class="story-plate" data-story-plate="1">
          <img
            data-story-src="/assets/story/observatory-terraces.webp"
            alt=""
            width="1672"
            height="941"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="story-plate" data-story-plate="2">
          <img
            data-story-src="/assets/story/observatory-leverage.webp"
            alt=""
            width="1672"
            height="941"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="story-plate" data-story-plate="3">
          <img
            data-story-src="/assets/story/observatory-sequence.webp"
            alt=""
            width="1672"
            height="941"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="story-plate" data-story-plate="4">
          <img
            data-story-src="/assets/story/observatory-boundary.webp"
            alt=""
            width="1672"
            height="941"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
      <div class="story-wash"></div>
      <div class="story-depth story-depth-far"></div>
      <div class="story-depth story-depth-near"></div>
      <div class="story-stage">
        <div class="stage-coordinate stage-coordinate-x"></div>
        <div class="stage-coordinate stage-coordinate-y"></div>

        <div class="stage-scene stage-scene-survivor" data-scene="0">
          <div class="branch-origin-grid">
            {Array.from({ length: 64 }).map((_, index) => (
              <i class={index === 45 ? "is-selected" : undefined}></i>
            ))}
          </div>
          <svg class="branch-lines" viewBox="0 0 560 420" preserveAspectRatio="none">
            <path d="M54 48 C180 48 172 210 282 210 S390 210 506 210" />
            <path d="M54 104 C170 104 180 210 282 210" />
            <path d="M54 160 C168 160 178 210 282 210" />
            <path d="M54 216 C160 216 186 210 282 210" />
            <path d="M54 272 C168 272 178 210 282 210" />
            <path d="M54 328 C170 328 180 210 282 210" />
            <path d="M54 384 C180 384 172 210 282 210" />
          </svg>
          <div class="stage-outcome"><span>01</span><small>visible outcome</small></div>
          <p class="stage-method-note">Illustration · six hypothetical 50/50 gates</p>
        </div>

        <div class="stage-scene stage-scene-start" data-scene="1">
          <div class="start-axis">
            <span>less documented access</span>
            <div class="start-axis-rule">
              {Array.from({ length: 12 }).map((_, index) => <i style={`--mark:${index}`}></i>)}
            </div>
            <span>more documented access</span>
          </div>
          <div class="stage-measure">
            <strong>{averageAdvantage}</strong>
            <span>average documented starting advantage</span>
            <small>/ {SCORE_FAMILIES.advantage.max}</small>
          </div>
        </div>

        <div class="stage-scene stage-scene-leverage" data-scene="2">
          <div class="leverage-rings">
            <i></i><i></i><i></i><i></i>
            <strong>×</strong>
          </div>
          <div class="stage-measure">
            <strong>{averageLeverage}</strong>
            <span>average built or converted leverage</span>
            <small>/ {SCORE_FAMILIES.leverage.max}</small>
          </div>
        </div>

        <div class="stage-scene stage-scene-sequence" data-scene="3">
          <svg class="sequence-map" viewBox="0 0 560 420">
            <path class="sequence-muted" d="M28 336 C140 292 142 350 228 266 S368 176 532 130" />
            <path class="sequence-muted" d="M28 336 C132 324 166 242 238 264 S362 302 532 214" />
            <path class="sequence-active" d="M28 336 C112 338 156 266 230 258 S348 166 532 82" />
            <circle cx="28" cy="336" r="6" />
            <circle cx="230" cy="258" r="6" />
            <circle cx="532" cy="82" r="8" />
          </svg>
          <div class="sequence-label sequence-label-start">opening</div>
          <div class="sequence-label sequence-label-middle">feedback</div>
          <div class="sequence-label sequence-label-end">recognition</div>
        </div>

        <div class="stage-scene stage-scene-boundary" data-scene="4">
          <div class="luck-orbit">
            <span class="orbit-core">unscored</span>
            <i style="--orbit-angle:18deg">era</i>
            <i style="--orbit-angle:86deg">encounter</i>
            <i style="--orbit-angle:158deg">timing</i>
            <i style="--orbit-angle:226deg">shock</i>
            <i style="--orbit-angle:302deg">variance</i>
          </div>
        </div>

        <div class="stage-caption">
          <span>Figure <b data-active-number>01</b> / 05</span>
          <strong data-active-title>The survivor</strong>
        </div>
      </div>
    </div>

    <div class="story-progress" aria-hidden="true"><i></i></div>

    <nav class="story-rail" aria-label="Story chapters">
      <a class="story-rail-brand" href="#story-opening" aria-label="Back to story opening">LS</a>
      <ol>
        {chapters.map((chapter, index) => (
          <li>
            <a
              href={`#${chapter.id}`}
              data-story-link={index}
              aria-current={index === 0 ? "step" : undefined}
            >
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{chapter.short}</strong>
            </a>
          </li>
        ))}
      </ol>
      <a class="story-rail-exit" href="/explore/">Explore <span>↗</span></a>
    </nav>

    <header class="story-opening" id="story-opening">
      <div class="story-opening-copy">
        <p class="story-kicker">{total.toLocaleString()} documented paths · 5 chapters · 7 minutes</p>
        <h1>The path you remember is one of many.</h1>
        <p class="story-deck">
          We collected {total.toLocaleString()} early-breakthrough paths. They do
          not reveal a formula for winning. They reveal what the finished story
          leaves out.
        </p>
        <a class="story-begin" href="#the-survivor">
          Begin with the visible outcome
          <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="story-opening-note">
        <span>Reading contract</span>
        <p>Selected successful outliers. No control group. No forecast.</p>
      </div>
    </header>

    <div class="story-chapters">
      <section
        class="story-chapter"
        id="the-survivor"
        data-story-chapter
        data-chapter-index="0"
        data-short-title="The survivor"
        aria-labelledby="story-heading-1"
      >
        <div class="story-copy">
          <p class="chapter-index"><span>01</span> Survivor selection</p>
          <h2 id="story-heading-1">
            {wordSpans("Biography starts at the end.").map((word, index) => (
              <span class="story-heading-word" style={`--word-index:${index}`}>{word}</span>
            ))}
          </h2>
          <p class="chapter-lede">
            Every person in this atlas is here because a documented breakthrough
            happened by 26. Selection begins after the outcome is already known.
          </p>
          <p>
            The archive shows the branch that stayed visible. It cannot count
            everyone with a similar start whose path met different timing,
            gatekeepers, obligations, health, or luck.
          </p>
          <aside class="chapter-evidence">
            <span>Thought experiment · not a measured probability</span>
            <strong>64 plausible starts → 1 remembered finish</strong>
            <p>Six hypothetical 50/50 gates are enough to make the final dot look inevitable in reverse.</p>
          </aside>
          <a class="chapter-link" href="/#survivor-path">Inspect the full survivor-path exhibit →</a>
        </div>
      </section>

      <section
        class="story-chapter"
        id="the-start"
        data-story-chapter
        data-chapter-index="1"
        data-short-title="The starting field"
        aria-labelledby="story-heading-2"
      >
        <div class="story-copy">
          <p class="chapter-index"><span>02</span> Starting position</p>
          <h2 id="story-heading-2">
            {wordSpans("Before talent had a résumé, the field was already uneven.").map((word, index) => (
              <span class="story-heading-word" style={`--word-index:${index}`}>{word}</span>
            ))}
          </h2>
          <p class="chapter-lede">
            Family resources, domain exposure, geography, institutions, tools,
            mentors, peers, and physical edge change which first moves are available.
          </p>
          <p>
            Across {total.toLocaleString()} selected paths, the average documented
            starting-advantage score is {averageAdvantage} out of {SCORE_FAMILIES.advantage.max}.
            That is a description of evidence near the start—not a talent score
            and not proof that undocumented support was absent.
          </p>
          <dl class="story-fact-line">
            <div><dt>Dimensions</dt><dd>12</dd></div>
            <div><dt>Cohorts</dt><dd>{cohortCount}</dd></div>
            <div><dt>Avg milestone age</dt><dd>{averageMilestoneAge}</dd></div>
          </dl>
          <a class="chapter-link" href="/methodology/">See how starting conditions are coded →</a>
        </div>
      </section>

      <section
        class="story-chapter"
        id="the-levers"
        data-story-chapter
        data-chapter-index="2"
        data-short-title="What multiplies"
        aria-labelledby="story-heading-3"
      >
        <div class="story-copy">
          <p class="chapter-index"><span>03</span> Built or converted leverage</p>
          <h2 id="story-heading-3">
            {wordSpans("Then some work begins to multiply itself.").map((word, index) => (
              <span class="story-heading-word" style={`--word-index:${index}`}>{word}</span>
            ))}
          </h2>
          <p class="chapter-lede">
            Reps produce skill. Skill earns trust. Trust attracts collaborators.
            Distribution brings feedback. Earlier proof changes the next opening.
          </p>
          <p>
            The average documented leverage score is {averageLeverage} out of {SCORE_FAMILIES.leverage.max}.
            But presence is not provenance. The same visible lever may have been
            built, enabled, earned, supplied from outside, or mixed.
          </p>
          <ul class="origin-line" aria-label="Possible origins of leverage">
            {LEVERAGE_ORIGINS.slice(0, 5).map((origin) => <li>{origin.label}</li>)}
          </ul>
          <aside class="chapter-evidence chapter-evidence-compact">
            <span>Evidence signal</span>
            <strong>{highConfidence.toLocaleString()} paths have high-confidence leverage coding</strong>
          </aside>
          <a class="chapter-link" href="/insights/#comparison-breaks-heading">Inspect why origin changes the comparison →</a>
        </div>
      </section>

      <section
        class="story-chapter"
        id="the-sequence"
        data-story-chapter
        data-chapter-index="3"
        data-short-title="What compounds"
        aria-labelledby="story-heading-4"
      >
        <div class="story-copy">
          <p class="chapter-index"><span>04</span> Compounding trajectory</p>
          <h2 id="story-heading-4">
            {wordSpans("A path is a sequence, not a score.").map((word, index) => (
              <span class="story-heading-word" style={`--word-index:${index}`}>{word}</span>
            ))}
          </h2>
          <p class="chapter-lede">
            Two people can have similar ingredients and still meet them in a
            different order, under a different clock, with different conversion costs.
          </p>
          <p>
            Starting advantage changes the available moves. Leverage changes how
            effectively effort can compound. Trajectory records what happened
            next. Observed standing describes the finish; it is not calculated
            from the earlier scores.
          </p>
          <ol class="sequence-steps">
            <li><span>01</span><strong>Starting position</strong></li>
            <li><span>02</span><strong>Built leverage</strong></li>
            <li><span>03</span><strong>Trajectory</strong></li>
            <li><span>04</span><strong>Observed standing</strong></li>
          </ol>
          <a class="chapter-link" href="/person/bill-gates/">Read one connected path end to end →</a>
        </div>
      </section>

      <section
        class="story-chapter story-chapter-final"
        id="the-boundary"
        data-story-chapter
        data-chapter-index="4"
        data-short-title="What stays unknowable"
        aria-labelledby="story-heading-5"
      >
        <div class="story-copy">
          <p class="chapter-index"><span>05</span> Luck and the boundary</p>
          <h2 id="story-heading-5">
            {wordSpans("Keep the model. Lose the prophecy.").map((word, index) => (
              <span class="story-heading-word" style={`--word-index:${index}`}>{word}</span>
            ))}
          </h2>
          <p class="chapter-lede">
            Era, geography, encounters, gatekeepers, shocks, timing, and outcome
            variance act across every transition. They stay visible here—and unscored.
          </p>
          <p>
            You can inspect conditions, build capability, choose better feedback,
            extend runway, and move closer to the work. You cannot inherit another
            person's sequence or turn a surviving biography into your forecast.
          </p>
          <blockquote class="story-close">
            <p>Study the conditions. Inspect what was built. Respect what cannot be replayed.</p>
            <footer>Then return to your own unfinished branch.</footer>
          </blockquote>
          <a class="story-essay-feature" href="/essays/who-filled-the-kings-jug/">
            <span class="story-essay-meta">Featured essay · 6 min read</span>
            <strong>Who Filled the King's Jug?</strong>
            <span class="story-essay-summary">
              Privilege, abstraction, and the invisible work behind accomplishment.
              {" "}<b>Read the essay →</b>
            </span>
          </a>
          <div class="story-actions">
            <a class="story-action-primary" href="/explore/">Explore {total.toLocaleString()} paths</a>
            <a href="/coverage/">Check the evidence</a>
            <a href="/compare/">Test a comparison</a>
          </div>
        </div>
      </section>
    </div>
  </div>

  <script>
    import { mountMarbleWorld } from "../scripts/marble-world";

    const story = document.querySelector<HTMLElement>("[data-story]");
    const storyCanvas = document.querySelector<HTMLCanvasElement>("[data-story-webgl]");
    const chapters = Array.from(document.querySelectorAll<HTMLElement>("[data-story-chapter]"));
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-story-link]"));
    const activeNumber = document.querySelector<HTMLElement>("[data-active-number]");
    const activeTitle = document.querySelector<HTMLElement>("[data-active-title]");
    const plateImages = Array.from(document.querySelectorAll<HTMLImageElement>("[data-story-src]"));

    if (story && chapters.length) {
      story.classList.add("story-ready");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const device = navigator as Navigator & {
        connection?: { saveData?: boolean };
        deviceMemory?: number;
      };
      const lowCapability = Boolean(
        device.connection?.saveData
        || (device.deviceMemory && device.deviceMemory <= 4)
      );
      const storyWorld = storyCanvas && !reduceMotion && !lowCapability ? mountMarbleWorld(storyCanvas) : null;
      const requestedShotValue = new URLSearchParams(window.location.search).get("shot");
      const requestedShot = requestedShotValue === null ? Number.NaN : Number(requestedShotValue);

      const loadPlate = (index: number) => {
        const image = plateImages[index - 1];
        const source = image?.dataset.storySrc;
        if (!image || !source || image.src) return;
        image.src = source;
      };
      loadPlate(1);

      const activate = (chapter: HTMLElement) => {
        const index = Number(chapter.dataset.chapterIndex || 0);
        story.dataset.activeChapter = String(index);
        loadPlate(index);
        loadPlate(index + 1);
        links.forEach((link, linkIndex) => {
          if (linkIndex === index) link.setAttribute("aria-current", "step");
          else link.removeAttribute("aria-current");
        });
        if (activeNumber) activeNumber.textContent = String(index + 1).padStart(2, "0");
        if (activeTitle) activeTitle.textContent = chapter.dataset.shortTitle || "";
      };

      let scheduled = false;
      const updateStoryState = () => {
        const start = chapters[0]?.offsetTop || 0;
        const endChapter = chapters.at(-1);
        const end = endChapter ? endChapter.offsetTop + endChapter.offsetHeight - window.innerHeight : start + 1;
        const scrollProgress = Math.min(1, Math.max(0, (window.scrollY - start) / Math.max(1, end - start)));
        const progress = Number.isFinite(requestedShot)
          ? Math.min(1, Math.max(0, requestedShot))
          : scrollProgress;
        story.style.setProperty("--story-progress", String(progress));
        storyWorld?.setProgress(progress);

        const atDocumentEnd = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
        const focusLine = window.innerHeight * 0.48;
        const activeChapter = Number.isFinite(requestedShot)
          ? chapters[Math.min(chapters.length - 1, Math.round(requestedShot * (chapters.length - 1)))]
          : atDocumentEnd
          ? chapters.at(-1)
          : chapters.reduce((closest, chapter) => {
              const bounds = chapter.getBoundingClientRect();
              const closestBounds = closest.getBoundingClientRect();
              const distance = bounds.top <= focusLine && bounds.bottom >= focusLine
                ? 0
                : Math.min(Math.abs(bounds.top - focusLine), Math.abs(bounds.bottom - focusLine));
              const closestDistance = closestBounds.top <= focusLine && closestBounds.bottom >= focusLine
                ? 0
                : Math.min(Math.abs(closestBounds.top - focusLine), Math.abs(closestBounds.bottom - focusLine));
              return distance < closestDistance ? chapter : closest;
            }, chapters[0]);
        if (activeChapter) activate(activeChapter);
        scheduled = false;
      };
      window.addEventListener("scroll", () => {
        if (scheduled) return;
        scheduled = true;
        window.requestAnimationFrame(updateStoryState);
      }, { passive: true });
      window.addEventListener("resize", updateStoryState, { passive: true });
      window.addEventListener("hashchange", updateStoryState);
      document.addEventListener("astro:before-swap", () => storyWorld?.destroy(), { once: true });
      window.requestAnimationFrame(updateStoryState);
    }
  </script>
</Base>
