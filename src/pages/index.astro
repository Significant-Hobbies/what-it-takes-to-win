---
import Base from "@saas-maker/templates/Base.astro";
import { GalleryPage } from "@saas-maker/templates/gallery-page";
import { baseProps } from "@saas-maker/templates/page";
import { galleryContent } from "@saas-maker/templates/schema";
import { footerContent } from "../lib/footer";
import home from "../content/home.json";
import Clarity from "../components/Clarity.astro";
import people from "../data/people.json";

const structuredData = {
  "@context": "https://schema.org", "@graph": [
  {"@type":"WebSite", "@id":"https://paths.significanthobbies.com/#website", name:"Paths", url:"https://paths.significanthobbies.com/"},
  {"@type":"WebApplication", "@id":"https://paths.significanthobbies.com/#app", name:"Paths", alternateName:["paths.significanthobbies.com","Look Sideways"], url:"https://paths.significanthobbies.com/", applicationCategory:"EducationalApplication", isAccessibleForFree:true, publisher:{"@type":"Organization","@id":"https://significanthobbies.com/#org","name":"Significant Hobbies","url":"https://significanthobbies.com"}},
  {"@type":"Dataset", "@id":"https://paths.significanthobbies.com/#dataset", name:"Paths documented lives", description:`${people.length.toLocaleString()} documented paths with explicit source and interpretation boundaries.`, url:"https://paths.significanthobbies.com/explore/"},
  {"@type": "Article",
  headline: "Same age. Different starting lines.",
  description: "A guided research exhibit about conditions, work, chance and the limits of comparison.",
  url: "https://paths.significanthobbies.com/",
  isPartOf: { "@id": "https://paths.significanthobbies.com/#website" }
  }]
};
const content = galleryContent.parse({
  ...home,
  page: {
    ...home.page,
    jsonLd: structuredData,
    og: {
      ...home.page.og,
      imageAlt: `Paths: ${people.length.toLocaleString()} documented paths, three sources of advantage, no success formula.`,
    },
  },
});
if (content.footer) content.footer = footerContent;
---

<Base {...baseProps(content)}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={content.hero.image} fetchpriority="high" />
    <meta name="theme-color" content="#eef0e7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/markdown" href="/index.md" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script is:inline async src="/scripts/posthog.js"></script>

    <Clarity />

    <script
      is:inline
      defer
      src="https://ingest.sassmaker.com/tracker.js"
      data-key="ahk_pub_5bf5a9051a94105f660b28ef1e15c01915f3798773baf090b2ff4cb81625bc76"
      data-project="app-0059a056-8d82-4404-bfd1-2939a1fe2346"
      data-identity="persistent"
      data-vitals
    ></script>
    <script is:inline src="/app-health-log.js" defer></script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const events = { "#the-start": "journey_continued", "/explore/": "archive_opened" };
        for (const link of document.querySelectorAll("a[href]")) {
          const name = events[link.getAttribute("href")];
          if (name) link.setAttribute("data-health-event", name);
        }
      }, { once: true });
    </script>
  </Fragment>
  <div id="the-survivor">
    <GalleryPage content={content} />
  </div>
</Base>
