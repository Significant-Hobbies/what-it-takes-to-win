---
import Base from "../layouts/Base.astro";
import peopleData from "../data/people.json";
import {
  CONDITION_FACTORS,
  LUCK_FORMS,
  getConditionFactorCoverage,
  type OutcomePerson,
} from "../lib/outcome-model";
import {
  getLuckEvidence,
  getPerseveranceEvidence,
  summarizeReachBands,
} from "../lib/journey-model";
import "../styles/kinetic-essay-story.css";

const people = peopleData as OutcomePerson[];
const total = people.length;
const averageMilestoneAge = (
  people.reduce((sum, person) => sum + person.age_at_milestone, 0) / total
).toFixed(1);
const cohortCount = new Set(people.map((person) => person.cohort_group)).size;
const conditionCoverage = getConditionFactorCoverage(people);
const reachBands = summarizeReachBands(people);
const broaderBand = reachBands.find((band) => band.key === "professionally-distinctive")!;
const bonnieTyler = people.find((person) => person.person_id === "bonnie-tyler")!;
const daveMurray = people.find((person) => person.person_id === "dave-murray")!;
const bonniePerseverance = getPerseveranceEvidence(bonnieTyler);
const bonnieLuck = getLuckEvidence(bonnieTyler);
const davePerseverance = getPerseveranceEvidence(daveMurray);

const chapters = [
  { id: "the-survivor", label: "The visible finish" },
  { id: "the-start", label: "Three sources" },
  { id: "the-levers", label: "Perseverance" },
  { id: "the-sequence", label: "Luck" },
  { id: "the-boundary", label: "The release" },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://paths.significanthobbies.com/#website",
      name: "Look Sideways",
      url: "https://paths.significanthobbies.com/",
      description:
        "A guided, evidence-bounded argument about why another person's path cannot become your forecast.",
    },
    {
      "@type": "Dataset",
      "@id": "https://paths.significanthobbies.com/#dataset",
      name: "Look Sideways documented paths",
      description: `${total.toLocaleString()} documented early-breakthrough paths with explicit evidence and interpretation boundaries.`,
      url: "https://paths.significanthobbies.com/explore/",
      creator: { "@id": "https://paths.significanthobbies.com/#website" },
    },
    {
      "@type": "Article",
      headline: "The path you remember is one of many",
      description:
        "A five-chapter journey through survivor selection, three sources of advantage, perseverance, luck, and the limits of comparison.",
      url: "https://paths.significanthobbies.com/",
      isPartOf: { "@id": "https://paths.significanthobbies.com/#website" },
      about: { "@id": "https://paths.significanthobbies.com/#dataset" },
    },
  ],
};
---

<Base
  title="Look Sideways — The Path You Remember Is One of Many"
  description={`A guided journey through ${total.toLocaleString()} documented paths showing why comparison loses the conditions, perseverance, sequence, and luck that made each outcome possible.`}
  canonicalPath="/"
  structuredData={structuredData}
  mainClass="story-main"
>
  <!--
    THESIS: A remembered outcome is one visible route, not a repeatable recipe; this refuses the standard metric-led hero.
    OWN-WORLD: Warm paper, black editorial ink, route blue, vermilion, ochre, sober serif arguments, and exact sans annotation.
    STORY: Watch three marbles trade the lead, then inspect the conditions, sequence, and uncertainty the finish conceals.
    FIRST VIEWPORT: The argument owns the left half; one full-height annotated course owns the right; the race action sits at the lower left.
    FORM: Kinetic Essay, selected owner direction, staged as a sticky evidence figure beside five scrolling passages.
  -->
  <article class="kinetic-story" data-story data-active-chapter="0">
    <div class="kinetic-progress" aria-hidden="true"><i></i></div>

    <div class="kinetic-narrative">
      <header class="kinetic-opening" id="story-opening">
        <div>
          <p class="kinetic-kicker">A visual argument about success</p>
          <h1>The path you remember is one of many.</h1>
          <p class="kinetic-deck">
            Comparison keeps the finish and deletes almost everything that produced it.
          </p>
          <p class="kinetic-summary">
            Follow the argument first. Then inspect the evidence: {total.toLocaleString()}{" "}
            documented paths, including {broaderBand.count.toLocaleString()} professionally
            distinctive outcomes—not only global icons.
          </p>
        </div>

        <div class="kinetic-opening-bottom">
          <dl class="kinetic-count">
            <dt>Documented paths</dt>
            <dd>{total.toLocaleString()}</dd>
          </dl>
          <a class="kinetic-begin" href="#race-course">Begin the journey <span aria-hidden="true">↓</span></a>
        </div>
      </header>

      <figure class="kinetic-course" id="race-course" aria-labelledby="race-title race-description">
        <svg viewBox="0 0 820 700" preserveAspectRatio="xMidYMid meet" role="img">
          <title id="race-title">Three marbles sharing one changing course</title>
          <desc id="race-description">
            The marbles trade the lead as the story moves through visible outcomes,
            conditions, perseverance, and luck. The diagram does not rank people or predict outcomes.
          </desc>
          <defs>
            <radialGradient id="runner-red" cx="32%" cy="25%" r="70%">
              <stop offset="0" stop-color="#ffe0d2" />
              <stop offset="0.16" stop-color="#ef725d" />
              <stop offset="0.7" stop-color="#c83424" />
              <stop offset="1" stop-color="#68140c" />
            </radialGradient>
            <radialGradient id="runner-blue" cx="32%" cy="25%" r="70%">
              <stop offset="0" stop-color="#e1f0ff" />
              <stop offset="0.16" stop-color="#6f95bb" />
              <stop offset="0.7" stop-color="#315f91" />
              <stop offset="1" stop-color="#142f49" />
            </radialGradient>
            <radialGradient id="runner-ochre" cx="32%" cy="25%" r="70%">
              <stop offset="0" stop-color="#fff3c6" />
              <stop offset="0.16" stop-color="#d7b65d" />
              <stop offset="0.7" stop-color="#a77d26" />
              <stop offset="1" stop-color="#594111" />
            </radialGradient>
          </defs>

          <g class="course-field" aria-hidden="true">
            <path class="course-outline" d="M -50 130 C 160 40 350 120 410 220 S 315 390 460 450 S 720 360 870 590" />
            <path class="course-bed" d="M -50 130 C 160 40 350 120 410 220 S 315 390 460 450 S 720 360 870 590" />
            <path class="course-centre" d="M -50 130 C 160 40 350 120 410 220 S 315 390 460 450 S 720 360 870 590" />
            <path class="course-gate" d="M 338 128 L 438 110" />
            <path class="course-gate course-gate-second" d="M 380 440 L 426 510" />
            <circle class="course-deflector" cx="604" cy="424" r="18" />
            <circle class="course-deflector" cx="651" cy="419" r="11" />
            <circle class="course-deflector" cx="692" cy="438" r="14" />
          </g>

          <path data-race-path="0" class="runner-path" d="M -50 105 C 160 15 350 95 410 195 S 315 365 460 425 S 720 335 870 565" />
          <path data-race-path="1" class="runner-path" d="M -50 130 C 160 40 350 120 410 220 S 315 390 460 450 S 720 360 870 590" />
          <path data-race-path="2" class="runner-path" d="M -50 155 C 160 65 350 145 410 245 S 315 415 460 475 S 720 385 870 615" />

          <g class="runner" data-runner="0" transform="translate(126 72)" aria-hidden="true">
            <ellipse class="runner-shadow" cx="6" cy="10" rx="22" ry="9" />
            <circle r="19" fill="url(#runner-red)" />
          </g>
          <g class="runner" data-runner="1" transform="translate(92 114)" aria-hidden="true">
            <ellipse class="runner-shadow" cx="6" cy="10" rx="22" ry="9" />
            <circle r="19" fill="url(#runner-blue)" />
          </g>
          <g class="runner" data-runner="2" transform="translate(54 153)" aria-hidden="true">
            <ellipse class="runner-shadow" cx="6" cy="10" rx="22" ry="9" />
            <circle r="19" fill="url(#runner-ochre)" />
          </g>
        </svg>

        <div class="race-folio">
          <span>Same course, different conditions.</span>
          <strong>Figure <b data-active-number>01</b> / 05</strong>
        </div>

        <div class="race-note" data-race-note="0"><strong>The visible finish</strong><span>The remembered outcome hides every route that disappeared.</span></div>
        <div class="race-note" data-race-note="1"><strong>Three sources</strong><span>What they brought, what they were handed, and what surrounded them.</span></div>
        <div class="race-note" data-race-note="2"><strong>Perseverance / evidenced</strong><span>Repeated work matters, but biographies record it unevenly.</span></div>
        <div class="race-note" data-race-note="3"><strong>Luck / unscored</strong><span>Some openings are encountered, not authored.</span></div>
        <div class="race-note" data-race-note="4"><strong>The release</strong><span>Study mechanisms. Do not borrow another person's identity.</span></div>

        <figcaption>
          <strong>Reading contract</strong>
          <span>Successful-outlier corpus. No whole-population baseline. No forecast.</span>
          <em>Illustrative course; positions are not scores.</em>
        </figcaption>
      </figure>

      <aside class="kinetic-mobile-register" id="race-register" aria-label="Current race passage">
        <div>
          <span>Race passage</span>
          <strong data-mobile-title>Survivor selection</strong>
          <small>Illustrative positions, not scores</small>
        </div>
        <svg viewBox="0 0 320 72" preserveAspectRatio="none" aria-hidden="true">
          <path d="M 9 38 C 86 5 145 65 213 33 S 275 19 311 38" />
          <circle data-mobile-runner="0" cx="44" cy="28" r="7" class="mobile-runner-red" />
          <circle data-mobile-runner="1" cx="40" cy="38" r="7" class="mobile-runner-blue" />
          <circle data-mobile-runner="2" cx="36" cy="48" r="7" class="mobile-runner-ochre" />
        </svg>
      </aside>

      <nav class="kinetic-chapter-index" aria-label="Story chapters">
        <span>Five passages</span>
        <ol>
          {chapters.map((chapter, index) => (
            <li><a href={`#${chapter.id}`} data-story-link={index} aria-current={index === 0 ? "step" : undefined}><span>{String(index + 1).padStart(2, "0")}</span>{chapter.label}</a></li>
          ))}
        </ol>
      </nav>

      <section class="kinetic-chapter" id="the-survivor" data-story-chapter data-chapter-index="0">
        <div class="chapter-number">01</div>
        <div class="chapter-copy">
          <p class="chapter-topic">The visible finish</p>
          <h2>Biography starts at the end.</h2>
          <p class="chapter-lede">Every person in this archive is here because a documented breakthrough happened by 26. Selection begins after the outcome is already known.</p>
          <p>A biography keeps the branch that stayed visible. It loses people with similar ability and effort whose paths met different obligations, health, timing, gatekeepers, or luck.</p>
          <aside class="kinetic-proof"><span>Thought experiment · not a measured probability</span><strong>64 plausible starts → 1 remembered finish</strong><p>Six hypothetical 50/50 gates are enough to make the final dot look inevitable in reverse.</p></aside>
          <a class="chapter-link" href="/overview/#survivor-path">Inspect the survivor-path exhibit →</a>
        </div>
      </section>

      <section class="kinetic-chapter" id="the-start" data-story-chapter data-chapter-index="1">
        <div class="chapter-number">02</div>
        <div class="chapter-copy">
          <p class="chapter-topic">Three sources of advantage</p>
          <h2>Ask three questions. Keep them separate.</h2>
          <p class="chapter-lede">Every visible advantage belongs to one of three places: inside the person, already prepared for them, or around them when the work met the world.</p>
          <ol class="kinetic-factor-list">
            {CONDITION_FACTORS.map((factor) => {
              const coverage = conditionCoverage.find((entry) => entry.key === factor.key)!;
              return (
                <li>
                  <span>{factor.gloss}</span>
                  <strong>{factor.label}</strong>
                  <p>{factor.question}</p>
                  <small>{coverage.assessed.toLocaleString()} paths assessed · never added to the other layers</small>
                </li>
              );
            })}
          </ol>
          <p class="kinetic-boundary">The detailed 22-field rubric still exists in the evidence room. It no longer needs to be the reader's mental model.</p>
          <a class="chapter-link" href="/methodology/#condition-factors--1-to-3-read-separately">Read the three-factor method →</a>
        </div>
      </section>

      <section class="kinetic-chapter" id="the-levers" data-story-chapter data-chapter-index="2">
        <div class="chapter-number">03</div>
        <div class="chapter-copy">
          <p class="chapter-topic">Perseverance matters</p>
          <h2>Effort changes a path. It does not make paths equivalent.</h2>
          <p class="chapter-lede">Repeated work creates skill, proof, trust, and more chances to encounter an opening. But the same perseverance can land on different terrain and produce different returns.</p>
          <div class="kinetic-case-ledger">
            <article>
              <span>{bonnieTyler.name} · {broaderBand.label}</span>
              <strong>{bonniePerseverance.summary}</strong>
              <p>{bonniePerseverance.boundary}</p>
              <a href={`/person/${bonnieTyler.person_id}/`}>Inspect the full path →</a>
            </article>
            <article>
              <span>{daveMurray.name} · {broaderBand.label}</span>
              <strong>{davePerseverance.summary}</strong>
              <p>{davePerseverance.boundary}</p>
              <a href={`/person/${daveMurray.person_id}/`}>Inspect the full path →</a>
            </article>
          </div>
          <p class="kinetic-boundary">A biography that does not mention perseverance is missing evidence—not documenting its absence.</p>
        </div>
      </section>

      <section class="kinetic-chapter" id="the-sequence" data-story-chapter data-chapter-index="3">
        <div class="chapter-number">04</div>
        <div class="chapter-copy">
          <p class="chapter-topic">Luck matters</p>
          <h2>Some doors are encountered, not authored.</h2>
          <p class="chapter-lede">Luck acts at every transition: the era, the person who notices, the gate that opens, the shock that never arrives, and the variance no biography can recover.</p>
          <aside class="kinetic-proof kinetic-proof-case">
            <span>{bonnieLuck.label} · {bonnieTyler.name}</span>
            <strong>{bonnieLuck.summary}</strong>
            <p>{bonnieLuck.boundary}</p>
          </aside>
          <ul class="kinetic-luck-list">
            {LUCK_FORMS.map((form) => <li><strong>{form.label}</strong><span>{form.summary}</span></li>)}
          </ul>
          <p class="kinetic-boundary">Luck is visible here and deliberately unscored. This successful-only archive cannot estimate its causal share.</p>
        </div>
      </section>

      <section class="kinetic-chapter kinetic-chapter-final" id="the-boundary" data-story-chapter data-chapter-index="4">
        <div class="chapter-number">05</div>
        <div class="chapter-copy">
          <p class="chapter-topic">The comparison breaks</p>
          <h2>The outcome is not portable.</h2>
          <p class="chapter-lede">You can learn from what someone built. You cannot inherit what they brought, replay what they were handed, reproduce what surrounded them, or schedule the same luck.</p>
          <div class="kinetic-reach" aria-label="Outcome reach represented in the archive">
            {reachBands.map((band) => (
              <div>
                <span>{band.label}</span>
                <strong>{band.count.toLocaleString()}</strong>
                <small>{band.share}% of this purposeful archive</small>
              </div>
            ))}
          </div>
          <p>The archive already reaches beyond the most famous outlier stories: {broaderBand.count.toLocaleString()} paths sit in the broader professionally distinctive band. “Top 0.1%” is treated as a direction of coverage, not a population statistic, until a field supplies a defensible denominator.</p>
          <blockquote class="kinetic-close"><p>Compare mechanisms for information. Never compare identities for a verdict.</p><footer>Then return to your own unfinished path.</footer></blockquote>
          <div class="kinetic-actions"><a class="kinetic-action-primary" href="/insights/">Enter the evidence room</a></div>
        </div>
      </section>
    </div>

    <section class="kinetic-essays" aria-labelledby="essays-heading">
      <header><p id="essays-heading">Go deeper after the journey</p><h2>Evidence first.<br />Articles when you want more.</h2><a href="/essays/">All articles →</a></header>
      <a class="kinetic-essay" href="/essays/everyone-has-lost-their-marbles/"><span>Essay 01 · 8 min read</span><strong>Everyone Has Lost Their Marbles</strong><p>Trajectories, comparison, and the bounded agency that actually runs a life.</p><b>Read essay ↗</b></a>
      <a class="kinetic-essay" href="/essays/who-filled-the-kings-jug/"><span>Essay 02 · 6 min read</span><strong>Who Filled the King's Jug?</strong><p>Privilege, abstraction, and the invisible work behind accomplishment.</p><b>Read essay ↗</b></a>
    </section>
  </article>

  <script>
    const story = document.querySelector<HTMLElement>("[data-story]");
    const chapters = Array.from(document.querySelectorAll<HTMLElement>("[data-story-chapter]"));
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-story-link]"));
    const paths = Array.from(document.querySelectorAll<SVGPathElement>("[data-race-path]"));
    const runners = Array.from(document.querySelectorAll<SVGGElement>("[data-runner]"));
    const mobileRunners = Array.from(document.querySelectorAll<SVGCircleElement>("[data-mobile-runner]"));
    const activeNumber = document.querySelector<HTMLElement>("[data-active-number]");
    const mobileTitle = document.querySelector<HTMLElement>("[data-mobile-title]");
    const raceNotes = Array.from(document.querySelectorAll<HTMLElement>("[data-race-note]"));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const requestedShotValue = new URLSearchParams(window.location.search).get("shot");
    const requestedShot = requestedShotValue === null ? Number.NaN : Number(requestedShotValue);
    const leadByChapter = [[0.026, 0.005, -0.016], [-0.012, 0.032, 0.004], [0.006, -0.014, 0.036], [0.034, 0.004, -0.012], [0, 0, 0]];

    if (story && chapters.length === 5 && paths.length === runners.length) {
      let frame = 0;
      const activate = (index: number) => {
        story.dataset.activeChapter = String(index);
        links.forEach((link, linkIndex) => linkIndex === index ? link.setAttribute("aria-current", "step") : link.removeAttribute("aria-current"));
        raceNotes.forEach((note, noteIndex) => note.setAttribute("aria-hidden", String(noteIndex !== index)));
        if (activeNumber) activeNumber.textContent = String(index + 1).padStart(2, "0");
        if (mobileTitle) mobileTitle.textContent = chapters[index]?.querySelector<HTMLElement>(".chapter-topic")?.textContent ?? "Current passage";
      };
      const update = () => {
        const start = story.offsetTop;
        const lastChapter = chapters.at(-1);
        const end = lastChapter ? lastChapter.offsetTop + lastChapter.offsetHeight - window.innerHeight : start + 1;
        const naturalProgress = Math.min(1, Math.max(0, (window.scrollY - start) / Math.max(1, end - start)));
        const progress = Number.isFinite(requestedShot) ? Math.min(1, Math.max(0, requestedShot)) : naturalProgress;
        const focusLine = window.innerHeight * 0.46;
        const activeChapter = Number.isFinite(requestedShot) ? Math.min(4, Math.round(progress * 4)) : chapters.reduce((bestIndex, chapter, index) => {
          const bounds = chapter.getBoundingClientRect();
          const bestBounds = chapters[bestIndex].getBoundingClientRect();
          const distance = bounds.top <= focusLine && bounds.bottom >= focusLine ? 0 : Math.min(Math.abs(bounds.top - focusLine), Math.abs(bounds.bottom - focusLine));
          const bestDistance = bestBounds.top <= focusLine && bestBounds.bottom >= focusLine ? 0 : Math.min(Math.abs(bestBounds.top - focusLine), Math.abs(bestBounds.bottom - focusLine));
          return distance < bestDistance ? index : bestIndex;
        }, 0);
        activate(activeChapter);
        story.style.setProperty("--race-progress", String(progress));
        const motionIsReduced = reducedMotion.matches && !Number.isFinite(requestedShot);
        const baseProgress = motionIsReduced ? 0.42 : 0.12 + progress * 0.82;
        runners.forEach((runner, index) => {
          const path = paths[index];
          const length = path.getTotalLength();
          const lead = motionIsReduced ? 0 : (leadByChapter[activeChapter]?.[index] ?? 0);
          const at = Math.min(0.97, Math.max(0.035, baseProgress + lead));
          const point = path.getPointAtLength(length * at);
          runner.setAttribute("transform", `translate(${point.x.toFixed(2)} ${point.y.toFixed(2)})`);
          const mobileRunner = mobileRunners[index];
          if (mobileRunner) {
            mobileRunner.setAttribute("cx", String(18 + at * 284));
          }
        });
        frame = 0;
      };
      const schedule = () => {
        if (frame) return;
        frame = window.requestAnimationFrame(update);
      };
      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", schedule);
      reducedMotion.addEventListener("change", schedule);
      update();
    }
  </script>
</Base>
