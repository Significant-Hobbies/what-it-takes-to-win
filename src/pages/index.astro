---
import Base from "../layouts/Base.astro";
import peopleData from "../data/people.json";
import {
  LEVERAGE_ORIGINS,
  OUTCOME_STAGES,
  SCORE_FAMILIES,
  getAdvantageTotal,
  getTierDefinition,
  summarizeOutcomes,
  type OutcomePerson,
} from "../lib/outcome-model";

const people = peopleData;
const total = people.length;
const outcomeSummary = summarizeOutcomes(people as OutcomePerson[]);

const cohorts: Record<string, number> = {};
people.forEach((p) => { cohorts[p.cohort_group] = (cohorts[p.cohort_group] || 0) + 1; });

const categories: Record<string, number> = {};
people.forEach((p) => { categories[p.category] = (categories[p.category] || 0) + 1; });

const engines: Record<string, number> = {};
people.forEach((p) => {
  const e = p.normalized_primary_engine || "Unknown";
  engines[e] = (engines[e] || 0) + 1;
});

const archetypes: Record<string, number> = {};
people.forEach((p) => {
  const a = p.primary_early_advantage_archetype || "Uncoded";
  archetypes[a] = (archetypes[a] || 0) + 1;
});

const ageBuckets: Record<number, number> = {};
for (let a = 13; a <= 26; a++) ageBuckets[a] = 0;
people.forEach((p) => {
  const a = p.age_at_milestone;
  if (a != null && ageBuckets[a] != null) ageBuckets[a]++;
});

const avgLeverage = (people.reduce((s, p) => s + (p.total_leverage_score || 0), 0) / total).toFixed(1);
const avgAdvantage = (
  people.reduce((sum, person) => sum + getAdvantageTotal(person as OutcomePerson), 0) / total
).toFixed(1);
const avgAge = (people.reduce((s, p) => s + (p.age_at_milestone || 0), 0) / total).toFixed(1);
const maxLeverage = SCORE_FAMILIES.leverage.max;

const advantageFields = [
  "early_family_financial_platform_support_score",
  "parent_family_domain_advantage_score",
  "inherited_audience_business_network_score",
  "elite_institution_performance_pipeline_score",
  "frontier_geography_ecosystem_score",
  "rare_early_tools_facilities_score",
  "dedicated_mentor_coach_tutor_score",
  "exceptional_peer_cofounder_sibling_score",
  "early_online_platform_community_score",
  "direct_customer_domain_exposure_score",
  "prodigy_physical_edge_score",
  "adversity_constraint_catalyst_score",
];
const advantageLabels = {
  early_family_financial_platform_support_score: "Family financial platform",
  parent_family_domain_advantage_score: "Parent family domain",
  inherited_audience_business_network_score: "Inherited audience/network",
  elite_institution_performance_pipeline_score: "Elite institution pipeline",
  frontier_geography_ecosystem_score: "Frontier geography",
  rare_early_tools_facilities_score: "Rare early tools",
  dedicated_mentor_coach_tutor_score: "Dedicated mentor/coach",
  exceptional_peer_cofounder_sibling_score: "Exceptional peer/cofounder",
  early_online_platform_community_score: "Early online platform",
  direct_customer_domain_exposure_score: "Direct domain exposure",
  prodigy_physical_edge_score: "Prodigy/innate ability",
  adversity_constraint_catalyst_score: "Adversity catalyst",
};
const advantageAvg = advantageFields.map((f) => ({
  field: f,
  label: advantageLabels[f],
  avg: (people.reduce((s, p) => s + (p[f] || 0), 0) / total).toFixed(2),
  count2: people.filter((p) => (p[f] || 0) >= 2).length,
}));

const cohortData = Object.entries(cohorts).map(([name, value]) => ({ name, value })).sort((a, b) => b.value - a.value);
const engineData = Object.entries(engines).map(([name, value]) => ({ name, value })).sort((a, b) => b.value - a.value);
const archetypeData = Object.entries(archetypes).map(([name, value]) => ({ name, value })).sort((a, b) => b.value - a.value);
const ageData = Object.entries(ageBuckets).map(([k, v]) => ({ age: k, count: v }));
const advantageData = advantageAvg.map((d) => ({ label: d.label, avg: Number(d.avg), count2: d.count2 }));

const showcaseIds = [
  "bill-gates",
  "mark-zuckerberg",
  "vitalik-buterin",
  "billie-eilish",
  "cristiano-ronaldo",
  "roger-federer",
  "yo-yo-ma",
  "madonna",
  "grigori-perelman",
  "nadia-comaneci",
  "ayrton-senna",
  "celine-dion",
];
const topPeople = showcaseIds
  .map((id) => people.find((person) => person.person_id === id))
  .filter(Boolean);
---

<Base title="What It Takes to Win — How Extraordinary Outcomes Happen">
  <section class="hero insight-hero">
    <p class="eyebrow">2,585 early breakthrough paths</p>
    <h1>How do extraordinary outcomes happen?</h1>
    <p class="lede">
      Start with the advantages someone inherited or encountered. Then see the multiplying capacity
      they built, converted, earned, or met through timing. Starting position and later capability
      are different layers—and neither determines the finish.
    </p>
    <div class="hero-model-preview" aria-label="The four-stage explanatory model">
      <span>Starting position</span>
      <span aria-hidden="true">→</span>
      <span>Built leverage</span>
      <span aria-hidden="true">→</span>
      <span>Trajectory</span>
      <span aria-hidden="true">→</span>
      <span>Observed standing</span>
    </div>
    <div class="hero-actions">
      <a class="btn-link btn-link-primary" href="/insights/">See the four-stage model</a>
      <a class="hero-secondary-link" href="/am-i-the-next/bill-gates/">Test a famous comparison →</a>
    </div>
    <div class="meta-row">
      <span><strong>{total}</strong> curated people</span>
      <span>avg milestone age <strong>{avgAge}</strong></span>
      <span>avg starting advantage <strong>{avgAdvantage} / {SCORE_FAMILIES.advantage.max}</strong></span>
      <span>avg built/converted leverage <strong>{avgLeverage} / {maxLeverage}</strong></span>
    </div>
  </section>

  <div class="insight-callout" data-clarity-contract="central-finding">
    <strong>The data shows a gradient, not a formula.</strong>
    {" "}T1 profiles average {outcomeSummary.tiers[0].advantage.mean.toFixed(1)} in documented
    starting advantage and {outcomeSummary.tiers[0].leverage.mean.toFixed(1)} in built or converted
    leverage; T4 profiles average {outcomeSummary.tiers[3].advantage.mean.toFixed(1)} and{" "}
    {outcomeSummary.tiers[3].leverage.mean.toFixed(1)}. But their ranges overlap. A head start
    changes the available moves; it is not the same thing as later multiplying capacity. Luck,
    sequence, and the origin of each lever explain why matching totals still do not make matching paths.
  </div>

  <section aria-labelledby="home-model-heading" data-clarity-contract="four-stage-model">
    <div class="section-heading" style="margin-top:0;">
      <p class="eyebrow">The explanatory model</p>
      <h2 id="home-model-heading">Four layers—not one success score</h2>
    </div>
    <div class="outcome-model" style="margin-bottom:24px;">
      {OUTCOME_STAGES.map((stage) => (
        <article class={`stage-card stage-${stage.number}`}>
          <div class="stage-number">{stage.number}</div>
          <h3>{stage.name}</h3>
          <p>{stage.summary}</p>
        </article>
      ))}
    </div>
    <p style="margin:0 0 36px;color:var(--text-dim);font-size:13px;">
      <a href="/insights/">See the tier definitions, score ranges, and strongest observed differences →</a>
    </p>
  </section>

  <section class="score-family-section" aria-labelledby="score-families-heading" data-clarity-contract="score-family-distinction">
    <div class="section-heading">
      <p class="eyebrow">Two different questions</p>
      <h2 id="score-families-heading">What did they start with—and what later multiplied their work?</h2>
    </div>
    <div class="score-family-grid">
      <article class="score-family-card advantage-family">
        <div class="score-family-kicker">01 · Position at the start</div>
        <h3>{SCORE_FAMILIES.advantage.label}</h3>
        <div class="score-family-value">{avgAdvantage}<span> / {SCORE_FAMILIES.advantage.max} dataset average</span></div>
        <p>{SCORE_FAMILIES.advantage.definition}</p>
        <strong>{SCORE_FAMILIES.advantage.boundary}</strong>
      </article>
      <article class="score-family-card leverage-family">
        <div class="score-family-kicker">02 · Multiplying capacity later present</div>
        <h3>{SCORE_FAMILIES.leverage.label}</h3>
        <div class="score-family-value">{avgLeverage}<span> / {SCORE_FAMILIES.leverage.max} dataset average</span></div>
        <p>{SCORE_FAMILIES.leverage.definition}</p>
        <strong>{SCORE_FAMILIES.leverage.boundary}</strong>
      </article>
    </div>
    <div class="provenance-note">
      <strong>Leverage has more than one origin.</strong>
      {LEVERAGE_ORIGINS.map((origin) => <span><b>{origin.label}</b> — {origin.summary}</span>)}
    </div>
  </section>

  <div class="warning-box">
    <strong>Read before interpreting.</strong> Scores are analyst interpretations applied through a
    common rubric, not objective measurements. Zero usually means "no clear evidence in reviewed
    sources," not "advantage was absent." This is a purposive outlier sample — it cannot estimate
    causal effects or base rates of success. See <a href="/methodology/">methodology</a>.
  </div>

  <div class="grid grid-4" style="margin-bottom: 24px;">
    <div class="stat">
      <div class="label">Curated people</div>
      <div class="value">{total}</div>
      <div class="sub">Founders, creators, athletes, researchers</div>
    </div>
    <div class="stat">
      <div class="label">Avg milestone age</div>
      <div class="value">{avgAge}</div>
      <div class="sub">Across all cohorts</div>
    </div>
    <div class="stat score-family-stat advantage-family">
      <div class="label">Avg starting advantage</div>
      <div class="value">{avgAdvantage} <span class="value-denominator">/ {SCORE_FAMILIES.advantage.max}</span></div>
      <div class="sub">Documented access or conditions near the start</div>
    </div>
    <div class="stat score-family-stat leverage-family">
      <div class="label">Avg built/converted leverage</div>
      <div class="value">{avgLeverage} <span class="value-denominator">/ {maxLeverage}</span></div>
      <div class="sub">Documented multiplying capacity later present</div>
    </div>
  </div>

  <div class="grid grid-2" style="margin-bottom: 24px;">
    <div class="card">
      <h3>Milestone age distribution</h3>
      <div id="chart-age" class="chart chart-short" role="img" aria-label="Bar chart showing milestone ages across the dataset"></div>
    </div>
    <div class="card">
      <h3>Cohort group</h3>
      <div id="chart-cohort" class="chart chart-short" role="img" aria-label="Donut chart showing the dataset split across founders, creators, athletes, and researchers"></div>
    </div>
  </div>

  <div class="grid grid-2" style="margin-bottom: 24px;">
    <div class="card">
      <h3>Primary leverage engine <span class="chart-hint">click a bar to explore</span></h3>
      <div id="chart-engine" class="chart chart-short" role="img" aria-label="Interactive bar chart of the most common primary leverage engines"></div>
    </div>
    <div class="card">
      <h3>Early-advantage archetype <span class="chart-hint">click a bar to explore</span></h3>
      <div id="chart-archetype" class="chart chart-short" role="img" aria-label="Interactive bar chart of early-advantage archetypes"></div>
    </div>
  </div>

  <div class="card" style="margin-bottom: 24px;">
    <h3>Starting-advantage dimensions (0–2 each) across all {total} people</h3>
    <p style="font-size:13px;color:var(--text-dim);margin:0 0 12px;">
      How often each early condition was documented as a meaningful (1) or unusually strong (2)
      advantage. Zero is "no clear evidence," not "absent."
    </p>
    <div id="chart-advantage" class="chart" role="img" aria-label="Bar chart showing average starting-advantage scores across twelve dimensions"></div>
  </div>

  <section class="featured-paths" aria-labelledby="featured-paths-heading">
    <div class="featured-paths-heading">
      <div>
        <p class="eyebrow">What non-copyable paths look like</p>
        <h2 id="featured-paths-heading">Twelve paths that cannot be collapsed into one recipe</h2>
        <p>
          These people span fields, starting positions, leverage compositions, and sequences.
          Their <strong>0–{maxLeverage}</strong> totals record capability presence—not where it came
          from, whether it was repeatable, or how luck redirected the path.
        </p>
      </div>
      <aside class="leverage-key" aria-label="Leverage score explanation">
        <div class="leverage-key-value">{avgLeverage}<span> / {maxLeverage}</span></div>
        <strong>built/converted leverage average</strong>
        <p>
          Higher means more documented capacity for effort to compound. It is not a talent score,
          a pass mark, or a formula for someone’s tier.
        </p>
        <a href="/methodology/">Read the scoring boundary →</a>
      </aside>
    </div>
    <p class="featured-selection-note">
      This is a deliberately varied inspection set, not a leaderboard. Similar totals can conceal
      different ingredients, origins, and outcomes.
    </p>
  </section>

  <div class="person-grid featured-person-grid">
    {topPeople.map((p) => (
      <a class="person-card featured-person-card" href={`/person/${p.person_id}/`}>
        <div class="featured-card-head">
          <div>
            <div class="name">{p.name}</div>
            <div class="cat">{p.category} · milestone at {p.age_at_milestone}</div>
          </div>
          <span class={`featured-tier tier-${p.success_tier}`} title={getTierDefinition(p.success_tier).short}>
            T{p.success_tier} · {getTierDefinition(p.success_tier).name}
          </span>
        </div>
        <div class="milestone">{p.milestone_by_age_26}</div>
        <div class="featured-leverage">
          <div class="featured-leverage-label">
            <span>Built or converted leverage</span>
            <strong>{p.total_leverage_score}<small> / {maxLeverage}</small></strong>
          </div>
          <div class="featured-leverage-track" aria-hidden="true">
            <span style={`width:${((p.total_leverage_score || 0) / maxLeverage) * 100}%`}></span>
          </div>
        </div>
        <div class="featured-card-footer">
          <span class="featured-archetype">Starting pattern: {p.primary_early_advantage_archetype || "No dominant archetype"}</span>
          <span class="featured-inspect">Inspect path <span aria-hidden="true">→</span></span>
        </div>
      </a>
    ))}
  </div>

  <div style="margin-top:32px;text-align:center;">
    <a href="/explore/" style="display:inline-block;padding:12px 24px;background:var(--accent);color:#0b0d12;border-radius:8px;font-weight:600;">
      Explore all {total} people →
    </a>
  </div>

  <script is:inline type="application/json" id="chart-data" set:html={JSON.stringify({ ageData, cohortData, engineData, archetypeData, advantageData })} />
  <script>
    import { chartTheme, initChart } from "../scripts/charts.js";

    const data = JSON.parse(document.getElementById("chart-data").textContent);
    const ageData = data.ageData;
    const cohortData = data.cohortData;
    const engineData = data.engineData;
    const archetypeData = data.archetypeData;
    const advantageData = data.advantageData;
    const theme = chartTheme;
    const baseAxis = {
      axisLine: { lineStyle: { color: theme.axisLineColor } },
      axisLabel: { color: theme.textColor, fontSize: 11 },
      splitLine: { lineStyle: { color: theme.splitLineColor } },
    };

    // Lazy-load full people data for chart click-through detail panels
    let allPeople: any[] | null = null;
    function loadPeople() {
      if (allPeople) return Promise.resolve(allPeople);
      return fetch("/data/people.json").then(r => r.json()).then(d => { allPeople = d; return d; });
    }
    function getGroup(field: string) {
      if (!allPeople) return {};
      const groups: Record<string, any[]> = {};
      allPeople.forEach(p => {
        const key = p[field] || "Uncoded";
        if (!groups[key]) groups[key] = [];
        groups[key].push({
          name: p.name, person_id: p.person_id, category: p.category,
          age_at_milestone: p.age_at_milestone, milestone: p.milestone_by_age_26,
          total_leverage_score: p.total_leverage_score, success_tier: p.success_tier,
          cohort_group: p.cohort_group,
        });
      });
      Object.values(groups).forEach(arr => arr.sort((a,b) => (b.total_leverage_score||0) - (a.total_leverage_score||0)));
      return groups;
    }

    // --- Detail panel logic ---
    function showDetail(title: string, peopleList: any[]) {
      const overlay = document.getElementById("chart-detail-overlay");
      const titleEl = document.getElementById("detail-title");
      const statsEl = document.getElementById("detail-stats");
      const peopleEl = document.getElementById("detail-people");
      titleEl.textContent = `${title} (${peopleList.length} people)`;

      // Stats
      const avgLev = (peopleList.reduce((s, p) => s + (p.total_leverage_score || 0), 0) / peopleList.length).toFixed(1);
      const avgAge = (peopleList.reduce((s, p) => s + (p.age_at_milestone || 0), 0) / peopleList.length).toFixed(1);
      const tierCounts: Record<string, number> = {};
      peopleList.forEach(p => { tierCounts[p.success_tier] = (tierCounts[p.success_tier] || 0) + 1; });
      const cohortCounts: Record<string, number> = {};
      peopleList.forEach(p => { cohortCounts[p.cohort_group] = (cohortCounts[p.cohort_group] || 0) + 1; });
      const tierStr = Object.entries(tierCounts).sort((a,b) => Number(a[0]) - Number(b[0])).map(([t,c]) => `T${t}: ${c}`).join(" · ");
      const cohortStr = Object.entries(cohortCounts).sort((a,b) => b[1]-a[1]).map(([k,c]) => `${k} (${c})`).join(" · ");

      statsEl.innerHTML = `
        <div class="stat-row">
          <span><strong>${peopleList.length}</strong> people</span>
          <span>avg built/converted leverage <strong>${avgLev} / 25</strong></span>
          <span>avg milestone age <strong>${avgAge}</strong></span>
        </div>
        <div class="stat-row sub">${tierStr}</div>
        <div class="stat-row sub">${cohortStr}</div>
      `;

      // People list (show top 50 by leverage, with "show more" for the rest)
      const visibleCount = Math.min(50, peopleList.length);
      const html = peopleList.slice(0, visibleCount).map(p => `
        <a class="detail-person" href="/person/${p.person_id}/">
          <span class="dp-name">${p.name}</span>
          <span class="dp-cat">${p.category}</span>
          <span class="dp-age">age ${p.age_at_milestone}</span>
          <span class="dp-lev">L${p.total_leverage_score}</span>
          <span class="dp-tier">T${p.success_tier}</span>
        </a>
      `).join("");
      const moreNote = peopleList.length > visibleCount
        ? `<div class="detail-more">Showing top ${visibleCount} of ${peopleList.length} — <a href="/explore/">explore all →</a></div>`
        : "";
      peopleEl.innerHTML = html + moreNote;

      overlay.style.display = "flex";
    }
    function closeDetail() {
      document.getElementById("chart-detail-overlay").style.display = "none";
    }
    document.getElementById("chart-detail-overlay").addEventListener("click", closeDetail);
    document.getElementById("chart-detail-panel").addEventListener("click", (event) => event.stopPropagation());
    document.getElementById("detail-close").addEventListener("click", closeDetail);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeDetail(); });

    // Age distribution
    initChart("chart-age", {
      color: theme.palette,
      grid: { left: 40, right: 20, top: 20, bottom: 30 },
      xAxis: { type: "category", data: ageData.map(d => d.age), ...baseAxis, axisTick: { show: false } },
      yAxis: { type: "value", ...baseAxis },
      series: [{
        type: "bar",
        data: ageData.map(d => d.count),
        itemStyle: { color: theme.palette[0], borderRadius: [3,3,0,0] },
      }],
    });

    // Cohort
    initChart("chart-cohort", {
      color: theme.palette,
      tooltip: { trigger: "item" },
      series: [{
        type: "pie",
        radius: ["45%","70%"],
        center: ["50%","50%"],
        data: cohortData,
        label: { color: theme.textColor, fontSize: 11 },
        labelLine: { lineStyle: { color: theme.splitLineColor } },
      }],
    });

    // Engine
    const engineChart = initChart("chart-engine", {
      color: theme.palette,
      grid: { left: 160, right: 20, top: 10, bottom: 20 },
      xAxis: { type: "value", ...baseAxis },
      yAxis: { type: "category", data: engineData.map(d => d.name), ...baseAxis, axisTick: { show: false } },
      tooltip: {
        trigger: "axis",
        formatter: (params) => {
          const d = engineData[params[0].dataIndex];
          return `${d.name}<br/>${d.value} people<br/><span style="color:#888">click to explore</span>`;
        },
      },
      series: [{
        type: "bar",
        data: engineData.map(d => d.value),
        itemStyle: { color: theme.palette[1], borderRadius: [0,3,3,0], cursor: "pointer" },
        label: { show: true, position: "right", color: theme.textColor, fontSize: 11 },
      }],
    });
    engineChart.on("click", (params) => {
      if (params.componentType === "series") {
        const d = engineData[params.dataIndex];
        if (d) {
          loadPeople().then(() => {
            const groups = getGroup("normalized_primary_engine");
            if (groups[d.name]) showDetail(d.name, groups[d.name]);
          });
        }
      }
    });

    // Archetype
    const archetypeChart = initChart("chart-archetype", {
      color: theme.palette,
      grid: { left: 180, right: 20, top: 10, bottom: 20 },
      xAxis: { type: "value", ...baseAxis },
      yAxis: { type: "category", data: archetypeData.map(d => d.name), ...baseAxis, axisTick: { show: false } },
      tooltip: {
        trigger: "axis",
        formatter: (params) => {
          const d = archetypeData[params[0].dataIndex];
          return `${d.name}<br/>${d.value} people<br/><span style="color:#888">click to explore</span>`;
        },
      },
      series: [{
        type: "bar",
        data: archetypeData.map(d => d.value),
        itemStyle: { color: theme.palette[2], borderRadius: [0,3,3,0], cursor: "pointer" },
        label: { show: true, position: "right", color: theme.textColor, fontSize: 11 },
      }],
    });
    archetypeChart.on("click", (params) => {
      if (params.componentType === "series") {
        const d = archetypeData[params.dataIndex];
        if (d) {
          loadPeople().then(() => {
            const groups = getGroup("primary_early_advantage_archetype");
            if (groups[d.name]) showDetail(d.name, groups[d.name]);
          });
        }
      }
    });

    // Advantage averages
    initChart("chart-advantage", {
      color: theme.palette,
      grid: { left: 200, right: 60, top: 10, bottom: 30 },
      xAxis: { type: "value", max: 2, ...baseAxis },
      yAxis: { type: "category", data: advantageData.map(d => d.label), ...baseAxis, axisTick: { show: false } },
      tooltip: {
        trigger: "axis",
        formatter: (params) => {
          const d = advantageData[params[0].dataIndex];
          return `${d.label}<br/>avg: ${d.avg}<br/>scored 2: ${d.count2} people`;
        },
      },
      series: [{
        type: "bar",
        data: advantageData.map(d => d.avg),
        itemStyle: { color: theme.palette[0], borderRadius: [0,3,3,0] },
        label: { show: true, position: "right", color: theme.textColor, fontSize: 11, formatter: (p) => p.value.toFixed(2) },
      }],
    });
  </script>

  <!-- Detail panel modal for chart click-throughs -->
  <div id="chart-detail-overlay" class="detail-overlay" style="display:none;">
    <div id="chart-detail-panel" class="detail-panel">
      <div class="detail-header">
        <h3 id="detail-title"></h3>
        <button id="detail-close" class="detail-close" aria-label="Close details">&times;</button>
      </div>
      <div id="detail-stats" class="detail-stats"></div>
      <div id="detail-people" class="detail-people"></div>
    </div>
