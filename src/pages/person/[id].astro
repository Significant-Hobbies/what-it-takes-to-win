---
import Base from "../../layouts/Base.astro";
import peopleData from "../../data/people.json";
import {
  ADVANTAGE_FIELDS,
  CONDITION_FACTOR_MAX,
  CONDITION_FACTOR_MIN,
  CONDITION_FACTOR_STEPS,
  LEVERAGE_FIELDS,
  LUCK_FORMS,
  SCORE_FAMILIES,
  buildPersonPath,
  getConditionFactors,
  getPersonLeverageProvenance,
  summarizeOutcomes,
  type OutcomePerson,
  type ScoreField,
} from "../../lib/outcome-model";

export function getStaticPaths() {
  return peopleData.map((p) => ({ params: { id: p.person_id } }));
}

const people = peopleData as OutcomePerson[];
const p = people.find((person) => person.person_id === Astro.params.id)!;
const path = buildPersonPath(p, people);
const conditionFactors = getConditionFactors(p);
const outcomeSummary = summarizeOutcomes(people);
const standing = outcomeSummary.tiers.find((tier) => tier.tier === p.success_tier)!;
const standingBand = standing.rankStart === 1
  ? `Top ${standing.topBandEnd.toFixed(1)}% tier`
  : `${standing.topBandStart.toFixed(1)}–${standing.topBandEnd.toFixed(1)}% band from the top`;

function barRows(fields: ScoreField[], person: OutcomePerson) {
  return fields.map((field) => {
    const rawValue = person[field.key];
    const value = typeof rawValue === "number" ? rawValue : 0;
    const pct = (value / field.max) * 100;
    return { label: field.label, value, max: field.max, pct };
  });
}

const leverageRows = barRows(LEVERAGE_FIELDS, p);
const advantageRows = barRows(ADVANTAGE_FIELDS, p);
const leverageProvenance = getPersonLeverageProvenance(p);

const related = people
  .filter((x) => x.person_id !== p.person_id && x.normalized_primary_engine === p.normalized_primary_engine)
  .sort((a,b) => (b.total_leverage_score||0) - (a.total_leverage_score||0))
  .slice(0, 6);

const personUrl = `https://paths.significanthobbies.com/person/${encodeURIComponent(p.person_id)}/`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${personUrl}#webpage`,
      url: personUrl,
      name: `${p.name} — Look Sideways`,
      description: p.milestone_by_age_26,
      mainEntity: { "@id": `${personUrl}#person` },
      isPartOf: { "@id": "https://paths.significanthobbies.com/#website" },
    },
    {
      "@type": "Person",
      "@id": `${personUrl}#person`,
      name: p.name,
      description: `${p.name}'s documented early path: ${p.milestone_by_age_26}`,
      url: personUrl,
      sameAs: p.source_urls,
    },
  ],
};
---

<Base
  title={`${p.name} — Look Sideways`}
  description={p.milestone_by_age_26}
  structuredData={structuredData}
>
  <section class="person-detail">
    <p style="margin:24px 0 8px;font-family:var(--mono);font-size:12px;color:var(--text-faint);">
      <a href="/explore/">← back to explore</a>
    </p>
    <h1>{p.name}</h1>
    <div class="cat">
      {p.cohort_group} · {p.category} · milestone at age {p.age_at_milestone} ·
      <a href={`/insights/#tier-${p.success_tier}`}>T{p.success_tier} {path.tierDefinition.name}</a>
    </div>

    <div class="milestone-box">
      <div class="label">Milestone (age {p.age_at_milestone})</div>
      <div class="text">{p.milestone_by_age_26}</div>
    </div>

    <div class="summary">{p.early_history_summary}</div>
    <section
      class={`standing-context tier-${p.success_tier}`}
      aria-labelledby="standing-context-heading"
      data-clarity-contract="outcome-distribution-context"
    >
      <div class="standing-context-heading">
        <div>
          <p class="eyebrow">Standing in this curated dataset</p>
          <h2 id="standing-context-heading">
            {standingBand} · ranks {standing.rankStart.toLocaleString()}–{standing.rankEnd.toLocaleString()}
          </h2>
        </div>
        <span class="tier-badge">T{p.success_tier} · {standing.name}</span>
      </div>
      <div class="standing-context-stats">
        <div>
          <strong>{standing.count.toLocaleString()}</strong>
          <span>profiles in the same tier</span>
        </div>
        <div>
          <strong>{standing.lowerOutcomeCount.toLocaleString()}</strong>
          <span>lower-tier paths in this dataset</span>
        </div>
        <div>
          <strong>{standing.lowerPerMember.toFixed(1)}×</strong>
          <span>lower-tier paths per {standing.name.toLowerCase()} profile</span>
        </div>
      </div>
      <p class="standing-context-boundary">
        This is a tier band, not {p.name}'s exact percentile: people are not ranked within a tier.
        It is also not a success probability. Every person here already had a documented early
        breakthrough; ordinary attempts and near-misses are outside the dataset.
      </p>
    </section>
    <div class="person-next-cta">
      <div>
        <strong>Think your path resembles {p.name}'s?</strong>
        <span>Compare the visible ingredients, then see exactly where the comparison stops working.</span>
      </div>
      <a class="btn-link btn-link-primary" href={`/am-i-the-next/${p.person_id}/`}>
        Am I the next {p.name}? →
      </a>
    </div>

    {p.starting_point && p.starting_point !== "Not documented in reviewed sources." && (
      <div class="grid grid-2" style="margin-bottom:8px;">
        <div class="card">
          <h3>Starting point</h3>
          <p style="font-size:14px;color:var(--text-dim);margin:0;">{p.starting_point}</p>
        </div>
        <div class="card">
          <h3>Current position ({p.current_position_year ?? "—"}{p.is_living === false ? " · deceased" : ""})</h3>
          <p style="font-size:14px;color:var(--text-dim);margin:0;">{p.current_position || "Not documented."}</p>
        </div>
      </div>
    )}

    <section class="condition-factors" data-clarity-contract="condition-factors">
      <div class="section-heading">
        <p class="eyebrow">Where the conditions came from</p>
        <h2>Three sources, read side by side</h2>
        <p>
          Each is placed on a &minus;1 to {CONDITION_FACTOR_MAX} scale from documented
          evidence, and the three are never added together. A combined total would
          rank {p.name}{" "}against other people. Held apart, they explain why this
          path ran differently from another one&mdash;which is the only comparison
          this project supports.
        </p>
      </div>
      <div class="condition-factor-grid">
        {conditionFactors.map((factor) => (
          <article class={`condition-factor condition-factor-${factor.band ?? "unassessed"}`}>
            <p class="condition-factor-gloss">{factor.gloss}</p>
            <h3>{factor.label}</h3>
            <p class="condition-factor-score">
              <b>{factor.assessed ? (factor.score! > 0 ? `+${factor.score}` : String(factor.score)) : "—"}</b>
              <span>{factor.bandLabel}</span>
            </p>
            <div
              class="condition-factor-axis"
              role="img"
              aria-label={factor.assessed
                ? `${factor.score} on a scale from ${CONDITION_FACTOR_MIN} to ${CONDITION_FACTOR_MAX}`
                : "Not assessed"}
            >
              {CONDITION_FACTOR_STEPS.map((step) => (
                <i
                  class={`${step < 0 ? "negative" : ""} ${factor.score === step ? "current" : ""}`.trim() || undefined}
                ><span>{step > 0 ? `+${step}` : String(step)}</span></i>
              ))}
            </div>
            <p class="condition-factor-question">{factor.question}</p>
            {factor.summary
              ? <p class="condition-factor-summary">{factor.summary}</p>
              : (
                <p class="condition-factor-summary condition-factor-muted">
                  The reviewed sources did not support a judgement here.
                </p>
              )}
          </article>
        ))}
      </div>
      <p class="condition-factor-note">
        A &minus;1 is a documented headwind, not a missing value; a 0 means the
        sources record nothing notable either way.
        {p.scoring_confidence ? ` Annotation confidence: ${p.scoring_confidence}.` : ""}
        {" "}These are analyst readings of what the sources record, not measurements
        of merit, talent, or effort. The twenty-two scored dimensions below break the
        same evidence down further.
      </p>
    </section>

    <div class="section-title">How this path compounded</div>
    <div class="path-flow" data-clarity-contract="person-path">
      <article class="path-step score-family-path advantage-family">
        <div class="path-label"><span>01</span> {SCORE_FAMILIES.advantage.label}</div>
        <h3>{path.advantageTotal}/{SCORE_FAMILIES.advantage.max} starting-position score</h3>
        <p>
          {path.strongestAdvantages.length > 0
            ? `Strongest documented signals: ${path.strongestAdvantages.map((field) => field.label).join(", ")}.`
            : "No early condition was strongly documented in the reviewed sources."}
        </p>
        <p class="score-family-boundary">{SCORE_FAMILIES.advantage.boundary}</p>
        <div class="path-context">Cohort percentile: {path.cohortAdvantagePercentile}</div>
      </article>
      <article class="path-step score-family-path leverage-family">
        <div class="path-label"><span>02</span> {SCORE_FAMILIES.leverage.label}</div>
        <h3>{path.leverageTotal}/{SCORE_FAMILIES.leverage.max} multiplying-capacity score</h3>
        <p>
          Strongest observed levers:{" "}
          {path.strongestLeverage.map((field) => field.label).join(", ") || "none clearly documented"}.
        </p>
        <p class="score-family-boundary">{SCORE_FAMILIES.leverage.boundary}</p>
        <div class="path-context">Cohort percentile: {path.cohortLeveragePercentile}</div>
      </article>
      <article class="path-step">
        <div class="path-label"><span>03</span> Compounding trajectory</div>
        <h3>{Array.isArray(p.trajectory) ? p.trajectory.length : 0} documented steps</h3>
        <p>
          The timeline below shows the sequence of work and transitions around the selected early
          milestone. It is evidence of a path, not proof that every step was necessary.
        </p>
        <div class="path-context">Milestone at age {p.age_at_milestone}</div>
      </article>
      <article class={`path-step outcome-step tier-${p.success_tier}`}>
        <div class="path-label"><span>04</span> Observed career standing</div>
        <h3>T{p.success_tier} · {path.tierDefinition.name}</h3>
        <p>{path.tierDefinition.short}. The tier summarizes documented career recognition through the data cutoff—not {p.name}'s worth or future potential.</p>
        <div class="path-context"><a href={`/insights/#tier-${p.success_tier}`}>How tiers work →</a></div>
      </article>
    </div>

    <section class="person-provenance-section" data-clarity-contract="leverage-provenance">
      <div class="section-heading">
        <p class="eyebrow">Question four · where did the leverage come from?</p>
        <h2>{p.name}'s leverage provenance</h2>
        <p>
          Each non-zero lever gets a best-supported origin, evidence signals, and confidence.
          Unresolved is the honest default when the biography cannot distinguish self-built,
          advantage-enabled, earned, external, or mixed.
        </p>
      </div>
      <div class="provenance-table">
        {leverageProvenance.map((item) => (
          <article class={`provenance-row origin-${item.origin}`}>
            <div>
              <span class="provenance-field">{item.field.label}</span>
              <strong>{item.value}/{item.field.max}</strong>
            </div>
            <div>
              <span class="provenance-origin">{item.originLabel}</span>
              <small>{item.confidence} confidence</small>
            </div>
            <p>{item.rationale}</p>
            <div class="provenance-signals">
              {item.signals.length > 0
                ? item.signals.map((signal) => <span>{signal}</span>)
                : <span>No decisive linked signal</span>}
            </div>
          </article>
        ))}
      </div>
      <p class="provenance-caveat">
        This is a bounded inference from the current annotations—not a claim about private effort,
        merit, or the percentage of {p.name}'s outcome attributable to any origin.
      </p>
    </section>

    <section class="luck-inline" data-clarity-contract="luck-and-variance">
      <strong>Luck is not a leftover score.</strong>
      <p>
        {LUCK_FORMS.map((form) => form.label).join(", ")} can change every arrow in the path.
        This successful-only dataset cannot observe the near-identical paths that did not break through,
        so luck stays visible and unscored.
      </p>
    </section>

    <div class="benchmark-note">
      Within <strong>{p.cohort_group}</strong>, {p.name}'s starting-advantage total is at the
      <strong> {path.cohortAdvantagePercentile}th percentile</strong>. Separately, their built or
      converted leverage total is at the <strong>{path.cohortLeveragePercentile}th percentile</strong>.
      Other T{p.success_tier} profiles average {path.tierAdvantageMean.toFixed(1)} / {SCORE_FAMILIES.advantage.max}
      {" "}starting advantage and {path.tierLeverageMean.toFixed(1)} / {SCORE_FAMILIES.leverage.max}
      {" "}leverage. Similar scores appear in other tiers, so these figures describe positioning—not a cause.
    </div>

    {Array.isArray(p.trajectory) && p.trajectory.length > 0 && (
      <>
        <div class="section-title">Trajectory</div>
        <div class="card">
          <ol class="trajectory" style="margin:0;padding-left:20px;font-size:14px;">
            {p.trajectory.map((t) => (
              <li style="margin-bottom:10px;">
                <span style="font-family:var(--mono);color:var(--accent);font-size:12px;">{t.year} · age {t.age}</span>
                {t.title && <div style="color:var(--text);font-weight:500;font-size:13px;margin-top:2px;">{t.title}</div>}
                {t.description && <div style="color:var(--text-dim);">{t.description}</div>}
              </li>
            ))}
          </ol>
        </div>
      </>
    )}

    <div class="grid grid-3" style="margin-bottom:8px;">
      <div class="stat">
        <div class="label">Primary leverage engine</div>
        <div class="value" style="font-size:18px;">{p.primary_leverage_engine}</div>
        <div class="sub">{p.normalized_primary_engine}</div>
      </div>
      <div class="stat">
        <div class="label">Secondary engine</div>
        <div class="value" style="font-size:18px;">{p.secondary_engine || "—"}</div>
      </div>
      <div class="stat score-family-stat leverage-family">
        <div class="label">Built/converted leverage</div>
        <div class="value">{p.total_leverage_score} <span class="value-denominator">/ {SCORE_FAMILIES.leverage.max}</span></div>
        <div class="sub">evidence: {p.leverage_evidence_confidence}</div>
      </div>
    </div>

    <div class="section-title">Built or converted leverage</div>
    <p class="score-section-intro">{SCORE_FAMILIES.leverage.definition} {SCORE_FAMILIES.leverage.boundary}</p>
    <div class="card score-family-detail leverage-family">
      {leverageRows.map((r) => (
        <div class="score-bar-row">
          <div class="name">{r.label}</div>
          <div class="bar"><div class="bar-fill" style={`width:${r.pct}%`}></div></div>
          <div class="val">{r.value}/{r.max}</div>
        </div>
      ))}
    </div>

    <div class="section-title">Starting-advantage scores (0–2 each)</div>
    <p class="score-section-intro">
      {SCORE_FAMILIES.advantage.definition} Zero means "no clear evidence in reviewed sources," not
      "advantage was absent."
    </p>
    <div class="card score-family-detail advantage-family">
      {advantageRows.map((r) => (
        <div class="score-bar-row">
          <div class="name">{r.label}</div>
          <div class="bar"><div class="bar-fill" style={`width:${r.pct}%`}></div></div>
          <div class="val">{r.value}/{r.max}</div>
        </div>
      ))}
    </div>

    <div class="grid grid-2" style="margin-top:24px;">
      <div class="card">
        <h3>Family context</h3>
        <p style="font-size:14px;color:var(--text-dim);margin:0;">{p.family_context_summary || "Not documented."}</p>
      </div>
      <div class="card">
        <h3>Parent / family domain</h3>
        <p style="font-size:14px;color:var(--text-dim);margin:0;">{p.parent_family_domain_summary || "Not documented."}</p>
      </div>
    </div>

    <div class="section-title">Archetype & tags</div>
    <div>
      <span class="tag" style="border-color:var(--accent);color:var(--accent);">{p.primary_early_advantage_archetype}</span>
      {p.primary_early_advantage_tags_list.map((t) => <span class="tag">{t}</span>)}
    </div>

    <div class="section-title">Evidence summary</div>
    <div class="card">
      <p style="font-size:14px;color:var(--text-dim);margin:0;">{p.evidence_summary}</p>
      <p style="font-size:12px;color:var(--text-faint);margin:12px 0 0;font-family:var(--mono);">
        advantage confidence: {p.early_advantage_evidence_confidence} · source count: {p.source_count} ·
        audit: {p.source_audit_status} · status: {p.annotation_status}
      </p>
    </div>

    <div class="section-title">Sources</div>
    <div class="card">
      <ul class="source-list" style="margin:0;padding-left:20px;font-size:14px;">
        {p.source_urls.map((u) => <li><a href={u} target="_blank" rel="noopener">{u}</a></li>)}
      </ul>
    </div>

    {related.length > 0 && (
      <>
        <div class="section-title">Related — same primary engine</div>
        <div class="person-grid">
          {related.map((r) => (
            <a class="person-card" href={`/person/${r.person_id}/`}>
              <div class="name">{r.name}</div>
              <div class="cat">{r.category} · age {r.age_at_milestone}</div>
              <div class="milestone">{r.milestone_by_age_26}</div>
              <div class="scores">
                <span class="score-pill">Leverage <strong>{r.total_leverage_score}/{SCORE_FAMILIES.leverage.max}</strong></span>
                <span class="score-pill">T{r.success_tier}</span>
              </div>
            </a>
          ))}
        </div>
      </>
    )}
  </section>
</Base>
