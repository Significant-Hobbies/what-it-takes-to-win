---
import Base from "../../layouts/Base.astro";
import candidateCoverage from "../../data/candidate-coverage.json";
import peopleData from "../../data/people.json";
import { summarizeCoverage, type CoveragePerson } from "../../lib/coverage";
import "../../styles/coverage.css";

const coverage = summarizeCoverage(peopleData as CoveragePerson[]);
const formatShare = (share: number) =>
  `${share.toFixed(share === Math.round(share) ? 0 : 1)}%`;
const lifecycleStates = ["queued", "eligible", "ineligible", "published"] as const;

// The release verdict is derived, never asserted: paths added after the last
// reachability pass carry no audit verdict, so the audit cannot be called
// complete while any remain pending.
const auditComplete = coverage.auditPending.count === 0;
const releaseVerdict = auditComplete
  ? "Double-coding and source reachability are complete across every published path. User comprehension and matched comparison remain pending."
  : `Double-coding is complete. Source reachability covers ${coverage.auditReviewed.count.toLocaleString()} of ${coverage.total.toLocaleString()} paths — ${coverage.auditPending.count.toLocaleString()} added since the last pass carry no audit verdict yet. User comprehension and matched comparison remain pending.`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Evidence coverage — Look Sideways",
  description:
    `Live candidate, research-backlog, publication, and evidence metrics across ${candidateCoverage.total_candidates.toLocaleString()} discovered people.`,
  url: "https://paths.significanthobbies.com/coverage/",
  isPartOf: { "@id": "https://paths.significanthobbies.com/#website" },
};
---

<Base
  title="Evidence Coverage — Look Sideways"
  description={`Inspect ${candidateCoverage.total_candidates.toLocaleString()} discovered candidates, the research backlog, source freshness, and publication evidence across ${coverage.total.toLocaleString()} paths.`}
  structuredData={structuredData}
>
  <section class="hero coverage-hero" data-clarity-contract="public-evidence-coverage">
    <div class="coverage-hero-grid">
      <div>
        <p class="eyebrow">Coverage ledger · candidates through publication</p>
        <h1>No record ceiling.<br />Every gap stays visible.</h1>
        <p class="lede">
          The project now tracks discovered people before they become profiles.
          Publication still requires a dated age-relative outcome and independently
          useful evidence; uncaught private or poorly indexed outcomes remain a known
          boundary rather than a reason to declare the census complete.
        </p>
      </div>
      <aside class="coverage-verdict" aria-label="Current evidence verdict">
        <span>Release assessment</span>
        <strong>Coverage in progress</strong>
        <p>{releaseVerdict}</p>
        <div class="coverage-verdict-mark">
          <b>{coverage.independentlyAudited.count.toLocaleString()}</b>
          <span>of {coverage.total.toLocaleString()} paths have every listed source verified reachable</span>
        </div>
      </aside>
    </div>
    <div class="coverage-hero-metrics" aria-label="Headline coverage metrics">
      <div>
        <strong>{coverage.total.toLocaleString()}</strong>
        <span>published paths</span>
      </div>
      <div>
        <strong>{formatShare(coverage.trajectoriesComplete.share)}</strong>
        <span>three-event trajectories</span>
      </div>
      <div>
        <strong>{formatShare(coverage.sourcesTwoPlus.share)}</strong>
        <span>two or more listed sources</span>
      </div>
      <div>
        <strong>{formatShare(coverage.indexable.share)}</strong>
        <span>pass the search evidence gate</span>
      </div>
    </div>
  </section>

  <nav class="coverage-contents" aria-label="Coverage page sections">
    <span>On this sheet</span>
    <a href="#candidate-coverage-heading">Funnel</a>
    <a href="#coverage-ladder-heading">Evidence levels</a>
    <a href="#confidence-heading">Confidence</a>
    <a href="#composition-heading">Composition</a>
    <a href="#boundary-heading">Missing denominator</a>
    <a href="#roadmap-heading">Audit gates</a>
  </nav>

  <section class="coverage-section" aria-labelledby="candidate-coverage-heading">
    <div class="coverage-section-heading">
      <div>
        <p class="eyebrow">The complete funnel</p>
        <h2 id="candidate-coverage-heading">A profile count is not a coverage claim.</h2>
      </div>
      <p>
        The target is uncapped public-evidence coverage through age
        {" "}{candidateCoverage.target_age_max}. The top-0.001% calibration remains
        methodology-review pending until its exact-age field gates are independently audited.
      </p>
    </div>
    <div class="coverage-ladder coverage-funnel-route">
      <article>
        <span>01 · Discovered universe</span>
        <strong>{candidateCoverage.total_candidates.toLocaleString()}</strong>
        <h3>Unique candidate identities</h3>
        <p>Deduplicated across the published corpus and four broad research queues.</p>
      </article>
      <article class="coverage-ladder-pending">
        <span>02 · Research backlog</span>
        <strong>{candidateCoverage.queued_backlog.toLocaleString()}</strong>
        <h3>Awaiting publication decisions</h3>
        <p>Queued, researched, or eligible candidates that are not yet published.</p>
      </article>
      <article class="coverage-ladder-done">
        <span>03 · Published evidence</span>
        <strong>{candidateCoverage.lifecycle.published.toLocaleString()}</strong>
        <h3>Evidence-gated paths</h3>
        <p>No qualifying person is downsampled to preserve a target record count.</p>
      </article>
      <article class={candidateCoverage.gold_set.passed === candidateCoverage.gold_set.total ? "coverage-ladder-done" : "coverage-ladder-pending"}>
        <span>04 · Recall backtest</span>
        <strong>{candidateCoverage.gold_set.passed}/{candidateCoverage.gold_set.total}</strong>
        <h3>Known outliers recovered</h3>
        <p>A five-person sentinel check, including Neil Movva—not a population recall estimate.</p>
      </article>
    </div>
    <dl class="coverage-state-key" aria-label="Coverage state definitions">
      <div>
        <dt>Candidate</dt>
        <dd>A discovered identity with source provenance, before an eligibility decision.</dd>
      </div>
      <div>
        <dt>Published</dt>
        <dd>A dated age-relative milestone supported by independently useful evidence.</dd>
      </div>
      <div>
        <dt>Indexable</dt>
        <dd>A published profile that also clears the stricter search-evidence gate.</dd>
      </div>
      <div>
        <dt>Audited</dt>
        <dd>A profile whose listed source links were checked in the latest reachability pass.</dd>
      </div>
    </dl>
    <div class="composition-grid">
      <article>
        <h3>Source freshness</h3>
        <div class="composition-bars">
          {candidateCoverage.sources.map((source) => (
            <div class="composition-row">
              <div>
                <span>{source.label}</span>
                <strong>{source.candidates.toLocaleString()} · {source.stale ? "stale" : `${source.age_days}d old`}</strong>
              </div>
            </div>
          ))}
        </div>
      </article>
      <article>
        <h3>Known lifecycle states</h3>
        <div class="composition-bars">
          {lifecycleStates.map((state) => (
            <div class="composition-row">
              <div>
                <span>{state}</span>
                <strong>{candidateCoverage.lifecycle[state].toLocaleString()}</strong>
              </div>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section class="coverage-section" aria-labelledby="coverage-ladder-heading">
    <div class="coverage-section-heading">
      <div>
        <p class="eyebrow">Four different claims</p>
        <h2 id="coverage-ladder-heading">Coverage is a ladder—not one percentage.</h2>
      </div>
      <p>
        A filled field is not a verified fact. A listed source is not an
        independent audit. The product keeps those levels separate.
      </p>
    </div>
    <div class="coverage-ladder">
      <article>
        <span>01 · Record structure</span>
        <strong>{formatShare(coverage.narrativeComplete.share)}</strong>
        <h3>Narrative fields present</h3>
        <p>Milestone, early history, family context, evidence summary, and current position.</p>
      </article>
      <article>
        <span>02 · Source diversity</span>
        <strong>{formatShare(coverage.twoDistinctSourceDomains.share)}</strong>
        <h3>Two source domains</h3>
        <p>{coverage.twoDistinctSourceDomains.count.toLocaleString()} profiles link evidence across at least two domains.</p>
      </article>
      <article>
        <span>03 · Publication gate</span>
        <strong>{formatShare(coverage.indexable.share)}</strong>
        <h3>Indexable evidence</h3>
        <p>Two sources, non-low leverage confidence, a milestone, and a trajectory.</p>
      </article>
      <article class={auditComplete ? "coverage-ladder-done" : undefined}>
        <span>04 · External verification</span>
        <strong>{formatShare(coverage.independentlyAudited.share)}</strong>
        <h3>Source reachability verified</h3>
        <p>
          Source URLs have been fetched and verified reachable on
          {" "}{coverage.auditReviewed.count.toLocaleString()} audited paths.
          {auditComplete
            ? " Content verification and user comprehension remain pending."
            : ` ${coverage.auditPending.count.toLocaleString()} newer paths are not yet audited. Content verification and user comprehension remain pending.`}
        </p>
      </article>
    </div>
  </section>

  <section class="coverage-section" aria-labelledby="confidence-heading">
    <div class="coverage-section-heading">
      <div>
        <p class="eyebrow">Annotation confidence</p>
        <h2 id="confidence-heading">The weaker layer is documented starting advantage.</h2>
      </div>
      <p>
        Biographies reliably celebrate output. They are much less consistent about
        money, introductions, family logistics, private coaching, permission, and
        social capital.
      </p>
    </div>
    <div class="confidence-comparison">
      {[
        {
          label: "Starting-advantage evidence",
          note: "What access or conditions were documented near the beginning?",
          bands: coverage.advantageConfidence,
          className: "advantage-confidence",
        },
        {
          label: "Built-leverage evidence",
          note: "What multiplying capacity was documented later in the path?",
          bands: coverage.leverageConfidence,
          className: "leverage-confidence",
        },
      ].map((group) => (
        <article class={group.className}>
          <h3>{group.label}</h3>
          <p>{group.note}</p>
          <div class="confidence-bars">
            {group.bands.map((band) => (
              <div class={`confidence-bar confidence-${band.label.toLowerCase()}`}>
                <div>
                  <span>{band.label}</span>
                  <strong>{band.count.toLocaleString()} · {formatShare(band.share)}</strong>
                </div>
                <i aria-hidden="true"><b style={`width:${band.share}%`}></b></i>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="coverage-section" aria-labelledby="composition-heading">
    <div class="coverage-section-heading">
      <div>
        <p class="eyebrow">Published composition</p>
        <h2 id="composition-heading">The published corpus sits inside a larger queue.</h2>
      </div>
      <p>
        Every published person cleared an age-relative evidence gate. These shares
        describe the published corpus; candidate and source gaps remain visible above.
      </p>
    </div>
    <div class="composition-grid">
      <article>
        <h3>Cohort share</h3>
        <div class="composition-bars">
          {coverage.cohorts.map((band) => (
            <div class="composition-row">
              <div>
                <span>{band.label}</span>
                <strong>{band.count.toLocaleString()} · {formatShare(band.share)}</strong>
              </div>
              <i aria-hidden="true"><b style={`width:${band.share}%`}></b></i>
            </div>
          ))}
        </div>
      </article>
      <article>
        <h3>Observed career tier</h3>
        <div class="composition-bars tier-composition">
          {coverage.tiers.map((band) => (
            <div class="composition-row">
              <div>
                <span>{band.label}</span>
                <strong>{band.count.toLocaleString()} · {formatShare(band.share)}</strong>
              </div>
              <i aria-hidden="true"><b style={`width:${band.share}%`}></b></i>
            </div>
          ))}
        </div>
        <p class="composition-note">
          Tiers summarize documented career recognition. They do not measure
          human worth, potential, or only the selected early milestone.
        </p>
      </article>
    </div>
  </section>

  <section class="coverage-boundary" aria-labelledby="boundary-heading">
    <div>
      <p class="eyebrow">The denominator that remains unobservable</p>
      <h2 id="boundary-heading">
        This project cannot count every promising path that disappeared.
      </h2>
      <p>
        There is no matched group of ordinary attempts, near-misses, or people
        with similar backgrounds who never reached a documented milestone.
        Therefore this dataset cannot estimate success probabilities, causal
        effects, or “how many failed for every Bill Gates.”
      </p>
    </div>
    <div class="boundary-ledger">
      <article>
        <span>Observed</span>
        <strong>{candidateCoverage.total_candidates.toLocaleString()} candidates; {coverage.total.toLocaleString()} published</strong>
      </article>
      <article>
        <span>Not observed</span>
        <strong>Comparable attempts and near-misses</strong>
      </article>
      <article>
        <span>Valid conclusion</span>
        <strong>Descriptive patterns and path differences</strong>
      </article>
      <article>
        <span>Invalid conclusion</span>
        <strong>Personal odds or a causal success formula</strong>
      </article>
    </div>
  </section>

  <section class="coverage-roadmap" aria-labelledby="roadmap-heading">
    <p class="eyebrow">What would earn an audited v1.0</p>
    <h2 id="roadmap-heading">{auditComplete ? "Two gates done. Two remain." : "One gate done. Three remain."}</h2>
    <ol>
      <li class="coverage-roadmap-done">
        <span>01</span>
        <div><strong>Double-code a stratified sample.</strong><p>Completed 2026-07-31 across every populated cohort and career tier. Tier agreement was 0.723; leverage scores matched exactly 33.8% of the time and landed within one point 91.9% of the time.</p></div>
      </li>
      <li class={auditComplete ? "coverage-roadmap-done" : undefined}>
        <span>02</span>
        <div><strong>Audit source reachability.</strong><p>
          Last pass {coverage.auditDate || "2026-08-08"}, covering
          {" "}{coverage.auditedSourceUrls.toLocaleString()} source URLs across
          {" "}{coverage.auditReviewed.count.toLocaleString()} of {coverage.total.toLocaleString()} paths.
          {" "}{coverage.independentlyAudited.count.toLocaleString()} paths have every source reachable.
          {!auditComplete
            && ` ${coverage.auditPending.count.toLocaleString()} paths added since that pass are still unaudited, so this gate is not closed.`}
        </p></div>
      </li>
      <li>
        <span>03</span>
        <div><strong>Observe first-time readers.</strong><p>Test comprehension and the intended emotional arc without coaching. Requires external participants.</p></div>
      </li>
      <li>
        <span>04</span>
        <div><strong>Add a matched comparison study.</strong><p>Only then could population odds or counterfactual claims be investigated.</p></div>
      </li>
    </ol>
    <div class="coverage-actions">
      <a class="btn-link btn-link-primary" href="/explore/">Inspect the published paths</a>
      <a class="hero-secondary-link" href="/methodology/">Read the full methodology →</a>
    </div>
    <p class="coverage-release">
      <span>The release</span>
      <strong>Look sideways for information. Never turn another path into a verdict on your own.</strong>
    </p>
  </section>
</Base>
