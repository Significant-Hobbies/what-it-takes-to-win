---
import Base from "../../layouts/Base.astro";
import peopleData from "../../data/people.json";
import { getConditionFactors, type OutcomePerson } from "../../lib/outcome-model";
import { getReachBand } from "../../lib/journey-model";

const people = peopleData as OutcomePerson[];
const featuredIds = [
  "bill-gates",
  "bonnie-tyler",
  "sudha-murty",
  "mark-webber",
  "guillermo-rauch",
  "ben-goodger",
];
const featured = featuredIds
  .map((id) => people.find((person) => person.person_id === id))
  .filter((person): person is OutcomePerson => Boolean(person));
---

<Base
  title="Break a Comparison — Look Sideways"
  description="Choose a documented path and see why shared visible ingredients cannot reproduce another person's outcome."
>
  <section class="hero insight-hero">
    <p class="eyebrow">A secondary evidence exercise</p>
    <h1>Break a comparison.</h1>
    <p class="lede">
      Choose a path. Hold its three sources of advantage, perseverance, sequence, and luck apart.
      The exercise ends when the identity comparison no longer survives.
    </p>
  </section>

  <div class="insight-callout" data-clarity-contract="comparison-redundancy">
    <strong>Why the comparison eventually becomes redundant:</strong>
    {" "}two people can share totals while differing in composition, provenance, timing, encounters,
    and the order in which opportunities arrived. A matching profile is not a matching path.
  </div>

  <section aria-labelledby="choose-person-heading">
    <div class="section-heading" style="margin-top:0;">
      <p class="eyebrow">Start with a familiar path</p>
      <h2 id="choose-person-heading">Choose a person</h2>
      <p>The set deliberately mixes extreme public outliers with broader professionally distinctive paths.</p>
    </div>
    <div class="person-grid">
      {featured.map((person) => (
        <a class="person-card next-person-card" href={`/am-i-the-next/${person.person_id}/`}>
          <div class="name">Break the {person.name} comparison</div>
          <div class="cat">{person.cohort_group} · {getReachBand(person).label}</div>
          <div class="milestone">{person.milestone_by_age_26}</div>
          <div class="path-record-meta">
            {getConditionFactors(person).map((factor) => (
              <span><b>{factor.label}</b>{factor.assessed ? factor.bandLabel : "Not assessed"}</span>
            ))}
          </div>
          <span class="card-link">See where the analogy fails →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="grid grid-2 interpretation-grid" aria-label="How to use the comparison">
    <article class="card">
      <h3>What the result can reveal</h3>
      <ul class="clean-list">
        <li>What the person brought.</li>
        <li>What they were handed.</li>
        <li>What surrounded them.</li>
        <li>Where repeated work and unchosen openings appear.</li>
      </ul>
    </article>
    <article class="card">
      <h3>What no comparison can reveal</h3>
      <ul class="clean-list">
        <li>The probability that you will reproduce another person’s outcome.</li>
        <li>Unobserved luck, gatekeepers, shocks, and alternative failed paths.</li>
        <li>A future tier, identity, ceiling, or measure of human worth.</li>
        <li>What would have happened under a different sequence of events.</li>
      </ul>
    </article>
  </section>

  <section class="closing-cta">
    <p class="eyebrow">All {people.length.toLocaleString()} paths</p>
    <h2>Looking for someone else?</h2>
    <p>Search the full dataset and inspect a path through the same three-source model.</p>
    <a class="btn-link btn-link-primary" href="/explore/">Find a person →</a>
  </section>
</Base>
