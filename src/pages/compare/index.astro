---
import Base from "../../layouts/Base.astro";
import peopleData from "../../data/people.json";
import { getAdvantageTotal, type OutcomePerson } from "../../lib/outcome-model";

const people = peopleData as OutcomePerson[];
const featuredIds = [
  "bill-gates",
  "mark-zuckerberg",
  "vitalik-buterin",
  "billie-eilish",
  "cristiano-ronaldo",
  "roger-federer",
  "yo-yo-ma",
  "madonna",
  "grigori-perelman",
  "nadia-comaneci",
  "ayrton-senna",
  "celine-dion",
];
const featured = featuredIds
  .map((id) => people.find((person) => person.person_id === id))
  .filter((person): person is OutcomePerson => Boolean(person));
---

<Base
  title="Am I the Next…? Choose a Path"
  description="Choose a notable person, compare the visible ingredients of your paths, and see exactly why resemblance is not destiny."
>
  <section class="hero insight-hero">
    <p class="eyebrow">Comparison is the doorway—not the answer</p>
    <h1>Who do you think you might be the next?</h1>
    <p class="lede">
      Pick a person and compare the visible ingredients: starting position, later leverage, where
      that leverage came from, sequence, and luck. The result measures surface resemblance. It does
      not predict their outcome for you.
    </p>
  </section>

  <div class="insight-callout" data-clarity-contract="comparison-redundancy">
    <strong>Why the comparison eventually becomes redundant:</strong>
    {" "}two people can share totals while differing in composition, provenance, timing, encounters,
    and the order in which opportunities arrived. A matching profile is not a matching path.
  </div>

  <section aria-labelledby="choose-person-heading">
    <div class="section-heading" style="margin-top:0;">
      <p class="eyebrow">Start with a familiar path</p>
      <h2 id="choose-person-heading">Choose a person</h2>
      <p>Each questionnaire uses that person’s strongest documented signals, not a generic success quiz.</p>
    </div>
    <div class="person-grid">
      {featured.map((person) => (
        <a class="person-card next-person-card" href={`/am-i-the-next/${person.person_id}/`}>
          <div class="name">Am I the next {person.name}?</div>
          <div class="cat">{person.cohort_group} · milestone at {person.age_at_milestone}</div>
          <div class="milestone">{person.milestone_by_age_26}</div>
          <div class="scores">
            <span class="score-pill advantage-pill">
              Start <strong>{getAdvantageTotal(person)}/24</strong>
            </span>
            <span class="score-pill leverage-pill">
              Leverage <strong>{person.total_leverage_score}/25</strong>
            </span>
          </div>
          <span class="card-link">Compare visible ingredients →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="grid grid-2 interpretation-grid" aria-label="How to use the comparison">
    <article class="card">
      <h3>What the result can reveal</h3>
      <ul class="clean-list">
        <li>Which documented starting conditions overlap.</li>
        <li>Which multiplying capabilities are present in both paths.</li>
        <li>Whether similar leverage appears to come from different origins.</li>
        <li>Where your next buildable gap may be.</li>
      </ul>
    </article>
    <article class="card">
      <h3>What no comparison can reveal</h3>
      <ul class="clean-list">
        <li>The probability that you will reproduce another person’s outcome.</li>
        <li>Unobserved luck, gatekeepers, shocks, and alternative failed paths.</li>
        <li>A future tier, identity, ceiling, or measure of human worth.</li>
        <li>What would have happened under a different sequence of events.</li>
      </ul>
    </article>
  </section>

  <section class="closing-cta">
    <p class="eyebrow">All {people.length.toLocaleString()} paths</p>
    <h2>Looking for someone else?</h2>
    <p>Search the full dataset, open their profile, then use the person-specific comparison.</p>
    <a class="btn-link btn-link-primary" href="/explore/">Find a person →</a>
  </section>
</Base>
