---
import Base from "../../layouts/Base.astro";

interface EssayFrontmatter {
  title: string;
  subtitle?: string;
  description: string;
  date: string;
  readingMinutes: number;
}

const essays = Object.entries(
  import.meta.glob<{ frontmatter: EssayFrontmatter }>("./*.md", {
    eager: true,
  }),
)
  .map(([file, mod]) => ({
    href: `/essays/${file.replace(/^\.\//, "").replace(/\.md$/, "")}/`,
    title: mod.frontmatter.title,
    subtitle: mod.frontmatter.subtitle,
    date: mod.frontmatter.date,
    readingMinutes: mod.frontmatter.readingMinutes,
    description: mod.frontmatter.description,
  }))
  .sort(
    (a, b) => b.date.localeCompare(a.date) || a.title.localeCompare(b.title),
  );

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<Base
  title="Essays — Look Sideways"
  description="Long-form arguments supporting the journey through comparison, advantage, perseverance, luck, and bounded agency."
  canonicalPath="/essays/"
  mainClass="essays-main"
>
  <section class="hero essays-hero">
    <p class="eyebrow">Writing</p>
    <h1>Essays</h1>
    <p class="lede">
      Read these after the guided journey when you want the argument in full:
      comparison, privilege, luck, perseverance, and bounded agency.
    </p>
    <p class="essays-edition">Edition 01 · {essays.length} published pieces</p>
  </section>

  <section class="essays-index" aria-labelledby="essays-index-heading">
    <header class="essays-index-heading">
      <p class="eyebrow">Reading room</p>
      <h2 id="essays-index-heading">Arguments behind the journey</h2>
    </header>
    <ol class="essay-list">
    {
      essays.map((essay, index) => (
        <li>
          <article class="essay-card">
            <p class="essay-card-index">{String(index + 1).padStart(2, "0")}</p>
            <div class="essay-card-copy">
              <p class="essay-card-meta">
                <time datetime={essay.date}>{formatDate(essay.date)}</time>
                <span>·</span>
                <span>{essay.readingMinutes} min read</span>
              </p>
              <h3>
                <a href={essay.href}>{essay.title}</a>
              </h3>
              {essay.subtitle && <p class="essay-card-subtitle">{essay.subtitle}</p>}
              <p class="essay-card-desc">{essay.description}</p>
            </div>
            <a class="essay-card-link" href={essay.href} aria-label={`Read ${essay.title}`}>
              <span>Read essay</span>
              <span aria-hidden="true">↗</span>
            </a>
          </article>
        </li>
      ))
    }
    </ol>
  </section>
</Base>
