---
import Base from "../../layouts/Base.astro";

const essays = [
  {
    href: "/essays/everyone-has-lost-their-marbles/",
    title: "Everyone Has Lost Their Marbles",
    subtitle:
      "Trajectories, comparison, and the bounded agency that actually runs a life.",
    date: "2026-08-18",
    readingMinutes: 8,
    description:
      "Comparison as judgment is logically broken — it removes nearly every cause that produced the result, keeps only the visible score, and then pretends the score explains something. It does not.",
  },
  {
    href: "/essays/who-filled-the-kings-jug/",
    title: "Who Filled the King's Jug?",
    subtitle:
      "Privilege, abstraction, and the invisible work behind accomplishment.",
    date: "2026-08-08",
    readingMinutes: 6,
    description:
      "Privilege is having more of life prepared for you in advance — a private, high-level interface to the world that lets some people begin near the final step.",
  },
];

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<Base
  title="Essays — Look Sideways"
  description="Long-form essays on advantage, abstraction, and the invisible infrastructure of achievement."
  canonicalPath="/essays/"
  mainClass="essays-main"
>
  <section class="hero essays-hero">
    <p class="eyebrow">Writing</p>
    <h1>Essays</h1>
    <p class="lede">
      Long-form pieces that sit alongside the dataset — on advantage, abstraction,
      and the invisible infrastructure of achievement.
    </p>
    <p class="essays-edition">Edition 01 · {essays.length} published pieces</p>
  </section>

  <section class="essays-index" aria-labelledby="essays-index-heading">
    <header class="essays-index-heading">
      <p class="eyebrow">Reading room</p>
      <h2 id="essays-index-heading">Arguments behind the atlas</h2>
    </header>
    <ol class="essay-list">
    {
      essays.map((essay, index) => (
        <li>
          <article class="essay-card">
            <p class="essay-card-index">{String(index + 1).padStart(2, "0")}</p>
            <div class="essay-card-copy">
              <p class="essay-card-meta">
                <time datetime={essay.date}>{formatDate(essay.date)}</time>
                <span>·</span>
                <span>{essay.readingMinutes} min read</span>
              </p>
              <h3>
                <a href={essay.href}>{essay.title}</a>
              </h3>
              <p class="essay-card-subtitle">{essay.subtitle}</p>
              <p class="essay-card-desc">{essay.description}</p>
            </div>
            <a class="essay-card-link" href={essay.href} aria-label={`Read ${essay.title}`}>
              <span>Read essay</span>
              <span aria-hidden="true">↗</span>
            </a>
          </article>
        </li>
      ))
    }
    </ol>
  </section>
</Base>
