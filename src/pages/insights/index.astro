---
import Base from "../../layouts/Base.astro";
import peopleData from "../../data/people.json";
import "../../styles/insights.css";
import {
  ADVANTAGE_FIELDS,
  CONDITION_FACTORS,
  LEVERAGE_FIELDS,
  LEVERAGE_ORIGINS,
  LUCK_FORMS,
  OUTCOME_STAGES,
  SCORE_FAMILIES,
  getAdvantageTotal,
  getConditionFactorCoverage,
  getConditionFactors,
  getPathCounterexamples,
  summarizeOutcomes,
  type OutcomePerson,
  type ScoreField,
} from "../../lib/outcome-model";
import { summarizeReachBands } from "../../lib/journey-model";

const people = peopleData as OutcomePerson[];
const summary = summarizeOutcomes(people);
const conditionCoverage = getConditionFactorCoverage(people);
const reachBands = summarizeReachBands(people);
const broaderBand = reachBands.find((band) => band.key === "professionally-distinctive")!;
const counterexamples = getPathCounterexamples(people);
const tierOne = people.filter((person) => person.success_tier === 1);
const tierFour = people.filter((person) => person.success_tier === 4);

function fieldMean(group: OutcomePerson[], field: ScoreField) {
  return group.length
    ? group.reduce((sum, person) => sum + Number(person[field.key] || 0), 0) / group.length
    : 0;
}

const strongestObservedDifferences = [...ADVANTAGE_FIELDS, ...LEVERAGE_FIELDS]
  .map((field) => ({
    ...field,
    tierOneMean: fieldMean(tierOne, field),
    tierFourMean: fieldMean(tierFour, field),
    difference: fieldMean(tierOne, field) - fieldMean(tierFour, field),
    layer: ADVANTAGE_FIELDS.some((candidate) => candidate.key === field.key)
      ? "Starting advantage"
      : "Built / converted leverage",
  }))
  .sort((a, b) => (b.difference / b.max) - (a.difference / a.max))
  .slice(0, 8);

function summarizeFieldFrequency(field: ScoreField, layer: "advantage" | "leverage") {
  const documentedCount = people.filter((person) => Number(person[field.key] || 0) > 0).length;
  return {
    ...field,
    layer,
    documentedCount,
    share: people.length ? (documentedCount / people.length) * 100 : 0,
  };
}

const advantageFrequencies = ADVANTAGE_FIELDS
  .map((field) => summarizeFieldFrequency(field, "advantage"))
  .sort((a, b) => a.share - b.share);
const leverageFrequencies = LEVERAGE_FIELDS
  .map((field) => summarizeFieldFrequency(field, "leverage"))
  .sort((a, b) => a.share - b.share);
const allFieldFrequencies = [...advantageFrequencies, ...leverageFrequencies]
  .sort((a, b) => a.share - b.share);
const rarestDocumentedField = allFieldFrequencies[0];
const mostCommonDocumentedField = allFieldFrequencies.at(-1)!;
const rarestFieldLayerLabel = rarestDocumentedField.layer === "advantage"
  ? "Starting advantage"
  : "Built or converted leverage";
const rarityCells = Array.from({ length: 100 }, (_, index) =>
  index < Math.round(rarestDocumentedField.share)
);

const TIER_OFFSETS: Record<number, [number, number]> = {
  1: [-0.16, 0.16],
  2: [0.16, 0.16],
  3: [-0.16, -0.16],
  4: [0.16, -0.16],
};
const TIER_COLORS: Record<number, string> = {
  1: "#879cff",
  2: "#77cdb8",
  3: "#d5af68",
  4: "#8f98aa",
};
const overlapBuckets = new Map<string, {
  tier: number;
  advantage: number;
  leverage: number;
  count: number;
}>();
const scoreCellTiers = new Map<string, Set<number>>();
const scoreCellCounts = new Map<string, number>();

for (const person of people) {
  const advantage = getAdvantageTotal(person);
  const leverage = Number(person.total_leverage_score || 0);
  const tier = Number(person.success_tier);
  const cellKey = `${advantage}|${leverage}`;
  const bucketKey = `${tier}|${cellKey}`;
  const cellTiers = scoreCellTiers.get(cellKey) ?? new Set<number>();
  cellTiers.add(tier);
  scoreCellTiers.set(cellKey, cellTiers);
  scoreCellCounts.set(cellKey, (scoreCellCounts.get(cellKey) ?? 0) + 1);
  const bucket = overlapBuckets.get(bucketKey);
  if (bucket) {
    bucket.count += 1;
  } else {
    overlapBuckets.set(bucketKey, { tier, advantage, leverage, count: 1 });
  }
}

const occupiedScoreCellCount = scoreCellTiers.size;
const multiTierScoreCellCount = [...scoreCellTiers.values()]
  .filter((tiers) => tiers.size > 1).length;
const allTierScoreCellCount = [...scoreCellTiers.values()]
  .filter((tiers) => tiers.size === 4).length;
const overlapChartData = {
  cells: [...scoreCellTiers.entries()].map(([cellKey, tiers]) => {
    const [advantage, leverage] = cellKey.split("|").map(Number);
    return {
      value: [advantage, leverage, tiers.size, scoreCellCounts.get(cellKey) ?? 0],
      advantage,
      leverage,
      tierCount: tiers.size,
      count: scoreCellCounts.get(cellKey) ?? 0,
    };
  }),
  series: summary.tiers.map((tier) => {
    const offset = TIER_OFFSETS[tier.tier] ?? [0, 0];
    return {
      tier: tier.tier,
      name: `T${tier.tier}`,
      label: tier.name,
      color: TIER_COLORS[tier.tier],
      data: [...overlapBuckets.values()]
        .filter((bucket) => bucket.tier === tier.tier)
        .map((bucket) => ({
          value: [
            bucket.advantage + offset[0],
            bucket.leverage + offset[1],
            bucket.count,
          ],
          advantage: bucket.advantage,
          leverage: bucket.leverage,
          count: bucket.count,
        })),
    };
  }),
};
---

<Base
  title="Evidence Room — Look Sideways"
  description="Evidence for why comparison breaks: what people brought, what they were handed, what surrounded them, perseverance, luck, and divergent outcomes."
>
  <section class="hero insight-hero">
    <p class="eyebrow">The evidence room</p>
    <h1>Keep asking the same three questions.</h1>
    <p class="lede">
      What did they bring? What were they handed? What surrounded them? Then inspect the repeated
      work, sequence, and unchosen openings. Evidence can explain a path without turning it into your forecast.
    </p>
    <div class="hero-actions">
      <a class="btn-link btn-link-primary" href="#broader-success">See the broader success band</a>
      <a class="btn-link" href="/explore/">Study individual paths</a>
    </div>
  </section>

  <div class="insight-callout" data-clarity-contract="central-finding">
    <strong>The clearest finding:</strong>
    {" "}similar visible conditions repeatedly lead to different outcomes. The differences live in
    provenance, perseverance, sequence, luck, missing controls, and facts a biography never records.
  </div>

  <section class="minute-answer" aria-labelledby="minute-answer-heading" data-clarity-contract="one-minute-answer">
    <p class="eyebrow">The model in one minute</p>
    <h2 id="minute-answer-heading">Three sources. Two forces. No formula.</h2>
    <div class="minute-answer-grid">
      {CONDITION_FACTORS.map((factor) => {
        const coverage = conditionCoverage.find((entry) => entry.key === factor.key)!;
        return (
          <div>
            <strong>{factor.label}</strong>
            <p>{factor.question} Assessed on {coverage.assessed.toLocaleString()} paths and never summed with the other layers.</p>
          </div>
        );
      })}
      <div>
        <strong>Perseverance changes what happens next.</strong>
        <p>Repeated work, retries, recovery, and sustained practice are shown only when sources document them. Silence is not scored.</p>
      </div>
      <div>
        <strong>Luck acts across every arrow.</strong>
        <p>Era, encounters, shocks, gatekeepers, and outcome variance can redirect similar visible paths. They stay visible and unscored.</p>
      </div>
    </div>
    <p class="minute-conclusion">
      <strong>Therefore:</strong>{" "}compare mechanisms for information, never identities for a verdict.
      The same layers do not arrive in the same order, receive the same repetition, or meet the same luck.
    </p>
  </section>

  <section id="broader-success" aria-labelledby="broader-success-heading">
    <div class="section-heading">
      <p class="eyebrow">Beyond the 0.001%-style stories</p>
      <h2 id="broader-success-heading">The archive already reaches toward broader professional distinction.</h2>
      <p>
        {broaderBand.count.toLocaleString()} paths—{broaderBand.share}% of the archive—are domain-recognized
        or specialist-known rather than global icons. That is the first expansion toward the kind of success
        people informally call the top 0.1%. It is not presented as a population percentile without a field denominator.
      </p>
    </div>
    <div class="distribution-headline reach-band-ledger">
      {reachBands.map((band) => (
        <article>
          <span>{band.label}</span>
          <strong>{band.count.toLocaleString()}</strong>
          <small>{band.share}% of this purposeful archive</small>
        </article>
      ))}
    </div>
  </section>

  <details class="research-detail">
    <summary>Open the legacy 22-field annotation detail</summary>
  <section aria-labelledby="score-family-heading" data-clarity-contract="score-family-distinction">
    <div class="section-heading">
      <p class="eyebrow">Deeper research detail</p>
      <h2 id="score-family-heading">A head start and a multiplying capability are not the same thing</h2>
      <p>
        The first score describes documented position near the beginning. The second describes
        capacity later present in the path. One may help produce the other, but neither total tells
        us exactly how that conversion happened.
      </p>
    </div>
    <div class="score-family-grid">
      <article class="score-family-card advantage-family">
        <div class="score-family-kicker">Before substantial personal proof</div>
        <h3>{SCORE_FAMILIES.advantage.label}</h3>
        <div class="score-family-value">0–{SCORE_FAMILIES.advantage.max}<span>across 12 conditions</span></div>
        <p>{SCORE_FAMILIES.advantage.definition}</p>
        <strong>{SCORE_FAMILIES.advantage.boundary}</strong>
      </article>
      <article class="score-family-card leverage-family">
        <div class="score-family-kicker">Capacity later present in the path</div>
        <h3>{SCORE_FAMILIES.leverage.label}</h3>
        <div class="score-family-value">0–{SCORE_FAMILIES.leverage.max}<span>across 10 levers</span></div>
        <p>{SCORE_FAMILIES.leverage.definition}</p>
        <strong>{SCORE_FAMILIES.leverage.boundary}</strong>
      </article>
    </div>
    <div class="provenance-note">
      <strong>Five possible origins of leverage</strong>
      {LEVERAGE_ORIGINS.map((origin) => <span><b>{origin.label}</b> — {origin.summary}</span>)}
      <p>Person pages now infer a best-supported origin for every non-zero lever, show the linked evidence, state confidence, and preserve “unresolved” when the biography cannot tell us.</p>
    </div>
  </section>
  </details>

  <details class="research-detail">
    <summary>Open the legacy ingredient-frequency atlas</summary>
  <section class="trait-atlas" aria-labelledby="trait-atlas-heading">
    <div class="section-heading trait-atlas-heading">
      <p class="eyebrow">Evidence frequency atlas · {people.length.toLocaleString()} paths</p>
      <h2 id="trait-atlas-heading">Which scored ingredients are least often documented?</h2>
      <p>
        This measures reviewed-source documentation in a curated notable-outcomes sample—not how
        common a trait is among successful people or the wider population. Each bar uses the same denominator.
      </p>
    </div>

    <figure class="rarity-feature" aria-labelledby="rarity-feature-title">
      <div class="rarity-feature-copy">
        <span
          class:list={[
            "trait-layer",
            rarestDocumentedField.layer === "advantage"
              ? "trait-layer-advantage"
              : "trait-layer-leverage",
          ]}
        >
          {rarestFieldLayerLabel}
        </span>
        <h3 id="rarity-feature-title">{rarestDocumentedField.label} is the least frequently documented scored ingredient.</h3>
        <div class="rarity-measure">
          <strong>{rarestDocumentedField.documentedCount.toLocaleString()}</strong>
          <span>of {people.length.toLocaleString()} profiles</span>
        </div>
        <p>
          {rarestDocumentedField.share.toFixed(1)}% of this curated sample has clear reviewed-source
          documentation strong enough for a non-zero score.
        </p>
      </div>
      <div class="rarity-matrix-wrap">
        <div class="rarity-matrix" aria-hidden="true">
          {rarityCells.map((isDocumented) => (
            <span class:list={{ "is-documented": isDocumented }}></span>
          ))}
        </div>
        <figcaption>Each square represents about 1% of the selected dataset.</figcaption>
      </div>
    </figure>

    <div class="frequency-panels">
      <figure class="frequency-panel frequency-panel-advantage">
        <figcaption>
          <span>12 documented starting conditions</span>
          <strong>Starting advantage</strong>
        </figcaption>
        <ol class="frequency-list frequency-list-lead">
          {advantageFrequencies.slice(0, 4).map((field) => (
            <li>
              <div class="frequency-row-label">
                <span>{field.label}</span>
                <strong>{field.documentedCount.toLocaleString()} <small>{field.share.toFixed(1)}%</small></strong>
              </div>
              <div class="frequency-track" aria-hidden="true">
                <span style={`width:${field.share.toFixed(2)}%`}></span>
              </div>
            </li>
          ))}
        </ol>
        <details class="frequency-more" open data-mobile-collapse>
          <summary>{advantageFrequencies.length - 4} additional starting conditions</summary>
          <ol class="frequency-list">
            {advantageFrequencies.slice(4).map((field) => (
              <li>
                <div class="frequency-row-label">
                  <span>{field.label}</span>
                  <strong>{field.documentedCount.toLocaleString()} <small>{field.share.toFixed(1)}%</small></strong>
                </div>
                <div class="frequency-track" aria-hidden="true">
                  <span style={`width:${field.share.toFixed(2)}%`}></span>
                </div>
              </li>
            ))}
          </ol>
        </details>
      </figure>

      <figure class="frequency-panel frequency-panel-leverage">
        <figcaption>
          <span>10 multiplying capabilities</span>
          <strong>Built or converted leverage</strong>
        </figcaption>
        <ol class="frequency-list frequency-list-lead">
          {leverageFrequencies.slice(0, 4).map((field) => (
            <li>
              <div class="frequency-row-label">
                <span>{field.label}</span>
                <strong>{field.documentedCount.toLocaleString()} <small>{field.share.toFixed(1)}%</small></strong>
              </div>
              <div class="frequency-track" aria-hidden="true">
                <span style={`width:${field.share.toFixed(2)}%`}></span>
              </div>
            </li>
          ))}
        </ol>
        <details class="frequency-more" open data-mobile-collapse>
          <summary>{leverageFrequencies.length - 4} additional multiplying capabilities</summary>
          <ol class="frequency-list">
            {leverageFrequencies.slice(4).map((field) => (
              <li>
                <div class="frequency-row-label">
                  <span>{field.label}</span>
                  <strong>{field.documentedCount.toLocaleString()} <small>{field.share.toFixed(1)}%</small></strong>
                </div>
                <div class="frequency-track" aria-hidden="true">
                  <span style={`width:${field.share.toFixed(2)}%`}></span>
                </div>
              </li>
            ))}
          </ol>
        </details>
      </figure>
    </div>

    <div class="frequency-reading">
      <strong>No ingredient is documented in every reviewed path.</strong>
      <p>
        Even {mostCommonDocumentedField.label.toLowerCase()}, the most frequently documented scored signal,
        has no clear documentation in {(people.length - mostCommonDocumentedField.documentedCount).toLocaleString()}{" "}
        profiles. Zero means “not clearly documented in reviewed sources,” not proof of absence.
      </p>
      <a href="/methodology/">Read the scoring and evidence boundary →</a>
    </div>
  </section>

  <script>
    if (window.matchMedia("(max-width: 820px)").matches) {
      document.querySelectorAll<HTMLDetailsElement>("[data-mobile-collapse]")
        .forEach((details) => details.removeAttribute("open"));
    }
  </script>
  </details>

  <section aria-labelledby="comparison-breaks-heading" data-clarity-contract="comparison-redundancy">
    <div class="section-heading">
      <p class="eyebrow">Why direct comparison becomes redundant</p>
      <h2 id="comparison-breaks-heading">A matching profile is not a matching path</h2>
      <p>
        Comparison is useful for exposing ingredients. It stops being useful when resemblance is
        mistaken for destiny. Four hidden differences prevent that leap.
      </p>
    </div>
    <div class="redundancy-grid">
      <article>
        <strong>Composition</strong>
        <p>The same total can be assembled from entirely different advantages and capabilities.</p>
      </article>
      <article>
        <strong>Origin</strong>
        <p>The same capability may be self-built, advantage-enabled, earned, external, mixed, or unresolved.</p>
      </article>
      <article>
        <strong>Sequence</strong>
        <p>Order matters: a collaborator before a product is not equivalent to one met after traction.</p>
      </article>
      <article>
        <strong>Luck and variance</strong>
        <p>Unrepeatable encounters and events can separate paths that look identical in the record.</p>
      </article>
    </div>
    <p class="minute-conclusion">
      <strong>The useful output is diagnostic, not predictive:</strong>{" "}what was present, where it
      may have come from, what is missing, and what can still be built.
    </p>
  </section>

  <section aria-labelledby="luck-heading" data-clarity-contract="luck-and-variance">
    <div class="section-heading">
      <p class="eyebrow">Luck is cross-cutting—not residual noise</p>
      <h2 id="luck-heading">Luck changes the path without becoming a score</h2>
      <p>
        This dataset only contains notable outcomes. It cannot show how many people had similar
        visible ingredients and did not break through, so assigning a “luck score” would create
        false precision.
      </p>
    </div>
    <div class="luck-grid">
      {LUCK_FORMS.map((form) => (
        <article>
          <h3>{form.label}</h3>
          <p>{form.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section
    id="distribution"
    class="distribution-context"
    aria-labelledby="distribution-heading"
    data-clarity-contract="outcome-distribution-context"
  >
    <div class="section-heading">
      <p class="eyebrow">Percentiles need a denominator</p>
      <h2 id="distribution-heading">How rare is a Bill Gates-level tier in this dataset?</h2>
      <p>
        Bill Gates is in T1: a band of {summary.tiers[0].count.toLocaleString()} global-icon
        profiles, or the top {summary.tiers[0].topBandEnd.toFixed(1)}% of this selected dataset.
        The tier does not rank people within that band.
      </p>
    </div>

    <div class="distribution-headline">
      <article>
        <span>T1 profiles</span>
        <strong>{summary.tiers[0].count.toLocaleString()}</strong>
        <small>{summary.tiers[0].share.toFixed(1)}% of the curated sample</small>
      </article>
      <article>
        <span>Lower-tier profiles</span>
        <strong>{summary.tiers[0].lowerOutcomeCount.toLocaleString()}</strong>
        <small>T2–T4 early-breakthrough paths</small>
      </article>
      <article>
        <span>Observable ratio</span>
        <strong>{summary.tiers[0].lowerPerMember.toFixed(1)}×</strong>
        <small>lower-tier paths per T1 profile</small>
      </article>
    </div>

    <div class="tier-distribution" aria-label="Outcome tier distribution in the curated dataset">
      {summary.tiers.map((tier) => (
        <div
          class={`tier-distribution-segment tier-${tier.tier}`}
          style={`flex-grow:${tier.count}`}
          title={`T${tier.tier}: ${tier.count} people, ${tier.share.toFixed(1)}%`}
        >
          <strong>T{tier.tier}</strong>
          <span>{tier.share.toFixed(1)}%</span>
        </div>
      ))}
    </div>
    <div class="tier-rank-table">
      {summary.tiers.map((tier) => (
        <div>
          <span>T{tier.tier} · {tier.name}</span>
          <strong>ranks {tier.rankStart.toLocaleString()}–{tier.rankEnd.toLocaleString()}</strong>
          <small>
            {tier.rankStart === 1
              ? `top ${tier.topBandEnd.toFixed(1)}% tier`
              : `${tier.topBandStart.toFixed(1)}–${tier.topBandEnd.toFixed(1)}% band from the top`}
          </small>
        </div>
      ))}
    </div>

    <div class="power-law-grid">
      <article>
        <p class="eyebrow">Bell-curve intuition</p>
        <h3>Most people cluster near the middle.</h3>
        <p>
          This mental model expects extremes to be rare and distances between adjacent people to
          stay fairly modest.
        </p>
      </article>
      <article>
        <p class="eyebrow">Heavy-tail intuition</p>
        <h3>A small minority can sit extremely far out.</h3>
        <p>
          In many outcome domains, recognition, reach, wealth, citations, or attention are highly
          unequal. Repeated compounding can turn modest early differences into very large outcome gaps.
        </p>
      </article>
    </div>

    <div class="power-law-boundary">
      <strong>This is the power-law lesson—not a fitted power law.</strong>
      <p>
        The four tiers compress continuous careers into editorial bands, and this dataset begins
        after an early breakthrough has already happened. We do not fit a Pareto exponent or claim
        these four tier counts form a power law. The useful idea is that extraordinary outcomes may
        live in a long tail where “a little better” in inputs does not imply “a little better” in results.
      </p>
    </div>

    <div class="denominator-wall">
      <strong>What the 3.5× ratio cannot tell you</strong>
      <p>
        It counts lower-tier paths among {people.length.toLocaleString()} selected early breakthroughs. It cannot count the
        much larger, unobserved population who attempted similar work, started later, never had a
        qualifying milestone, or remained undocumented. So it is not “3.5 people failed for every
        Bill Gates.” The true population denominator is absent.
      </p>
    </div>
  </section>

  <section aria-labelledby="counterexamples-heading" data-clarity-contract="path-counterexamples">
    <div class="section-heading">
      <p class="eyebrow">Data-backed counterexamples</p>
      <h2 id="counterexamples-heading">Similar numbers, visibly different lives</h2>
      <p>These pairs are selected deterministically from profiles that pass the comparison evidence gate.</p>
    </div>
    <div class="counterexample-stack">
      {counterexamples.map((pair) => (
        <article class="counterexample-card">
          <div class="counterexample-heading">
            <div>
              <span>{pair.sharedValue}</span>
              <h3>{pair.title}</h3>
            </div>
            <p>{pair.explanation}</p>
          </div>
          <div class="counterexample-pair">
            {[pair.first, pair.second].map((person) => (
              <a href={`/person/${person.person_id}/`}>
                <strong>{person.name}</strong>
                <span>{person.cohort_group} · T{person.success_tier}</span>
                <small>
                  {getConditionFactors(person).map((factor) => `${factor.label}: ${factor.score ?? "—"}`).join(" · ")}
                </small>
                <p>{person.milestone_by_age_26}</p>
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <details class="research-detail">
    <summary>Open the legacy four-stage research model</summary>
  <section aria-labelledby="path-heading" data-clarity-contract="four-stage-model">
    <div class="section-heading">
      <p class="eyebrow">A four-stage path</p>
      <h2 id="path-heading">How to read every story in this project</h2>
    </div>
    <div class="outcome-model">
      {OUTCOME_STAGES.map((stage) => (
        <article class={`stage-card stage-${stage.number}`}>
          <div class="stage-number">{stage.number}</div>
          <h3>{stage.name}</h3>
          <p>{stage.summary}</p>
        </article>
      ))}
    </div>
  </section>
  </details>

  <section aria-labelledby="tiers-heading" data-clarity-contract="tier-definitions">
    <div class="section-heading">
      <p class="eyebrow">The outcome ladder</p>
      <h2 id="tiers-heading">What the tiers actually mean</h2>
      <p>
        The early milestone determines who enters this dataset; the tier separately summarizes
        documented career recognition through the data cutoff. It is an editorial band, not a
        calculation from advantage or leverage scores.
      </p>
    </div>
    <div class="tier-grid">
      {summary.tiers.map((tier) => (
        <article id={`tier-${tier.tier}`} class={`tier-card tier-${tier.tier}`}>
          <div class="tier-card-top">
            <span class="tier-badge">T{tier.tier}</span>
            <span class="tier-count">{tier.count.toLocaleString()} people · {tier.share.toFixed(1)}%</span>
          </div>
          <h3>{tier.name}</h3>
          <strong>{tier.short}</strong>
          <p>{tier.description}</p>
        </article>
      ))}
    </div>
  </section>

  <details class="research-detail">
    <summary>Open the legacy score-overlap analysis</summary>
  <section aria-labelledby="gradient-heading" data-clarity-contract="gradient-and-overlap">
    <div class="section-heading">
      <p class="eyebrow">What the dataset observes</p>
      <h2 id="gradient-heading">A real gradient—and no clean dividing line</h2>
      <p>
        Averages rise as outcome significance rises. The interquartile ranges show the middle half
        of each tier, making the overlap visible rather than hiding it behind one number.
      </p>
    </div>

    <figure class="overlap-map" aria-labelledby="overlap-map-title" aria-describedby="overlap-map-caption">
      <div class="overlap-map-topline">
        <div>
          <span class="overlap-map-kicker">
            <span class="overlap-desktop-copy">Exact score cells · bubble area scales with people</span>
            <span class="overlap-mobile-copy">Exact score cells · color = tiers present</span>
          </span>
          <h3 id="overlap-map-title">Different outcomes repeatedly occupy the same score coordinates.</h3>
        </div>
        <p class="overlap-verdict">
          <strong>{multiTierScoreCellCount}<span> / {occupiedScoreCellCount}</span></strong>
          occupied score cells contain profiles from at least two tiers.
          <small>{allTierScoreCellCount} score cells contain all four tiers.</small>
        </p>
      </div>

      <div class="overlap-encoding-keys">
        <div class="overlap-tier-key" aria-label="Outcome tier color key">
          {summary.tiers.map((tier) => (
            <span class={`overlap-tier overlap-tier-${tier.tier}`}>
              <i aria-hidden="true"></i>
              <strong>T{tier.tier}</strong> {tier.name}
            </span>
          ))}
        </div>
        <div class="overlap-size-key" aria-label="Bubble area scale: 1, 10, and 40 people">
          <span>Bubble area</span>
          <i class="overlap-size-1" aria-hidden="true"></i><b>1</b>
          <i class="overlap-size-10" aria-hidden="true"></i><b>10</b>
          <i class="overlap-size-40" aria-hidden="true"></i><b>40</b>
        </div>
        <p class="overlap-mobile-reading">Each square is one occupied score cell. Brighter cells contain more outcome tiers.</p>
      </div>

      <div class="overlap-chart-shell">
        <div
          id="chart-overlap"
          class="overlap-chart"
          role="img"
          aria-label={`${multiTierScoreCellCount} of ${occupiedScoreCellCount} occupied score cells contain profiles from multiple outcome tiers. The horizontal axis is starting advantage from 0 to 24. The vertical axis is built or converted leverage from 0 to 25. A tier-level statistical summary follows in the table below.`}
        >
          <span class="overlap-chart-status">Preparing the overlap map…</span>
        </div>
        <noscript>
          <p class="overlap-chart-fallback">The interactive map needs JavaScript. A tier-level statistical summary remains available in the table below.</p>
        </noscript>
      </div>

      <figcaption id="overlap-map-caption">
        <span class="overlap-desktop-copy">Each bubble groups profiles with the same two integer totals and the same outcome tier;
        bubble area scales with the number of profiles. Tier bubbles are offset slightly around their
        exact cell so overlap stays visible. The offset is display-only, and tooltips report the true scores.</span>
        <span class="overlap-mobile-copy">Each square is one occupied exact score cell; color shows how many
        outcome tiers share it, and the tooltip reports the total profiles in that cell.</span>
        Equal totals can still hide different ingredients, sequences, evidence quality, and luck. This curated
        sample is descriptive, not population-representative.
      </figcaption>
    </figure>

    <script is:inline type="application/json" id="overlap-chart-data" set:html={JSON.stringify(overlapChartData)} />
    <script>
      async function initialiseOverlapChart() {
        const chartElement = document.getElementById("chart-overlap");
        const dataElement = document.getElementById("overlap-chart-data");
        if (!chartElement || !dataElement) return;

        try {
          const chartData = JSON.parse(dataElement.textContent || "{}");
          const { initChart } = await import("../../scripts/insight-charts.js");
          const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const mobileQuery = window.matchMedia("(max-width: 560px)");
          chartElement.textContent = "";
          chartElement.dataset.state = "ready";
          const sharedOption = {
            animationDuration: reducedMotion ? 0 : 450,
            animationEasing: "cubicOut",
            aria: {
              enabled: true,
              description: chartElement.getAttribute("aria-label"),
            },
          };
          const axisStyle = {
            axisLine: { lineStyle: { color: "#323a4d" } },
            axisTick: { show: false },
            axisLabel: { color: "#9aa3b2", fontSize: 10 },
            splitLine: { lineStyle: { color: "#1c2230" } },
          };
          const makeScatterOption = () => ({
            ...sharedOption,
            color: chartData.series.map((series) => series.color),
            tooltip: {
              trigger: "item",
              backgroundColor: "#161b27",
              borderColor: "#323a4d",
              textStyle: { color: "#e6e9ef", fontSize: 12 },
              formatter: (params) => {
                const point = params.data;
                const tier = chartData.series[params.seriesIndex];
                return [
                  `<strong>${tier.name} · ${tier.label}</strong>`,
                  `${point.count.toLocaleString()} ${point.count === 1 ? "profile" : "profiles"}`,
                  `Starting advantage: ${point.advantage} / 24`,
                  `Built/converted leverage: ${point.leverage} / 25`,
                ].join("<br>");
              },
            },
            grid: { left: 54, right: 22, top: 22, bottom: 58 },
            xAxis: {
              type: "value",
              min: 0,
              max: 24,
              interval: 4,
              name: "Starting advantage →",
              nameLocation: "middle",
              nameGap: 38,
              nameTextStyle: { color: "#9aa3b2", fontSize: 11, fontWeight: 600 },
              ...axisStyle,
            },
            yAxis: {
              type: "value",
              min: 0,
              max: 25,
              interval: 5,
              name: "Built / converted leverage →",
              nameLocation: "middle",
              nameGap: 42,
              nameTextStyle: { color: "#9aa3b2", fontSize: 11, fontWeight: 600 },
              ...axisStyle,
            },
            series: chartData.series.map((tier) => ({
              name: tier.name,
              type: "scatter",
              data: tier.data,
              symbolSize: (value) => Math.sqrt(value[2]) * 5,
              itemStyle: {
                color: tier.color,
                opacity: 0.72,
                borderColor: "#0b0d12",
                borderWidth: 1,
              },
              emphasis: {
                scale: 1.2,
                itemStyle: { opacity: 1, borderColor: "#e6e9ef" },
              },
            })),
          });
          const makeHeatmapOption = () => ({
            ...sharedOption,
            tooltip: {
              trigger: "item",
              backgroundColor: "#161b27",
              borderColor: "#323a4d",
              textStyle: { color: "#e6e9ef", fontSize: 12 },
              formatter: (params) => {
                const point = params.data;
                return [
                  `<strong>${point.tierCount} ${point.tierCount === 1 ? "tier" : "tiers"} in this score cell</strong>`,
                  `${point.count.toLocaleString()} ${point.count === 1 ? "profile" : "profiles"}`,
                  `Starting advantage: ${point.advantage} / 24`,
                  `Built/converted leverage: ${point.leverage} / 25`,
                ].join("<br>");
              },
            },
            grid: { left: 48, right: 14, top: 18, bottom: 76 },
            xAxis: {
              type: "category",
              data: Array.from({ length: 25 }, (_, value) => value),
              name: "Starting advantage →",
              nameLocation: "middle",
              nameGap: 34,
              nameTextStyle: { color: "#9aa3b2", fontSize: 11, fontWeight: 600 },
              ...axisStyle,
              axisLabel: {
                ...axisStyle.axisLabel,
                interval: 0,
                formatter: (value) => Number(value) % 4 === 0 ? value : "",
              },
            },
            yAxis: {
              type: "category",
              data: Array.from({ length: 26 }, (_, value) => value),
              name: "Built / converted leverage →",
              nameLocation: "middle",
              nameGap: 38,
              nameTextStyle: { color: "#9aa3b2", fontSize: 11, fontWeight: 600 },
              ...axisStyle,
              axisLabel: {
                ...axisStyle.axisLabel,
                interval: 0,
                formatter: (value) => Number(value) % 5 === 0 ? value : "",
              },
            },
            visualMap: {
              type: "piecewise",
              dimension: 2,
              orient: "horizontal",
              left: "center",
              bottom: 4,
              itemWidth: 18,
              itemHeight: 8,
              itemGap: 8,
              selectedMode: false,
              textStyle: { color: "#9aa3b2", fontSize: 10 },
              pieces: [
                { value: 1, label: "1 tier", color: "#283449" },
                { value: 2, label: "2", color: "#536ba0" },
                { value: 3, label: "3", color: "#77a6c8" },
                { value: 4, label: "4 tiers", color: "#9fd8c6" },
              ],
            },
            series: [{
              type: "heatmap",
              data: chartData.cells,
              itemStyle: { borderColor: "#0b0d12", borderWidth: 1 },
              emphasis: { itemStyle: { borderColor: "#e6e9ef", borderWidth: 2 } },
            }],
          });
          const chart = initChart("chart-overlap", mobileQuery.matches ? makeHeatmapOption() : makeScatterOption());
          mobileQuery.addEventListener("change", (event) => {
            chart?.setOption(event.matches ? makeHeatmapOption() : makeScatterOption(), { notMerge: true });
          });
        } catch (error) {
          chartElement.dataset.state = "error";
          chartElement.innerHTML = '<span class="overlap-chart-status">The overlap map could not load. A tier-level statistical summary remains available below.</span>';
        }
      }

      function scheduleOverlapChart() {
        const chartElement = document.getElementById("chart-overlap");
        if (!chartElement || !("IntersectionObserver" in window)) {
          initialiseOverlapChart();
          return;
        }
        const observer = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          initialiseOverlapChart();
        }, { rootMargin: "500px 0px" });
        observer.observe(chartElement);
      }

      scheduleOverlapChart();
    </script>

    <div class="grid grid-2" style="margin-bottom:20px;">
      <div class="stat">
        <div class="label">Starting advantage ↔ better tier correlation</div>
        <div class="value">{summary.advantageCorrelation.toFixed(2)}</div>
        <div class="sub">Positive, but far from deterministic</div>
      </div>
      <div class="stat">
        <div class="label">Built/converted leverage ↔ better tier correlation</div>
        <div class="value">{summary.leverageCorrelation.toFixed(2)}</div>
        <div class="sub">Positive, with substantial unexplained variation</div>
      </div>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Outcome tier</th>
            <th>People</th>
            <th>Avg starting advantage</th>
            <th>Middle 50%</th>
            <th>Avg built/converted leverage</th>
            <th>Middle 50%</th>
          </tr>
        </thead>
        <tbody>
          {summary.tiers.map((tier) => (
            <tr>
              <td><strong>T{tier.tier} · {tier.name}</strong></td>
              <td class="mono">{tier.count.toLocaleString()}</td>
              <td class="mono">{tier.advantage.mean.toFixed(1)} / 24</td>
              <td class="mono">{tier.advantage.p25}–{tier.advantage.p75}</td>
              <td class="mono">{tier.leverage.mean.toFixed(1)} / 25</td>
              <td class="mono">{tier.leverage.p25}–{tier.leverage.p75}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="warning-box" style="margin-top:16px;">
      <strong>Why the overlap matters.</strong>
      T1 advantage totals span {summary.tiers[0].advantage.min}–{summary.tiers[0].advantage.max};
      T4 spans {summary.tiers[3].advantage.min}–{summary.tiers[3].advantage.max}.
      T1 leverage spans {summary.tiers[0].leverage.min}–{summary.tiers[0].leverage.max};
      T3 spans {summary.tiers[2].leverage.min}–{summary.tiers[2].leverage.max}.
      A high score is positioning, not proof. A low score is friction, not a verdict.
    </div>
  </section>

  <section aria-labelledby="differences-heading">
    <div class="section-heading">
      <p class="eyebrow">Where the observed profiles differ most</p>
      <h2 id="differences-heading">The largest T1–T4 score gaps</h2>
      <p>
        These are descriptive differences in this successful-only sample. They are useful places to
        investigate—not estimates of what caused the outcome.
      </p>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Dimension</th>
            <th>Layer</th>
            <th>T1 average</th>
            <th>T4 average</th>
            <th>Observed gap</th>
          </tr>
        </thead>
        <tbody>
          {strongestObservedDifferences.map((field) => (
            <tr>
              <td><strong>{field.label}</strong></td>
              <td>{field.layer}</td>
              <td class="mono">{field.tierOneMean.toFixed(2)} / {field.max}</td>
              <td class="mono">{field.tierFourMean.toFixed(2)} / {field.max}</td>
              <td class="mono">+{field.difference.toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  </details>

  <section class="grid grid-2 interpretation-grid" aria-label="Interpretation boundaries">
    <article class="card">
      <h3>What this supports</h3>
      <ul class="clean-list">
        <li>Seeing which conditions repeatedly accompany early breakthroughs.</li>
        <li>Separating what a person brought, what they were handed, and what surrounded them.</li>
        <li>Seeing how perseverance, sequence, and luck redirect superficially similar paths.</li>
        <li>Finding mechanisms worth investigating without turning a person into a template.</li>
      </ul>
    </article>
    <article class="card">
      <h3>What this cannot establish</h3>
      <ul class="clean-list">
        <li>That a score caused a person’s success.</li>
        <li>That someone with the same profile will reach the same outcome.</li>
        <li>How often similarly advantaged people failed—the dataset has no control group.</li>
        <li>Whether a person’s undocumented advantage was genuinely absent.</li>
      </ul>
    </article>
  </section>

  <section aria-labelledby="clarity-check-heading" data-clarity-contract="comprehension-check">
    <div class="section-heading">
      <p class="eyebrow">Check your interpretation</p>
      <h2 id="clarity-check-heading">Six questions the project must answer clearly</h2>
      <p>If these answers are not obvious, the product has failed its clarity contract.</p>
    </div>
    <div class="clarity-questions">
      <details>
        <summary>Why is direct comparison incomplete?</summary>
        <p>Totals hide composition, provenance, sequence, and luck. Even a close person-specific match is only surface resemblance—not the probability of reproducing someone’s outcome.</p>
      </details>
      <details>
        <summary>Can I test a specific comparison?</summary>
        <p>Yes. Every published profile can be read through the same three sources, documented perseverance, sequence, and luck. The exercise dismantles the identity comparison instead of producing a resemblance score.</p>
      </details>
      <details>
        <summary>Where does luck fit?</summary>
        <p>Across every stage. Structural luck, encounters, events, and outcome variance can redirect the path. Luck remains explicit but unscored because the dataset has no failed control group and cannot recover counterfactuals.</p>
      </details>
      <details>
        <summary>Where did the visible advantages come from?</summary>
        <p>Every profile starts with the same three layers: what the person brought, what they were handed, and what surrounded them. Detailed capability provenance remains available as secondary research evidence.</p>
      </details>
      <details>
        <summary>Why do superficially similar profiles diverge?</summary>
        <p>They can share totals but differ in which ingredients compose them, how those ingredients arose, the order of events, and unobserved luck. The counterexample pairs above make that divergence concrete.</p>
      </details>
      <details>
        <summary>What percentile is this person—and how many people were far from them?</summary>
        <p>Each person page shows a qualitative reach band inside this {people.length.toLocaleString()}-path archive. It does not claim a population percentile or estimate how many similar people failed, because the relevant field denominator and failed control group are absent.</p>
      </details>
    </div>
  </section>

  <section class="closing-cta">
    <p class="eyebrow">Leave with the argument intact</p>
    <h2>Use comparison for information, not identity.</h2>
    <p>
      Inspect another path if it teaches you something. Stop when it becomes a verdict about your pace or worth.
    </p>
    <a class="btn-link btn-link-primary" href="/explore/?reach=professional">Browse broader professional paths →</a>
  </section>
