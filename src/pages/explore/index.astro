---
import Base from "../../layouts/Base.astro";
import peopleData from "../../data/people.json";

const people = peopleData;
const cohorts = [...new Set(people.map((p) => p.cohort_group).filter(Boolean))].sort();
const categories = [...new Set(people.map((p) => p.category).filter(Boolean))].sort();
---

<Base title="Explore — Look Sideways" mainClass="explore-main">
  <section class="hero explore-hero">
    <p class="eyebrow">Research atlas</p>
    <h1>Explore {people.length.toLocaleString("en-US")} people</h1>
    <p class="lede">The evidence room behind the journey. Inspect what each person brought, what they were handed, what surrounded them, and where perseverance or luck appears in the record.</p>
    <dl class="explore-contract" aria-label="Atlas interpretation contract">
      <div>
        <dt>Unit</dt>
        <dd>One person, one early milestone</dd>
      </div>
      <div>
        <dt>Use</dt>
        <dd>Inspect paths, do not rank people</dd>
      </div>
      <div>
        <dt>Boundary</dt>
        <dd>Successful-outlier corpus, no control group</dd>
      </div>
    </dl>
    <a class="explore-jump" href="#filters">Search and filter the atlas <span aria-hidden="true">↓</span></a>
  </section>

  <section class="explore-index" aria-labelledby="explore-index-heading">
    <header class="explore-index-heading">
      <div>
        <p class="eyebrow">Published index</p>
        <h2 id="explore-index-heading">Filter the atlas</h2>
      </div>
      <p id="count" role="status" aria-live="polite">Loading paths…</p>
    </header>

    <fieldset class="filters" id="filters">
      <legend class="visually-hidden">Filter published paths</legend>
      <label class="filter-field filter-field-search" for="search">
        <span>Search</span>
        <input type="search" id="search" placeholder="Name, milestone, or summary" />
      </label>
      <label class="filter-field" for="f-cohort">
        <span>Cohort</span>
        <select id="f-cohort">
          <option value="">All cohorts</option>
          {cohorts.map((c) => <option value={c}>{c}</option>)}
        </select>
      </label>
      <label class="filter-field" for="f-category">
        <span>Field</span>
        <select id="f-category">
          <option value="">All categories</option>
          {categories.map((c) => <option value={c}>{c}</option>)}
        </select>
      </label>
      <label class="filter-field" for="f-reach">
        <span>Outcome reach</span>
        <select id="f-reach">
          <option value="">All reach bands</option>
          <option value="professional">Professionally distinctive</option>
          <option value="field">Field-leading</option>
          <option value="extreme">Extreme public outlier</option>
        </select>
      </label>
      <label class="filter-field filter-field-sort" for="f-sort">
        <span>Order</span>
        <select id="f-sort">
          <option value="name">Name (A→Z)</option>
          <option value="age-asc">Milestone age (low→high)</option>
          <option value="age-desc">Milestone age (high→low)</option>
        </select>
      </label>
    </fieldset>
    <div class="filter-footer">
      <details class="filter-key">
        <summary>What do these terms mean?</summary>
        <p><strong>Outcome reach</strong> describes recognition inside the published corpus. It is not a universal percentile without a field and exact-age denominator.</p>
      </details>
      <div class="active-filter-bar">
        <span id="active-filters">No filters active</span>
        <button class="filter-reset" id="clear-filters" type="button" disabled>Clear all</button>
      </div>
    </div>
  </section>

  <div class="person-grid" id="results">
    <div class="explore-state" role="status">Loading published paths…</div>
  </div>
  <div class="results-actions" id="results-actions" hidden>
    <button class="load-more" id="load-more" type="button">Load 48 more paths</button>
  </div>
  <aside class="explore-contribution">
    <span>Missing from the atlas?</span>
    <p>Suggest a person with a dated age-relative outcome and two independent public sources.</p>
    <a href="/contribute/?task=suggest">Suggest a person →</a>
  </aside>

  <script>
    type Person = {
      age_at_milestone?: number;
      category?: string;
      cohort_group?: string;
      catalytic_ecosystem_score?: number | null;
      early_history_summary?: string;
      inherited_leverage_score?: number | null;
      milestone_by_age_26?: string;
      name: string;
      personal_endowment_score?: number | null;
      person_id: string;
      success_tier?: number;
    };

    let people: Person[] | null = null;
    let visibleCount = 48;
    const results = document.getElementById("results") as HTMLElement;
    const countEl = document.getElementById("count") as HTMLElement;
    const activeFilters = document.getElementById("active-filters") as HTMLElement;
    const clearFilters = document.getElementById("clear-filters") as HTMLButtonElement;
    const resultsActions = document.getElementById("results-actions") as HTMLElement;
    const loadMore = document.getElementById("load-more") as HTMLButtonElement;
    const search = document.getElementById("search") as HTMLInputElement;
    const fCohort = document.getElementById("f-cohort") as HTMLSelectElement;
    const fCategory = document.getElementById("f-category") as HTMLSelectElement;
    const fReach = document.getElementById("f-reach") as HTMLSelectElement;
    const fSort = document.getElementById("f-sort") as HTMLSelectElement;

    function escapeHtml(value: unknown) {
      const entities: Record<string, string> = { "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;" };
      return String(value).replace(/[&<>"']/g, (character) => entities[character]);
    }

    const controls = [search, fCohort, fCategory, fReach, fSort];

    function reachKey(person: Person) {
      if (person.success_tier === 1) return "extreme";
      if (person.success_tier === 2) return "field";
      return "professional";
    }

    function reachLabel(person: Person) {
      if (person.success_tier === 1) return "Extreme public outlier";
      if (person.success_tier === 2) return "Field-leading";
      return "Professionally distinctive";
    }

    function factorValue(value: number | null | undefined) {
      if (typeof value !== "number") return "—";
      return value > 0 ? `+${value}` : String(value);
    }

    function clearAllFilters() {
      for (const control of controls) control.value = control === fSort ? "name" : "";
      visibleCount = 48;
      render();
    }

    function syncUrl() {
      const params = new URLSearchParams();
      if (search.value.trim()) params.set("q", search.value.trim());
      if (fCohort.value) params.set("cohort", fCohort.value);
      if (fCategory.value) params.set("field", fCategory.value);
      if (fReach.value) params.set("reach", fReach.value);
      if (fSort.value !== "name") params.set("order", fSort.value);
      const query = params.toString();
      window.history.replaceState({}, "", query ? `${window.location.pathname}?${query}` : window.location.pathname);
    }

    function render() {
      if (!people) return;
      const q = search.value.trim().toLowerCase();
      const cohort = fCohort.value;
      const category = fCategory.value;
      const reach = fReach.value;
      const sort = fSort.value;

      const list = people.filter((p) => {
        if (cohort && p.cohort_group !== cohort) return false;
        if (category && p.category !== category) return false;
        if (reach && reachKey(p) !== reach) return false;
        if (q) {
          const hay = `${p.name} ${p.milestone_by_age_26} ${p.early_history_summary} ${p.category}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });

      if (q && sort === "name") {
        const searchRank = (person: Person) => {
          const name = person.name.toLowerCase();
          if (name === q) return 0;
          if (name.startsWith(q)) return 1;
          if (name.includes(q)) return 2;
          return 3;
        };
        list.sort((a, b) => searchRank(a) - searchRank(b) || a.name.localeCompare(b.name));
      }
      else if (sort === "age-asc") list.sort((a,b) => (a.age_at_milestone||0) - (b.age_at_milestone||0));
      else if (sort === "age-desc") list.sort((a,b) => (b.age_at_milestone||0) - (a.age_at_milestone||0));
      else if (sort === "name") list.sort((a,b) => a.name.localeCompare(b.name));

      const filterLabels = [
        q ? `“${search.value.trim()}”` : "",
        cohort,
        category,
        reach ? reachLabel({ name: "", person_id: "", success_tier: reach === "extreme" ? 1 : reach === "field" ? 2 : 3 }) : "",
      ].filter(Boolean);
      activeFilters.textContent = filterLabels.length ? filterLabels.join(" · ") : "No filters active";
      clearFilters.disabled = filterLabels.length === 0 && sort === "name";
      syncUrl();

      if (list.length === 0) {
        countEl.textContent = `0 of ${people.length.toLocaleString()} paths`;
        results.innerHTML = '<div class="explore-state explore-state-empty" role="status"><strong>No paths match this combination.</strong><span>Remove a filter or return to the full atlas.</span><button class="filter-reset" data-clear-filters type="button">Clear all filters</button></div>';
        resultsActions.hidden = true;
        return;
      }

      const displayed = list.slice(0, visibleCount);
      countEl.textContent = `${displayed.length.toLocaleString()} of ${list.length.toLocaleString()} matching paths`;
      resultsActions.hidden = displayed.length >= list.length;
      results.innerHTML = displayed.map((p, index) => {
        const href = "/person/" + encodeURIComponent(p.person_id) + "/";
        return `
        <a class="person-card" href="` + href + `">
          <div class="path-record-label">Path record ${String(index + 1).padStart(3, "0")}</div>
          <div class="person-card-heading">
            <div class="name">${escapeHtml(p.name)}</div>
            <span class="person-card-arrow" aria-hidden="true">↗</span>
          </div>
          <div class="cat">${escapeHtml(p.category || "")} · age ${p.age_at_milestone ?? "?"}</div>
          <div class="milestone">${escapeHtml(p.milestone_by_age_26 || "")}</div>
          <div class="path-record-meta">
            <span><b>What they brought</b>${factorValue(p.personal_endowment_score)}</span>
            <span><b>What they were handed</b>${factorValue(p.inherited_leverage_score)}</span>
            <span><b>What surrounded them</b>${factorValue(p.catalytic_ecosystem_score)}</span>
            <span><b>Outcome reach</b>${escapeHtml(reachLabel(p))}</span>
          </div>
        </a>
      `;
      }).join("");
    }

    const params = new URLSearchParams(window.location.search);
    search.value = params.get("q") ?? "";
    fCohort.value = params.get("cohort") ?? "";
    fCategory.value = params.get("field") ?? "";
    fReach.value = params.get("reach") ?? "";
    fSort.value = params.get("order") ?? "name";

    for (const control of controls) {
      control.addEventListener("input", () => {
        visibleCount = 48;
        render();
      });
    }
    clearFilters.addEventListener("click", clearAllFilters);
    loadMore.addEventListener("click", () => {
      visibleCount += 48;
      render();
    });
    results.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("[data-clear-filters]")) clearAllFilters();
    });

    // Fetch data client-side instead of embedding
    fetch("/data/people.json").then((response: Response) => response.json()).then((data: Person[]) => {
      people = data;
      render();
    }).catch(() => {
      results.innerHTML = '<div class="explore-state explore-state-error" role="alert"><strong>The atlas could not load.</strong><span>Refresh the page to try again.</span></div>';
    });
  </script>
</Base>
