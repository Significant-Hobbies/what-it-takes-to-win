---
import Base from "../../layouts/Base.astro";
import peopleData from "../../data/people.json";
import { TIER_DEFINITIONS } from "../../lib/outcome-model";

const people = peopleData;
const cohorts = [...new Set(people.map((p) => p.cohort_group).filter(Boolean))].sort();
const categories = [...new Set(people.map((p) => p.category).filter(Boolean))].sort();
const engines = [...new Set(people.map((p) => p.normalized_primary_engine).filter(Boolean))].sort();
const archetypes = [...new Set(people.map((p) => p.primary_early_advantage_archetype).filter(Boolean))].sort();
---

<Base title="Explore — What It Takes to Win">
  <section class="hero" style="padding-bottom:24px;">
    <h1>Explore {people.length} people</h1>
    <p class="lede">Find a path to inspect—not a person to rank. Open any profile to see starting conditions, leverage provenance, luck boundaries, trajectory, and a person-specific “Am I the next…?” questionnaire.</p>
  </section>

  <div class="filters" id="filters">
    <input type="search" id="search" placeholder="Search name, milestone, summary…" />
    <select id="f-cohort">
      <option value="">All cohorts</option>
      {cohorts.map((c) => <option value={c}>{c}</option>)}
    </select>
    <select id="f-category">
      <option value="">All categories</option>
      {categories.map((c) => <option value={c}>{c}</option>)}
    </select>
    <select id="f-engine">
      <option value="">All engines</option>
      {engines.map((c) => <option value={c}>{c}</option>)}
    </select>
    <select id="f-archetype">
      <option value="">All archetypes</option>
      {archetypes.map((c) => <option value={c}>{c}</option>)}
    </select>
    <select id="f-tier">
      <option value="">All outcome tiers</option>
      {TIER_DEFINITIONS.map((tier) => <option value={tier.tier}>T{tier.tier} · {tier.name}</option>)}
    </select>
    <select id="f-sort">
      <option value="name">Sort: name (A→Z)</option>
      <option value="age-asc">Sort: milestone age (low→high)</option>
      <option value="age-desc">Sort: milestone age (high→low)</option>
      <option value="leverage">Inspect: leverage (high→low, not a rank)</option>
    </select>
    <span id="count" style="font-family:var(--mono);font-size:12px;color:var(--text-faint);">Loading…</span>
  </div>

  <div class="person-grid" id="results">
    <div style="padding:40px;text-align:center;color:var(--text-faint);">Loading people…</div>
  </div>

  <script is:inline type="application/json" id="tier-definitions" set:html={JSON.stringify(TIER_DEFINITIONS)} />
  <script>
    let people = null;
    const tierDefinitions = JSON.parse(document.getElementById("tier-definitions").textContent);
    const results = document.getElementById("results") as HTMLElement;
    const countEl = document.getElementById("count") as HTMLElement;
    const search = document.getElementById("search") as HTMLInputElement;
    const fCohort = document.getElementById("f-cohort") as HTMLSelectElement;
    const fCategory = document.getElementById("f-category") as HTMLSelectElement;
    const fEngine = document.getElementById("f-engine") as HTMLSelectElement;
    const fArchetype = document.getElementById("f-archetype") as HTMLSelectElement;
    const fTier = document.getElementById("f-tier") as HTMLSelectElement;
    const fSort = document.getElementById("f-sort") as HTMLSelectElement;

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;" }[c]));
    }

    function render() {
      if (!people) return;
      const q = search.value.trim().toLowerCase();
      const cohort = fCohort.value;
      const category = fCategory.value;
      const engine = fEngine.value;
      const archetype = fArchetype.value;
      const tier = fTier.value;
      const sort = fSort.value;

      let list = people.filter((p) => {
        if (cohort && p.cohort_group !== cohort) return false;
        if (category && p.category !== category) return false;
        if (engine && p.normalized_primary_engine !== engine) return false;
        if (archetype && p.primary_early_advantage_archetype !== archetype) return false;
        if (tier && String(p.success_tier) !== tier) return false;
        if (q) {
          const hay = `${p.name} ${p.milestone_by_age_26} ${p.early_history_summary} ${p.category} ${p.primary_early_advantage_archetype}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });

      if (sort === "leverage") list.sort((a,b) => (b.total_leverage_score||0) - (a.total_leverage_score||0));
      else if (sort === "age-asc") list.sort((a,b) => (a.age_at_milestone||0) - (b.age_at_milestone||0));
      else if (sort === "age-desc") list.sort((a,b) => (b.age_at_milestone||0) - (a.age_at_milestone||0));
      else if (sort === "name") list.sort((a,b) => a.name.localeCompare(b.name));

      countEl.textContent = `${list.length} / ${people.length}`;
      results.innerHTML = list.map((p) => `
        <a class="person-card" href="/person/${p.person_id}/">
          <div class="name">${escapeHtml(p.name)}</div>
          <div class="cat">${escapeHtml(p.category || "")} · age ${p.age_at_milestone ?? "?"}</div>
          <div class="milestone">${escapeHtml(p.milestone_by_age_26 || "")}</div>
          <div class="scores">
            <span class="score-pill">L <strong>${p.total_leverage_score ?? "—"}</strong></span>
            <span class="score-pill">T${p.success_tier ?? "?"} ${escapeHtml(tierDefinitions.find(tier => tier.tier === p.success_tier)?.name || "")}</span>
            ${p.primary_early_advantage_archetype ? `<span class="score-pill">${escapeHtml(p.primary_early_advantage_archetype)}</span>` : ""}
          </div>
        </a>
      `).join("");
    }

    [search, fCohort, fCategory, fEngine, fArchetype, fTier, fSort].forEach((el) =>
      el.addEventListener("input", render)
    );

    // Fetch data client-side instead of embedding
    fetch("/data/people.json").then(r => r.json()).then(data => {
      people = data;
      render();
    }).catch(err => {
      results.innerHTML = '<div style="padding:40px;text-align:center;color:var(--text-faint);">Failed to load data. Please refresh.</div>';
    });
  </script>
</Base>
