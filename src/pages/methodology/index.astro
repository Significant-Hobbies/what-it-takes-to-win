---
import Base from "../../layouts/Base.astro";
import { Content as MethodologyContent } from "../../data/methodology.md";
---

<Base title="Methodology — Look Sideways" mainClass="methodology-main">
  <section class="hero methodology-hero">
    <p class="eyebrow">Research protocol</p>
    <h1>Methodology & limitations</h1>
    <p class="lede">Read this before interpreting any score. The dataset is a research beta, not a measurement.</p>
    <div class="methodology-verdict">
      <span>Interpretation boundary</span>
      <strong>Descriptive evidence, not a causal recipe.</strong>
    </div>
  </section>

  <div class="methodology-layout">
    <aside class="methodology-contract" aria-labelledby="methodology-contract-heading">
      <p class="eyebrow">Reading contract</p>
      <h2 id="methodology-contract-heading">What this project can say</h2>
      <dl>
        <div>
          <dt>Can describe</dt>
          <dd>Repeated conditions and capabilities in selected early-breakthrough paths.</dd>
        </div>
        <div>
          <dt>Cannot establish</dt>
          <dd>Base rates, causality, counterfactuals, or a probability of success.</dd>
        </div>
        <div>
          <dt>Current evidence</dt>
          <dd><a href="/coverage/">Inspect the live coverage ledger →</a></dd>
        </div>
      </dl>
    </aside>

    <article class="prose methodology-prose">
      <MethodologyContent />
    </article>
  </div>
</Base>
