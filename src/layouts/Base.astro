---
import "../styles/global.css";
import peopleData from "../data/people.json";
const peopleCount = peopleData.length;
const {
  title = "What It Takes to Win",
  description = "What early conditions accelerate breakthroughs? A data-driven look at 2,500+ people and the advantages that shaped their paths.",
  robots = "index,follow",
  canonicalPath,
  structuredData,
} = Astro.props;
const canonicalUrl = canonicalPath && Astro.site
  ? new URL(canonicalPath, Astro.site).toString()
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-mark">↗</span>
          <span class="brand-text">What It Takes to Win</span>
        </a>
        <nav class="site-nav">
          <a href="/">Overview</a>
          <a href="/insights/">Insights</a>
          <a href="/explore/">Explore</a>
          <a href="/compare/">Am I Next?</a>
          <a href="/methodology/">Methodology</a>
        </nav>
        <div class="nav-search">
          <input type="text" id="nav-search-input" aria-label="Search people" placeholder="Search people..." autocomplete="off" />
          <div id="nav-search-results" class="nav-search-results" style="display:none;"></div>
        </div>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          What It Takes to Win · {peopleCount} people (born 1950+) ·
          <a href="https://github.com/sarthakagrawal927/success-by-26">source</a> ·
          interpretive annotations, not causal estimates
        </p>
      </div>
    </footer>
    <script>
      (function() {
        const input = document.getElementById('nav-search-input') as HTMLInputElement | null;
        const results = document.getElementById('nav-search-results');
        if (!input || !results) return;

        let index = null;
        let loadingPromise = null;

        function loadIndex() {
          if (index) return Promise.resolve(index);
          if (loadingPromise) return loadingPromise;
          loadingPromise = fetch('/data/search-index.json')
            .then(r => r.json())
            .then(data => {
              index = data.map(p => ({
                id: p.id,
                name: p.name,
                category: p.category || '',
                searchText: (p.name + ' ' + (p.category || '') + ' ' + (p.milestone || '')).toLowerCase(),
              }));
              return index;
            });
          return loadingPromise;
        }

        // Lazy-load on first focus
        input.addEventListener('focus', function() {
          if (!index) loadIndex();
          if (this.value.trim().length >= 2) {
            results.style.display = 'block';
          }
        });

        input.addEventListener('input', function() {
          const q = this.value.trim().toLowerCase();
          if (q.length < 2) {
            results.style.display = 'none';
            return;
          }
          if (!index) {
            loadIndex().then(() => doSearch(q));
            return;
          }
          doSearch(q);
        });

        function doSearch(q) {
          const matches = index.filter(p => p.searchText.includes(q)).slice(0, 8);
          if (matches.length === 0) {
            results.innerHTML = '<div class="nsr-empty">No results</div>';
            results.style.display = 'block';
            return;
          }
          results.innerHTML = matches.map(p =>
            `<a href="/person/${p.id}/" class="nsr-item"><span class="nsr-name">${p.name}</span><span class="nsr-cat">${p.category}</span></a>`
          ).join('');
          results.style.display = 'block';
        }

        input.addEventListener('blur', function() {
          setTimeout(() => { results.style.display = 'none'; }, 200);
        });
      })();
    </script>
  </body>
</html>
