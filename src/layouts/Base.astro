---
import "../styles/global.css";
import "../styles/exhibit-finish.css";
import peopleData from "../data/people.json";
import { summarizeCoverage, type CoveragePerson } from "../lib/coverage";
const peopleCount = peopleData.length;
const coverage = summarizeCoverage(peopleData as CoveragePerson[]);
const auditGates = [
  { label: "Double-coding", status: "done", note: "16-record stratified sample" },
  {
    label: "Source reachability",
    status: coverage.auditPending.count === 0 ? "done" : "partial",
    note: `${coverage.auditReviewed.count.toLocaleString()}/${coverage.total.toLocaleString()} reviewed`,
  },
  { label: "User comprehension", status: "pending", note: "External observation" },
  { label: "Matched comparison", status: "pending", note: "No control group" },
];
const {
  title = "Look Sideways",
  description = `Look sideways for information, never for a verdict. ${peopleData.length.toLocaleString()} documented paths with their starting conditions, built leverage, sequence, and luck held apart.`,
  robots = "index,follow",
  canonicalPath,
  socialImage = "/og-image.png",
  structuredData,
  mainClass = "",
} = Astro.props;
const canonicalUrl = Astro.site
  ? new URL(canonicalPath ?? Astro.url.pathname, Astro.site).toString()
  : null;
const socialImageUrl = Astro.site ? new URL(socialImage, Astro.site).toString() : socialImage;
const currentPath = Astro.url.pathname;
const navLinks = [
  { href: "/", label: "Story" },
  { href: "/essays/", label: "Essays" },
  { href: "/insights/", label: "Insights" },
  { href: "/explore/", label: "Explore", activePrefixes: ["/explore/", "/person/"] },
  { href: "/compare/", label: "Am I Next?", activePrefixes: ["/compare/", "/am-i-the-next/"] },
  { href: "/roi/", label: "ROI Lab" },
  { href: "/coverage/", label: "Evidence" },
  { href: "/methodology/", label: "Methodology" },
];
const isActive = (link: (typeof navLinks)[number]) =>
  link.href === "/"
    ? currentPath === link.href
    : (link.activePrefixes ?? [link.href]).some((prefix) => currentPath.startsWith(prefix));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0b0d12" />
    <meta name="color-scheme" content="dark" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Look Sideways" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Look Sideways: ${peopleData.length.toLocaleString()} documented paths, four layers, no success formula.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline async src="/scripts/posthog.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Look Sideways home">
          <span class="brand-mark">→</span>
          <span class="brand-text">Look Sideways</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          {navLinks.map((link) => (
            <a href={link.href} aria-current={isActive(link) ? "page" : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
        <div class="nav-search">
          <input
            type="search"
            id="nav-search-input"
            role="combobox"
            aria-label="Search people"
            aria-autocomplete="list"
            aria-controls="nav-search-results"
            aria-expanded="false"
            placeholder={`Search ${peopleData.length.toLocaleString()} people…`}
            autocomplete="off"
          />
          <div
            id="nav-search-results"
            class="nav-search-results"
            role="listbox"
            aria-label="People search results"
            style="display:none;"
          ></div>
        </div>
      </div>
    </header>
    <main id="main-content" class:list={["container", mainClass]} tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-primary">
          <p class="footer-kicker">Look Sideways</p>
          <p class="footer-statement">The same ingredients do not make the same path.</p>
          <p class="footer-summary">
            An independent research exhibit about advantage, built leverage,
            compounding, luck, and the limits of comparison.
          </p>
        </div>
        <div class="footer-audit" aria-label="Research audit status">
          <p class="footer-audit-heading">Research audit status</p>
          <ul class="audit-gates">
            {auditGates.map((gate) => (
              <li class={`audit-gate audit-gate-${gate.status}`}>
                <span class="audit-gate-mark" aria-hidden="true">
                  {gate.status === "done" ? "✓" : gate.status === "partial" ? "◐" : "○"}
                </span>
                <span class="audit-gate-label">{gate.label}</span>
                <span class="audit-gate-note">{gate.note}</span>
              </li>
            ))}
          </ul>
          <a href="/coverage/" class="footer-audit-link">See evidence coverage →</a>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="/overview/">Overview</a>
          <a href="/coverage/">Evidence coverage</a>
          <a href="/methodology/">Methodology</a>
          <a href="/essays/">Essays</a>
          <a href="/roi/">ROI lab</a>
          <a href="/about/">About</a>
          <a href="/changelog/">Changelog</a>
          <a href="https://github.com/Significant-Hobbies/what-it-takes-to-win/issues">Roadmap</a>
          <a href="https://github.com/Significant-Hobbies/what-it-takes-to-win">Source code</a>
        </nav>
        <div class="footer-meta-row">
          <p class="footer-meta">{peopleCount.toLocaleString()} paths · People born 1950+</p>
          <p class="footer-meta">Independent research by Sarthak Agrawal</p>
        </div>
      </div>
    </footer>
    <script>
      const primaryNav = document.querySelector<HTMLElement>(".site-nav");
      const activeNavLink = primaryNav?.querySelector<HTMLElement>('[aria-current="page"]');

      if (primaryNav && activeNavLink && window.matchMedia("(max-width: 900px)").matches) {
        requestAnimationFrame(() => {
          primaryNav.scrollLeft = Math.max(
            0,
            activeNavLink.offsetLeft - (primaryNav.clientWidth - activeNavLink.clientWidth) / 2,
          );
        });
      }

      (function() {
        const input = document.getElementById('nav-search-input') as HTMLInputElement | null;
        const results = document.getElementById('nav-search-results');
        if (!input || !results) return;

        let index = null;
        let loadingPromise = null;

        function setResultsOpen(open: boolean) {
          results.style.display = open ? 'block' : 'none';
          input.setAttribute('aria-expanded', String(open));
        }

        function escapeHtml(value: string) {
          return value.replace(/[&<>"']/g, (character) => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;',
          })[character] || character);
        }

        function loadIndex() {
          if (index) return Promise.resolve(index);
          if (loadingPromise) return loadingPromise;
          loadingPromise = fetch('/data/search-index.json')
            .then(r => r.json())
            .then(data => {
              index = data.map(p => ({
                id: p.id,
                name: p.name,
                category: p.category || '',
                searchText: (p.name + ' ' + (p.category || '') + ' ' + (p.milestone || '')).toLowerCase(),
              }));
              return index;
            });
          return loadingPromise;
        }

        // Lazy-load on first focus
        input.addEventListener('focus', function() {
          if (!index) loadIndex();
          if (this.value.trim().length >= 2) {
            setResultsOpen(true);
          }
        });

        input.addEventListener('input', function() {
          const q = this.value.trim().toLowerCase();
          if (q.length < 2) {
            setResultsOpen(false);
            return;
          }
          if (!index) {
            loadIndex().then(() => doSearch(q));
            return;
          }
          doSearch(q);
        });

        function doSearch(q) {
          const matches = index.filter(p => p.searchText.includes(q)).slice(0, 8);
          if (matches.length === 0) {
            results.innerHTML = '<div class="nsr-empty">No results</div>';
            setResultsOpen(true);
            return;
          }
          results.innerHTML = matches.map(p => {
            const personPath = encodeURIComponent(p.id);
            return `<a data-person-path="${personPath}" class="nsr-item" role="option"><span class="nsr-name">${escapeHtml(p.name)}</span><span class="nsr-cat">${escapeHtml(p.category)}</span></a>`;
          }).join('');
          results.querySelectorAll<HTMLAnchorElement>('[data-person-path]').forEach((anchor) => {
            anchor.href = "/person/" + anchor.dataset.personPath + "/";
          });
          setResultsOpen(true);
        }

        input.addEventListener('blur', function() {
          setTimeout(() => { setResultsOpen(false); }, 200);
        });
      })();
    </script>
    <script
      is:inline
      src="https://sassmaker.com/project-strip.js"
      data-project="what-it-takes-to-win"
      defer
    ></script>
  </body>
</html>
