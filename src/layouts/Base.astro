---
import "../styles/global.css";
import "../styles/exhibit-finish.css";
import "../styles/field-atlas.css";
import Clarity from "../components/Clarity.astro";
import SiteHeader from "../components/SiteHeader.astro";
import StudioFooter from "../components/StudioFooter.astro";
import peopleData from "../data/people.json";
const {
  title = "Paths",
  description = `Look sideways for information, never for a verdict. ${peopleData.length.toLocaleString()} documented paths showing what people brought, were handed, and were surrounded by, with perseverance and luck held apart.`,
  robots = "index,follow",
  canonicalPath,
  socialImage = "/og-image.png",
  structuredData,
  mainClass = "",
  quietShell = false,
} = Astro.props;
// Older route titles remain valid inputs while the shared shell owns the current brand.
const pageTitle = title.replaceAll("Look Sideways", "Paths");
const canonicalUrl = Astro.site
  ? new URL(canonicalPath ?? Astro.url.pathname, Astro.site).toString()
  : null;
const socialImageUrl = Astro.site ? new URL(socialImage, Astro.site).toString() : socialImage;
const currentPath = Astro.url.pathname;
const navLinks = [
  { href: "/", label: "Journey" },
  { href: "/insights/", label: "Evidence", activePrefixes: ["/insights/", "/coverage/", "/methodology/"] },
  { href: "/essays/", label: "Articles" },
  { href: "/explore/", label: "Atlas", activePrefixes: ["/explore/", "/person/", "/compare/", "/am-i-the-next/"] },
];
const isActive = (link: (typeof navLinks)[number]) =>
  link.href === "/"
    ? currentPath === link.href
    : (link.activePrefixes ?? [link.href]).some((prefix) => currentPath.startsWith(prefix));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#eef0e7" />
    <meta name="color-scheme" content="light" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Paths" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Paths: ${peopleData.length.toLocaleString()} documented paths, three sources of advantage, no success formula.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline async src="/scripts/posthog.js"></script>
    {currentPath !== "/roi/" && <Clarity />}
    <script
      is:inline
      defer
      src="https://ingest.sassmaker.com/tracker.js"
      data-key="ahk_pub_5bf5a9051a94105f660b28ef1e15c01915f3798773baf090b2ff4cb81625bc76"
      data-project="app-0059a056-8d82-4404-bfd1-2939a1fe2346"
      data-identity="persistent"
      data-vitals
    ></script>
    <script is:inline src="/app-health-log.js" defer></script>
  </head>
  <body class:list={{ "journey-shell": quietShell }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader links={quietShell ? [{ href: "/explore/", label: "Explore ↗", active: false }] : navLinks.map(link => ({ href: link.href, label: link.label, active: isActive(link) }))} />
    <main id="main-content" class:list={["container", mainClass]} tabindex="-1">
      <slot />
    </main>
    <StudioFooter />
  </body>
</html>
