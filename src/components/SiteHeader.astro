---
import "../styles/paths-identity.css";

const links = [
  { href: "/", label: "Journey", related: ["/turning-points/"] },
  { href: "/insights/", label: "Evidence", related: ["/coverage/", "/methodology/", "/first-proof/"] },
  { href: "/essays/", label: "Articles", related: [] },
  { href: "/explore/", label: "Explore", related: ["/person/", "/compare/", "/am-i-the-next/"] },
];
const path = Astro.url.pathname;
const current = ({ href, related }: (typeof links)[number]) => {
  if (path === href) return "page";
  if ((href !== "/" && path.startsWith(href)) || related.some(prefix => path.startsWith(prefix))) return "location";
};
---
<header class="paths-masthead">
  <div class="paths-masthead-inner">
    <a class="paths-wordmark" href="/" aria-label="Paths home">Paths</a>
    <nav class="paths-navigation" aria-label="Primary navigation">
      {links.map(link => <a href={link.href} aria-current={current(link)}>{link.label}</a>)}
    </nav>
  </div>
</header>
<style>
  .paths-masthead {
    background: var(--paths-masthead);
    color: var(--paths-ink);
    font-family: var(--paths-sans);
    line-height: 1.5;
  }
  .paths-masthead-inner {
    width: min(1264px, 100%);
    min-height: 104px;
    margin-inline: auto;
    padding: 16px 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .paths-wordmark {
    color: var(--paths-ink);
    font: italic 44px/1 "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    letter-spacing: -.035em;
    text-decoration: none;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .paths-navigation { display: flex; align-items: center; gap: 32px; }
  .paths-navigation a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--paths-muted);
    font-size: 14px;
    font-weight: 400;
    text-decoration: none;
    text-underline-offset: 8px;
    text-decoration-thickness: 1px;
  }
  .paths-navigation a[aria-current], .paths-navigation a:hover { color: var(--paths-ink); text-decoration-line: underline; }
  .paths-wordmark:hover { color: var(--paths-muted); text-decoration: none; }
  .paths-masthead a:focus-visible { outline: 2px solid var(--paths-ink); outline-offset: 5px; border-radius: 2px; }
  @media (max-width: 1000px) {
    .paths-masthead-inner { padding-inline: 32px; min-height: 88px; }
    .paths-navigation { gap: 24px; }
  }
  @media (max-width: 680px) {
    .paths-masthead-inner { min-height: 80px; padding: 12px 22px; gap: 16px; }
    .paths-wordmark { font-size: 34px; }
    .paths-navigation { gap: 10px; }
    .paths-navigation a { min-width: 44px; justify-content: center; font-size: 13px; text-underline-offset: 6px; }
  }
  @media (max-width: 359px) {
    .paths-masthead-inner { padding-inline: 16px; gap: 8px; flex-wrap: wrap; }
    .paths-navigation { gap: 8px; flex-wrap: wrap; }
  }
</style>
