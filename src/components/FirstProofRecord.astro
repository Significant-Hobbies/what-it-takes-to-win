---
import { AUDIT_DOMAINS, firstProofWorkbook, INTAKE_LABELS, publicationBlockers, recordSources, TRAJECTORY_LABELS, type FirstProofRecord } from "../data/first-proof";
interface Props { record: FirstProofRecord; published?: boolean }
const { record, published = false } = Astro.props;
const review = record.review;
const sources = recordSources(record);
const correction = `/contribute/?${new URLSearchParams({ task: "edit", person: record.name, profile: `https://paths.significanthobbies.com/first-proof/${published ? "" : "research/"}${record.id}/` })}`;
---
<article>
  <header class="hero luck-hero">
    <p class="luck-back"><a href={published ? "/first-proof/" : "/first-proof/research/"}>{published ? "Before the First Proof" : "Research register"}</a></p>
    <p class="luck-kicker">{published ? "Publication-cleared profile" : `${INTAKE_LABELS[record.intakeStatus]} · Uncleared research note`}</p>
    <h1>{record.name}</h1>
    <p class="lede">{record.domain} · {published ? `First proof at ${review!.milestone.ageMin}–${review!.milestone.ageMax}` : `Located milestone age ${record.milestoneAge}`}</p>
    <p class="first-proof-intro">{published ? review!.milestone.result : record.locatedProof}</p>
  </header>
  {!published && <aside class="first-proof-empty" aria-label="Evidence boundary"><p><strong>{record.publicationStatus}.</strong></p><p>{record.unresolvedIssue}</p><p>{record.intake ? "The original workbook intake is preserved; the claims above include a later sourced screening correction. The full cross-domain audit remains incomplete." : "These are imported screening claims. Their source associations have been preserved; claim-by-claim verification and the full cross-domain audit remain incomplete."}</p></aside>}

  <section class="first-proof-section" aria-labelledby="timeline-heading">
    <h2 id="timeline-heading">{published ? "Before and after outside validation" : "Two timelines to investigate"}</h2>
    <div class="first-proof-lanes">
      <section><h3>Capability and practice</h3>
        {review?.timeline?.capability?.length ? <ol>{review.timeline.capability.map((step) => <li><strong>{step.when}</strong><p>{step.detail}</p></li>)}</ol> : <><p>{record.background}</p><p class="first-proof-note">Earlier background from {record.intake ? "a sourced screening correction" : "the register"}. Practice start, development dates and earlier level have not been established.</p></>}
      </section>
      <section><h3>External proof</h3>
        {review?.timeline?.proof?.length ? <ol>{review.timeline.proof.map((step) => <li><strong>{step.when}</strong><p>{step.detail}</p></li>)}</ol> : <><p>Located milestone age: {record.milestoneAge}</p><p>{record.locatedProof}</p><p class="first-proof-note">The earliest result located in screening can be later than the person’s actual first qualifying result.</p></>}
      </section>
    </div>
  </section>
  <section class="first-proof-section" aria-labelledby="history-heading">
    <h2 id="history-heading">Earlier-history coverage</h2>
    <dl class="first-proof-audit">{AUDIT_DOMAINS.map((domain) => <div><dt>{domain}</dt><dd>{review?.earlyHistory?.[domain]?.state ?? "Not reviewed"}{review?.earlyHistory?.[domain]?.note && <p>{review.earlyHistory[domain].note}</p>}</dd></div>)}</dl>
    <p>Blank or unreviewed history means unknown. The same threshold applies to earlier and later achievements.</p>
  </section>
  <section class="first-proof-section" aria-labelledby="classification-heading">
    <h2 id="classification-heading">Classification and limits</h2>
    <p><strong>Evidence status:</strong> {review?.evidenceStatus ?? (record.intakeStatus === "C" ? "Held for the stated intake concern; earlier-history audit incomplete" : "Earlier-history audit incomplete")}</p>
    <p><strong>Trajectory:</strong> {TRAJECTORY_LABELS[review?.trajectoryType ?? "unresolved"]}</p>
    <p><strong>Research depth:</strong> {record.researchDepth}</p>
    {published ? <><p>{review!.publication.coverageStatement}</p><p>{review!.publication.takeaway}</p></> : <><h3>What prevents publication</h3><ul>{publicationBlockers(record).map((blocker) => <li>{blocker}</li>)}</ul></>}
  </section>
  <section class="first-proof-section" aria-labelledby="sources-heading">
    <h2 id="sources-heading">Sources associated with this record</h2>
    <ul class="first-proof-sources">{sources.map((source) => <li><a href={source.url} rel="noopener noreferrer">{source.id} · {source.domain}</a><span>{source.url}</span></li>)}</ul>
    <p class="first-proof-note">Intake provenance: {firstProofWorkbook.name}, “{record.provenance.sheet}”, row {record.provenance.row}, stable ID {record.id}. Source links cover the original screening account and any later research; they do not certify every claim.</p>
    <a href={correction}>Propose a sourced correction or an earlier counterexample →</a>
  </section>
</article>
