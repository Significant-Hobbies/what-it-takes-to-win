{
  "name": "what-it-takes-to-win",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node src/scripts/build_dataset.mjs && node src/scripts/build_candidate_coverage.mjs && astro build && node src/scripts/generate_discovery_surfaces.mjs",
    "preview": "astro preview",
    "check": "node src/scripts/build_dataset.mjs && node src/scripts/build_candidate_coverage.mjs && pnpm run typecheck",
    "lint": "biome check --no-errors-on-unmatched .",
    "format:check": "biome check --no-errors-on-unmatched .",
    "typecheck": "node src/scripts/check-code-health.mjs types",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/lib/**/*.ts' --test-coverage-lines=100 --test-coverage-branches=94 --test-coverage-functions=98 test/*.test.mjs",
    "audit:discovery": "node src/scripts/audit_discovery.mjs",
    "audit:clarity": "node src/scripts/audit_clarity.mjs",
    "audit:tiers": "node src/scripts/audit_tiers.mjs",
    "audit:reliability": "node src/scripts/audit_reliability.mjs",
    "audit:sources": "node src/scripts/audit_sources.mjs",
    "audit:coverage": "node src/scripts/build_candidate_coverage.mjs",
    "sync:stats": "node src/scripts/sync_dataset_stats.mjs",
    "render:og": "node src/scripts/render_og_image.mjs",
    "audit:stats": "node src/scripts/sync_dataset_stats.mjs --check",
    "quality:unused": "node src/scripts/check-code-health.mjs unused",
    "quality:complexity": "node src/scripts/check-code-health.mjs complexity",
    "quality:duplication": "node src/scripts/check-code-health.mjs duplication",
    "quality:cycles": "node src/scripts/check-code-health.mjs cycles",
    "quality:dependencies": "node src/scripts/check-code-health.mjs dependencies",
    "quality:suppressions": "node src/scripts/check-code-health.mjs suppressions",
    "quality:hygiene": "node src/scripts/check-code-health.mjs hygiene",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run test:coverage && pnpm run build && pnpm run audit:discovery && pnpm run audit:clarity && pnpm run audit:tiers && pnpm run audit:reliability && pnpm run audit:stats && pnpm run quality:unused && pnpm run quality:complexity && pnpm run quality:duplication && pnpm run quality:cycles && pnpm run quality:dependencies && pnpm run quality:suppressions && pnpm run quality:hygiene",
    "ready": "pnpm run quality",
    "deploy": "pnpm run ready && wrangler pages deploy dist --project-name success-by-26 --branch main"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "fast-uri": "^3.1.6",
      "http-cache-semantics": "4.3.0",
      "nanoid@<4": "^3.3.18",
      "js-yaml@>=4": "^4.3.1",
      "postcss": "^8.5.23",
      "miniflare>sharp": "0.35.5",
      "astro>sharp": "0.35.5",
      "astro>devalue": "5.9.3",
      "miniflare>undici": "7.29.1",
      "source-map-js": "1.2.2"
    },
    "patchedDependencies": {
      "http-cache-semantics@4.3.0": "patches/http-cache-semantics@4.3.0.patch"
    }
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@saas-maker/motion": "github:sass-maker/ui-library#v0.1.11&path:/packages/motion",
    "@saas-maker/templates": "github:sass-maker/ui-library#v0.1.11&path:/packages/templates",
    "@saas-maker/ui": "github:sass-maker/ui-library#v0.1.11&path:/packages/ui",
    "@tailwindcss/vite": "4.3.3",
    "astro": "^7.3.1",
    "echarts": "^6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jscpd": "5.1.2",
    "knip": "6.34.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.129.0"
  }
}
