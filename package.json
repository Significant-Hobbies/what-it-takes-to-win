{
  "name": "what-it-takes-to-win",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node src/scripts/build_dataset.mjs && astro build && node src/scripts/generate_discovery_surfaces.mjs",
    "preview": "astro preview",
    "check": "node src/scripts/build_dataset.mjs && pnpm run typecheck",
    "lint": "ultracite check .",
    "format:check": "ultracite check .",
    "typecheck": "node src/scripts/check-code-health.mjs types",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/lib/**/*.ts' --test-coverage-lines=100 --test-coverage-branches=94 --test-coverage-functions=98 test/*.test.mjs",
    "audit:discovery": "node src/scripts/audit_discovery.mjs",
    "audit:clarity": "node src/scripts/audit_clarity.mjs",
    "audit:tiers": "node src/scripts/audit_tiers.mjs",
    "audit:reliability": "node src/scripts/audit_reliability.mjs",
    "audit:sources": "node src/scripts/audit_sources.mjs",
    "quality:unused": "node src/scripts/check-code-health.mjs unused",
    "quality:complexity": "node src/scripts/check-code-health.mjs complexity",
    "quality:duplication": "node src/scripts/check-code-health.mjs duplication",
    "quality:cycles": "node src/scripts/check-code-health.mjs cycles",
    "quality:dependencies": "node src/scripts/check-code-health.mjs dependencies",
    "quality:suppressions": "node src/scripts/check-code-health.mjs suppressions",
    "quality:hygiene": "node src/scripts/check-code-health.mjs hygiene",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run test:coverage && pnpm run build && pnpm run audit:discovery && pnpm run audit:clarity && pnpm run audit:tiers && pnpm run audit:reliability && pnpm run quality:unused && pnpm run quality:complexity && pnpm run quality:duplication && pnpm run quality:cycles && pnpm run quality:dependencies && pnpm run quality:suppressions && pnpm run quality:hygiene",
    "ready": "pnpm run quality",
    "deploy": "pnpm run ready && wrangler pages deploy dist --project-name success-by-26 --branch main"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "astro": "^7.1.3",
    "echarts": "^6.1.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "2.5.5",
    "@types/three": "0.185.0",
    "jscpd": "5.0.14",
    "knip": "6.29.0",
    "typescript": "^5.9.3",
    "ultracite": "7.10.2",
    "wrangler": "^4.114.0"
  }
}
